<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:Curt Coder
CMD FD-2000 front panel layout
-->
<mamelayout version="2">

	<element name="case">
		<rect><color red="0.72" green="0.76" blue="0.80" /></rect>
	</element>
	<element name="bezel">
		<rect><color red="0.08" green="0.08" blue="0.09" /></rect>
	</element>

	<element name="lbl_power"><text string="POWER"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="lbl_activity"><text string="ACTIVITY"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="lbl_error"><text string="ERROR"><color red="0.85" green="0.85" blue="0.85" /></text></element>

	<element name="red_led" defstate="0">
		<rect state="1"><color red="1.0" green="0.0" blue="0.0" /></rect>
		<rect state="0"><color red="0.20" green="0.03" blue="0.03" /></rect>
	</element>
	<element name="green_led" defstate="0">
		<rect state="1"><color red="0.0" green="1.0" blue="0.0" /></rect>
		<rect state="0"><color red="0.03" green="0.20" blue="0.03" /></rect>
	</element>

	<element name="btn_swap">
		<rect state="0"><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="1" green="1" blue="1" /></rect>
		<rect state="1"><bounds x="0.05" y="0.05" width="0.9" height="0.9" /><color red="0.05" green="0.05" blue="0.05" /></rect>
		<rect><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.08" green="0.08" blue="0.09" /></rect>
		<text string="SWAP"><bounds x="0.06" y="0.40" width="0.88" height="0.2" /><color red="0.85" green="0.85" blue="0.85" /></text>
	</element>

	<group name="panel">
		<element ref="case"><bounds x="0" y="0" width="640" height="220" /></element>
		<element ref="bezel"><bounds x="10" y="10" width="620" height="200" /></element>

		<element ref="btn_swap" inputtag="PB" inputmask="0x01"><bounds x="140" y="67" width="90" height="90" /></element>

		<element ref="lbl_power"><bounds x="280" y="90" width="105" height="16" /></element>
		<element name="led0" ref="red_led"><bounds x="319" y="126" width="27" height="9" /></element>

		<element ref="lbl_activity"><bounds x="390" y="90" width="105" height="16" /></element>
		<element name="led1" ref="green_led"><bounds x="429" y="126" width="27" height="9" /></element>

		<element ref="lbl_error"><bounds x="500" y="90" width="90" height="16" /></element>
		<element name="led2" ref="red_led"><bounds x="531" y="126" width="27" height="9" /></element>
	</group>

	<view name="Front Panel">
		<group ref="panel"><bounds x="0" y="0" width="640" height="220" /></group>
	</view>

</mamelayout>
