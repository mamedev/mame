<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:Curt Coder
CMD SuperCPU control panel layout
-->
<mamelayout version="2">

	<element name="case">
		<rect><color red="0.10" green="0.10" blue="0.11" /></rect>
	</element>

	<element name="lbl_unit"><text string="UNIT"><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="lbl_jiffydos"><text string="JIFFYDOS"><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="lbl_speed"><text string="SPEED"><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="lbl_turbo"><text string="TURBO"><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="lbl_reset"><text string="RESET"><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="lbl_enable_disable"><text string="ENABLE / DISABLE"><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="lbl_turbo_normal"><text string="TURBO / NORMAL"><color red="0.92" green="0.92" blue="0.90" /></text></element>

	<element name="toggle" defstate="1">
		<rect><color alpha="0" /></rect>
		<disk><bounds x="0.22" y="0.13" width="0.56" height="0.74" /><color red="0.78" green="0.78" blue="0.76" /></disk>
		<disk><bounds x="0.27" y="0.20" width="0.46" height="0.60" /><color red="0.45" green="0.45" blue="0.44" /></disk>
		<disk><bounds x="0.35" y="0.30" width="0.30" height="0.40" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect state="1"><bounds x="0.08" y="0.44" width="0.42" height="0.12" /><color red="0.70" green="0.70" blue="0.70" /></rect>
		<disk state="1"><bounds x="0.0" y="0.395" width="0.16" height="0.21" /><color red="0.95" green="0.95" blue="0.95" /></disk>
		<rect state="0"><bounds x="0.50" y="0.44" width="0.42" height="0.12" /><color red="0.70" green="0.70" blue="0.70" /></rect>
		<disk state="0"><bounds x="0.84" y="0.395" width="0.16" height="0.21" /><color red="0.95" green="0.95" blue="0.95" /></disk>
	</element>

	<element name="led" defstate="0">
		<disk><color red="0.70" green="0.70" blue="0.68" /></disk>
		<disk><bounds x="0.12" y="0.12" width="0.76" height="0.76" /><color red="0.04" green="0.04" blue="0.04" /></disk>
		<disk state="0"><bounds x="0.25" y="0.25" width="0.50" height="0.50" /><color red="0.20" green="0.03" blue="0.03" /></disk>
		<disk state="1"><bounds x="0.25" y="0.25" width="0.50" height="0.50" /><color red="1.0" green="0.0" blue="0.0" /></disk>
	</element>

	<element name="btn_reset">
		<disk><color red="0.78" green="0.78" blue="0.76" /></disk>
		<disk><bounds x="0.08" y="0.08" width="0.84" height="0.84" /><color red="0.04" green="0.04" blue="0.04" /></disk>
		<rect state="0"><bounds x="0.24" y="0.24" width="0.52" height="0.52" /><color red="0.95" green="0.93" blue="0.86" /></rect>
		<rect state="1"><bounds x="0.24" y="0.24" width="0.52" height="0.52" /><color red="0.70" green="0.68" blue="0.62" /></rect>
	</element>

	<group name="panel">
		<element ref="case"><bounds x="0" y="0" width="1440" height="240" /></element>

		<element ref="toggle" inputtag="FRONT" inputmask="0x01" inputraw="yes"><bounds x="130" y="40" width="130" height="100" /></element>
		<element ref="lbl_unit"><bounds x="95" y="155" width="200" height="40" /></element>
		<element ref="lbl_enable_disable"><bounds x="65" y="198" width="260" height="26" /></element>

		<element ref="toggle" inputtag="FRONT" inputmask="0x02" inputraw="yes"><bounds x="400" y="40" width="130" height="100" /></element>
		<element ref="lbl_jiffydos"><bounds x="365" y="155" width="200" height="40" /></element>
		<element ref="lbl_enable_disable"><bounds x="335" y="198" width="260" height="26" /></element>

		<element ref="toggle" inputtag="FRONT" inputmask="0x04" inputraw="yes"><bounds x="665" y="40" width="130" height="100" /></element>
		<element ref="lbl_speed"><bounds x="630" y="155" width="200" height="40" /></element>
		<element ref="lbl_turbo_normal"><bounds x="610" y="198" width="240" height="26" /></element>

		<element name="turbo_led" ref="led"><bounds x="957" y="50" width="80" height="80" /></element>
		<element ref="lbl_turbo"><bounds x="897" y="155" width="200" height="40" /></element>

		<element ref="btn_reset" inputtag="RESET" inputmask="0x01"><bounds x="1220" y="45" width="90" height="90" /></element>
		<element ref="lbl_reset"><bounds x="1165" y="155" width="200" height="40" /></element>
	</group>

	<view name="Control Panel">
		<group ref="panel"><bounds x="0" y="0" width="1440" height="240" /></group>
	</view>

</mamelayout>
