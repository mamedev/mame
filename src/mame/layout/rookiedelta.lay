<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.0" green="0.22" blue="0.22"/>
		</rect>
	</element>

	<element name="static_bgcolor"><rect><color red="0.00" green="0.22" blue="0.22"/> </rect> </element>
	<element name="digit_red"><led7seg><color red="1.00" green="0.10" blue="0.15"/> </led7seg> </element>
	<element name="digit_green"><led7seg><color red="0.10" green="1.00" blue="0.15"/> </led7seg> </element>
	<element name="digit_yellow"><led7seg><color red="1.00" green="1.00" blue="0.15"/> </led7seg> </element>

<!-- Define SEG background -->

	<element name="segbgcolor" defstate="0">
		<disk>
			<color red="0.80" green="0.30" blue="0.00"/>
			<bounds x="-0.075" y="-0.075" width="1.15" height="1.15"/>
		</disk>
		<disk state="0">
			<color red="0.15" green="0.15" blue="0.15"/>
			<bounds x="0" y="0" width="1" height="1"/>
		</disk>
		<disk state="1">
			<color red="1.00" green="0.00" blue="0.15"/>
			<bounds x="0" y="0" width="1" height="1"/>
		</disk>
		<disk state="2">
