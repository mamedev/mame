<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>

	<element name="digit_r" defstate="0">
		<led7seg>
			<color red="1.0" green="0.2" blue="0.2"/>
		</led7seg>
	</element>

	<element name="digit_g" defstate="0">
		<led7seg>
			<color red="0.2" green="1.0" blue="0.2"/>
		</led7seg>
	</element>

