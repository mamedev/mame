<!-- View field -->

	<view name="AWP Simulated Video" showpointers="no">

	<!-- Screen size -->

		<element ref="screen_background_color">
			<bounds x="0" y="0" width="640" height="480"/>
		</element>

	<!-- Frame lamps -->

		<element name="lamp_frame0" ref="LFRAME0">
			<bounds x="0" y="0" width="77" height="50"/>
		</element>
		<element name="lamp_frame1" ref="LFRAME1">
			<bounds x="83" y="0" width="154" height="50"/>
		</element>
		<element name="lamp_frame2" ref="LFRAME2">
			<bounds x="243" y="0" width="74" height="23"/>
		</element>
		<element name="lamp_frame3" ref="LFRAME3">
			<bounds x="243" y="27" width="74" height="23"/>
		</element>
		<element name="lamp_frame4" ref="LFRAME4">
			<bounds x="323" y="0" width="74" height="23"/>
		</element>
		<element name="lamp_frame5" ref="LFRAME5">
			<bounds x="323" y="27" width="74" height="23"/>
		</element>
		<element name="lamp_frame6" ref="LFRAME6">
			<bounds x="403" y="0" width="154" height="50"/>
		</element>
		<element name="lamp_frame7" ref="LFRAME7">
			<bounds x="563" y="0" width="77" height="50"/>
		</element>

	<!-- Betline lamps -->

		<element name="lamp_betline3" ref="LBETLINE3">
			<bounds x="20" y="110" width="80" height="40"/>
		</element>
		<element name="lamp_betline1" ref="LBETLINE1">
			<bounds x="20" y="160" width="80" height="40"/>
		</element>
		<element name="lamp_betline0" ref="LBETLINE0">
			<bounds x="20" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_betline2" ref="LBETLINE2">
			<bounds x="20" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_betline4" ref="LBETLINE4">
			<bounds x="20" y="310" width="80" height="40"/>
		</element>

	<!-- Stop button lamp -->

		<element name="lamp_stop0" ref="LSTOP0">
			<bounds x="165" y="386" width="35" height="35"/>
		</element>
		<element name="lamp_stop1" ref="LSTOP1">
			<bounds x="305" y="386" width="35" height="35"/>
		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="445" y="386" width="35" height="35"/>
		</element>

	<!-- Replay lamp -->

		<element name="lamp_replay" ref="LREPLAY">
			<bounds x="540" y="110" width="80" height="40"/>
		</element>

	<!-- Wait lamp -->

		<element name="lamp_wait" ref="LWAIT">
			<bounds x="540" y="160" width="80" height="40"/>
		</element>

	<!-- Win lamp -->

		<element name="lamp_win" ref="LWIN">
			<bounds x="540" y="210" width="80" height="40"/>
		</element>

	<!-- Start lamp -->

		<element name="lamp_start" ref="LSTART">
			<bounds x="540" y="260" width="80" height="40"/>
		</element>

	<!-- Insert medal lamp -->

		<element name="lamp_insert" ref="LINSERT">
			<bounds x="540" y="310" width="80" height="40"/>
		</element>

	<!-- Maxbet LED -->

		<element name="lamp_maxbet" ref="LMAXBET">
			<bounds x="30" y="430" width="60" height="35"/>
		</element>

	<!-- Credit SEG -->

		<element name="seg_credit0" ref="digit_r">
			<bounds x="170" y="336" width="20" height="35"/>
		</element>
		<element name="seg_credit1" ref="digit_r">
			<bounds x="190" y="336" width="20" height="35"/>
		</element>

	<!-- Bonus count SEG -->

		<element name="seg_count0" ref="digit_g">
			<bounds x="320" y="336" width="20" height="35"/>
		</element>
		<element name="seg_count1" ref="digit_g">
			<bounds x="340" y="336" width="20" height="35"/>
		</element>
		<element name="seg_count2" ref="digit_g">
			<bounds x="360" y="336" width="20" height="35"/>
		</element>

	<!-- Payout SEG -->

		<element name="seg_payout0" ref="digit_r">
			<bounds x="430" y="336" width="20" height="35"/>
		</element>
		<element name="seg_payout1" ref="digit_r">
			<bounds x="450" y="336" width="20" height="35"/>
		</element>

	<!-- Chance LED -->

		<element name="led_chance0" ref="LED_CHANCE0">
			<bounds x="250" y="350" width="8" height="8"/>
		</element>
		<element name="led_chance1" ref="LED_CHANCE1">
			<bounds x="275" y="350" width="8" height="8"/>
		</element>

	<!-- Reel -->

		<repeat count="3">

			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>
			<param name="dx" start="100" increment="140"/>

		<!-- Reel lamp -->

			<element name="lamp_reel~i~_0" ref="LREEL~i~_0">
				<bounds x="~x~" y="140" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_1" ref="LREEL~i~_1">
				<bounds x="~x~" y="200" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_2" ref="LREEL~i~_2">
				<bounds x="~x~" y="260" width="120" height="60"/>
			</element>

		<!-- Reel pattern -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Hopper & Coin solenoid -->

		<element name="signal_hopper" ref="SIGNALHOPPER">
			<bounds x="490" y="60" width="60" height="25"/>
		</element>
		<element name="signal_solenoid" ref="SIGNALSOLENOID">
			<bounds x="560" y="60" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="20" y="60" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="90" y="60" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
