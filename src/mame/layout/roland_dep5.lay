		<element ref="key_7" inputtag="KEY5" inputmask="0x02"><bounds x="941" y="458" width="114" height="86"/></element>
		<element ref="key_8" inputtag="KEY6" inputmask="0x01"><bounds x="1062" y="364" width="114" height="86"/></element>
