		<element ref="text_rev"><bounds x="712" y="442" width="84" height="13" /><color red="0.86" green="0.86" blue="0.82" /></element>
		<element ref="text_sel"><bounds x="712" y="455" width="84" height="13" /><color red="0.86" green="0.86" blue="0.82" /></element>
		<element ref="key_3" inputtag="KEY3" inputmask="0x02"><bounds x="718" y="470" width="72" height="76"/></element>
		<element ref="rect"><bounds x="812" y="356" width="371" height="196" /><color red="0.05" green="0.05" blue="0.055" /></element>
		<element ref="key_4" inputtag="KEY4" inputmask="0x01"><bounds x="820" y="364" width="114" height="86"/></element>
		<element ref="key_5" inputtag="KEY4" inputmask="0x02"><bounds x="820" y="458" width="114" height="86"/></element>
