<?xml version="1.0" encoding="UTF-8" ?>
<!--
license:CC0-1.0

Digitiser overlay for Psion Series 5mx (English)
-->

<mamelayout version="2">

	<element name="overlay_left">
		<!-- background -->
		<rect>
			<bounds x="0" y="0" width="35" height="250" />
			<color red="0.76" green="0.77" blue="0.70" />
		</rect>

		<!-- icons (placeholder) -->
		<text string="Menu">
			<bounds x="5" y="16" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>

		<text string="Cut">
			<bounds x="5" y="56" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Paste">
			<bounds x="5" y="73" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>

		<text string="IR">
			<bounds x="5" y="116" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>

		<text string="Zoom">
			<bounds x="5" y="156" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="+">
			<bounds x="5" y="173" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>

		<text string="Zoom">
			<bounds x="5" y="206" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="-">
			<bounds x="5" y="223" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>

		<!-- separators -->
		<rect>
			<bounds x="0" y="47" width="35" height="1" />
			<color red="0.44" green="0.45" blue="0.37" />
		</rect>

		<rect>
			<bounds x="0" y="97" width="35" height="1" />
			<color red="0.44" green="0.45" blue="0.37" />
		</rect>

		<rect>
			<bounds x="0" y="147" width="35" height="1" />
			<color red="0.44" green="0.45" blue="0.37" />
		</rect>

		<rect>
			<bounds x="34" y="0" width="1" height="250" />
			<color red="0.44" green="0.45" blue="0.37" />
		</rect>
	</element>

	<element name="overlay_icons">
		<!-- background -->
		<rect>
			<bounds x="0" y="0" width="55" height="30" />
			<color red="0.93" green="0.48" blue="0.24" />
		</rect>
		<rect>
			<bounds x="55" y="0" width="640" height="30" />
			<color red="0.76" green="0.77" blue="0.70" />
		</rect>

		<!-- icons (placeholder) -->
		<disk>
			<bounds x="20" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="87.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="167.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="247.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="327.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="407.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="487.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="567.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk>
			<bounds x="647.5" y="7.5" width="15" height="15" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
	</element>

	<element name="overlay_labels">
		<!-- background -->
		<rect>
			<bounds x="0" y="0" width="55" height="25" />
			<color red="0.95" green="0.52" blue="0.29" />
		</rect>
		<rect>
			<bounds x="55" y="0" width="640" height="25" />
			<color red="0.72" green="0.72" blue="0.68" />
		</rect>

		<!-- labels -->
		<text string="System">
			<bounds x="0" y="4" width="55" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Word">
			<bounds x="55" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Sheet">
			<bounds x="135" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Contacts">
			<bounds x="215" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Agenda">
			<bounds x="295" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Email">
			<bounds x="375" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Calc">
			<bounds x="455" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Jotter">
			<bounds x="535" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="Extras">
			<bounds x="615" y="4" width="80" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<text string="▲">
			<bounds x="670" y="4" width="20" height="16" />
			<color red="0.87" green="0.51" blue="0.28" />
		</text>
	</element>

	<view name="Digitiser Overlay (no icons)">
		<bounds left="0" right="695" top="0" bottom="305" />
		<screen index="0">
			<bounds left="0" right="695" top="0" bottom="280" />
		</screen>

		<element ref="overlay_left">
			<bounds x="0" y="0" width="35" height="250" />
		</element>

		<element ref="overlay_icons">
			<bounds x="0" y="250" width="695" height="30" />
		</element>

		<element ref="overlay_labels">
			<bounds x="0" y="280" width="695" height="25" />
		</element>
	</view>

	<view name="LCD Panel">
		<bounds x="45" width="640" y="5" height="240" />
		<screen index="0">
			<bounds left="0" right="695" top="0" bottom="280" />
		</screen>
	</view>

</mamelayout>
