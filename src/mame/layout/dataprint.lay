<mamelayout version="2">
	<element name="turquoise"><rect><color red="0.1" green="0.6" blue="0.6"/></rect></element>
	<element name="black"><rect><color red="0" green="0" blue="0"/></rect></element>
	<element name="black_arc"><disk><color red="0" green="0" blue="0"/></disk></element>
	<element name="line"><rect><color red="0.5" green="0.5" blue="0.5"/></rect></element>

	<element name="label_0"><text string="GERÄT EIN"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_1"><text string="BATTERIE LEER"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_2"><text string="ZUM AUTOMAT"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_3"><text string="FEHLER PC/AUTOMAT"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_4"><text string="PAPIER ENDE"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_5"><text string="ZUM PC"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_6"><text string="SPEICHER FEHLER"><color red="1" green="1" blue="1"/></text></element>
	<element name="label_7"><text string="LADEN"><color red="1" green="1" blue="1"/></text></element>

	<element name="yellow_led" defstate="0">
		<disk><bounds x="0" y="0" width="1" height="1"/><color red="0" green="0" blue="0"/></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.8" height="0.8"/><color red="0.5" green="0.4" blue="0.1"/></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.8" height="0.8"/><color red="1.0" green="0.8" blue="0.1"/></disk>
	</element>
	<element name="red_led" defstate="0">
		<disk><bounds x="0" y="0" width="1" height="1"/><color red="0" green="0" blue="0"/></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.8" height="0.8"/><color red="0.4" green="0" blue="0"/></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.8" height="0.8"/><color red="1.0" green="0" blue="0"/></disk>
	</element>
	<element name="green_led" defstate="0">
		<disk><bounds x="0" y="0" width="1" height="1"/><color red="0" green="0" blue="0"/></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.8" height="0.8"/><color red="0" green="0.3" blue="0"/></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.8" height="0.8"/><color red="0" green="0.9" blue="0"/></disk>
	</element>

	<view name="Control Panel">
		<bounds x="0" y="0" width="150" height="150"/>
		<element ref="turquoise"><bounds x="0" y="0" width="150" height="150"/></element>

		<element ref="black"><bounds x="22" y="7" width="66" height="136"/></element>
		<element ref="black_arc"><bounds x="39" y="7" width="99" height="136"/></element>

		<element ref="line"><bounds x="23" y="58" width="114" height="1.5"/></element>
		<element ref="line"><bounds x="23" y="70" width="115" height="1.5"/></element>
		<element ref="line"><bounds x="23" y="82" width="115" height="1.5"/></element>
		<element ref="line"><bounds x="23" y="94" width="113" height="1.5"/></element>
		<element ref="line"><bounds x="23" y="106" width="107" height="1.5"/></element>
		<element ref="line"><bounds x="23" y="118" width="96" height="1.5"/></element>
		<element ref="line"><bounds x="23" y="130" width="78" height="1.5"/></element>

		<element ref="label_0"><bounds x="24" y="48" width="54" height="10"/></element>
		<element ref="label_1"><bounds x="24" y="60" width="75" height="10"/></element>
		<element ref="label_2"><bounds x="24" y="72" width="72" height="10"/></element>
		<element ref="label_3"><bounds x="24" y="84" width="101" height="10"/></element>
		<element ref="label_4"><bounds x="24" y="96" width="68" height="10"/></element>
		<element ref="label_5"><bounds x="24" y="108" width="45" height="10"/></element>
		<element ref="label_6"><bounds x="24" y="120" width="91" height="10"/></element>
		<element ref="label_7"><bounds x="24" y="132" width="42" height="10"/></element>

		<element name="led0" ref="green_led"><bounds x="10" y="48" width="5" height="5"/></element>
		<element name="led1" ref="red_led"><bounds x="10" y="60" width="5" height="5"/></element>
		<element name="led2" ref="yellow_led"><bounds x="10" y="72" width="5" height="5"/></element>
		<element name="led3" ref="red_led"><bounds x="10" y="84" width="5" height="5"/></element>
		<element name="led4" ref="red_led"><bounds x="10" y="96" width="5" height="5"/></element>
		<element name="led5" ref="yellow_led"><bounds x="10" y="108" width="5" height="5"/></element>
		<element name="led6" ref="red_led"><bounds x="10" y="120" width="5" height="5"/></element>
		<element name="led7" ref="green_led"><bounds x="10" y="132" width="5" height="5"/></element>
	</view>
</mamelayout>
