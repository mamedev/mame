		<group ref="button"><bounds x="801" y="189" width="72" height="72" /></group>
		<param name="id" value="answer_right_b" /><param name="lamp" value="6" /><param name="mask" value="0x40" /><param name="label" value="b" /><param name="colour" value="blue" /><param name="red" value="0.35" /><param name="green" value="0.48" /><param name="blue" value="0.75" />
		<group ref="button"><bounds x="801" y="293" width="72" height="72" /></group>
