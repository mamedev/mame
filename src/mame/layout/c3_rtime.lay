		<param name="id" value="answer_left_c" /><param name="lamp" value="2" /><param name="mask" value="0x04" /><param name="label" value="c" /><param name="colour" value="red" /><param name="red" value="0.72" /><param name="green" value="0.35" /><param name="blue" value="0.35" />
		<group ref="button"><bounds x="-105" y="397" width="72" height="72" /></group>
