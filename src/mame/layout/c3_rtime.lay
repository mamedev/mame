		<param name="id" value="answer_left_a" /><param name="lamp" value="0" /><param name="tag" value="STROBE0" /><param name="mask" value="0x01" /><param name="label" value="a" /><param name="colour" value="orange" /><param name="red" value="0.90" /><param name="green" value="0.48" /><param name="blue" value="0.22" /><param name="label_y" value="0" /><param name="label_height" value="1" />
