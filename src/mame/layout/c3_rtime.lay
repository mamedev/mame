		<element id="coin_pound_label" ref="coin_label_pound"><bounds x="648" y="-168" width="240" height="138" /></element>
		<element ref="coin_input" inputtag="IOSTATUS" inputmask="0x08"><bounds x="669.6" y="-145.92" width="61.2" height="91.08" /></element>
