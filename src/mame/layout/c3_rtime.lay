	<group name="button">
		<element id="~id~_face" name="lamp~lamp~" ref="button_~colour~" inputtag="~tag~" inputmask="~mask~"><bounds x="0" y="0" width="1" height="1" /></element>
		<element ref="button_detail"><bounds x="0" y="0" width="1" height="1" /></element>
		<element id="~id~_highlight" name="lamp~lamp~" ref="button_highlight"><bounds x="0" y="0" width="1" height="1" /><color red="~red~" green="~green~" blue="~blue~" /></element>
		<element ref="label_~label~"><bounds x="0" y="~label_y~" width="1" height="~label_height~" /></element>
	</group>

