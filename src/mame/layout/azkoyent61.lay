<?xml version="1.0"?>
<!--
license:CC0-1.0
Azkoyen T61 layout
-->
<mamelayout version="2">

	<!-- basic elements -->

	<element name="panel"><rect><color red="0.16" green="0.16" blue="0.17" /></rect></element>
	<element name="bezel"><rect><color red="0.02" green="0.02" blue="0.03" /></rect></element>
	<element name="digit"><led7seg><color red="1.0" green="0.15" blue="0.1" /></led7seg></element>

	<element name="button" defstate="0">
		<disk state="0"><color red="0.80" green="0.80" blue="0.80" /></disk>
		<disk state="1"><color red="0.45" green="0.45" blue="0.45" /></disk>
	</element>

	<element name="button_red" defstate="0">
		<disk state="0"><color red="0.80" green="0.12" blue="0.10" /></disk>
		<disk state="1"><color red="0.45" green="0.06" blue="0.05" /></disk>
	</element>

	<element name="key" defstate="0">
		<rect state="0"><color red="0.80" green="0.80" blue="0.80" /></rect>
		<rect state="1"><color red="0.45" green="0.45" blue="0.45" /></rect>
	</element>

	<element name="switch" defstate="0">
		<rect state="0"><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect state="1"><color red="0.95" green="0.65" blue="0.10" /></rect>
		<text state="0" string="NORMAL"><color red="0.85" green="0.85" blue="0.85" /></text>
		<text state="1" string="CONTROL"><color red="0.0" green="0.0" blue="0.0" /></text>
	</element>

	<element name="toggle" defstate="0">
		<rect state="0"><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect state="1"><color red="0.85" green="0.20" blue="0.15" /></rect>
	</element>

	<element name="lamp" defstate="0">
		<disk state="0"><color red="0.20" green="0.08" blue="0.05" /></disk>
		<disk state="1"><color red="1.00" green="0.45" blue="0.10" /></disk>
	</element>

	<!-- text -->

	<repeat count="8">
		<param name="n" start="1" increment="1" />
		<element name="text_key_~n~"><text string="~n~"><color red="0.0" green="0.0" blue="0.0" /></text></element>
		<element name="text_c_~n~"><text string="~n~"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	</repeat>

	<repeat count="2">
		<param name="n" start="1" increment="1" />
		<element name="text_~n~"><text string="~n~" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	</repeat>

	<element name="text_selection"><text string="SELECTION" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_c_coin_return"><text string="COIN RETURN"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_control_keys"><text string="CONTROL KEYS" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_service"><text string="SERVICE" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_key_plus1"><text string="+1"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_plus10"><text string="+10"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_plus100"><text string="+100"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_h1"><text string="H1"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_h2"><text string="H2"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_reset"><text string="RESET"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_count"><text string="COUNT"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_key_clear"><text string="CLEAR"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_hopper_empty_click_to_toggle"><text string="HOPPER EMPTY (click to toggle)" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_latch_outputs"><text string="LATCH OUTPUTS" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q0_hopper_1"><text string="Q0 hopper 1" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q1_hopper_2"><text string="Q1 hopper 2" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q2_running"><text string="Q2 running" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q3_coin_return"><text string="Q3 coin return?" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q4_after_vend"><text string="Q4 after vend" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q5_coin_enable"><text string="Q5 coin enable?" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q6_exact_change"><text string="Q6 exact change?" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_q7_sold_out"><text string="Q7 sold out?" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_vend_motors"><text string="VEND MOTORS" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>

	<view name="Machine">
		<element ref="panel"><bounds x="0" y="0" width="400" height="324" /></element>

		<!-- display, digit 3 is leftmost -->
		<element ref="bezel"><bounds x="150" y="10" width="100" height="50" /></element>
		<repeat count="4">
			<param name="n" start="3" increment="-1" />
			<param name="x" start="158" increment="22" />
			<element name="digit~n~" ref="digit"><bounds x="~x~" y="18" width="18" height="34" /></element>
		</repeat>

		<!-- selections 1-7 are KEY0 bits 1-7, selection 8 is KEY1 bit 0 -->
		<element ref="text_selection"><bounds x="10" y="72" width="120" height="10" /></element>
		<repeat count="7">
			<param name="n" start="1" increment="1" />
			<param name="x" start="20" increment="30" />
			<param name="mask" start="0x02" lshift="1" />
			<element ref="button" inputtag="KEY0" inputmask="~mask~"><bounds x="~x~" y="86" width="22" height="22" /></element>
			<element ref="text_key_~n~"><bounds x="~x~" y="90" width="22" height="14" /></element>
		</repeat>
		<element ref="button" inputtag="KEY1" inputmask="0x01"><bounds x="230" y="86" width="22" height="22" /></element>
		<element ref="text_key_8"><bounds x="230" y="90" width="22" height="14" /></element>

		<element ref="button_red" inputtag="KEY0" inputmask="0x01"><bounds x="300" y="82" width="30" height="30" /></element>
		<element ref="text_c_coin_return"><bounds x="280" y="114" width="70" height="8" /></element>

		<!-- operator keys and service switch -->
		<element ref="text_control_keys"><bounds x="10" y="130" width="120" height="10" /></element>
		<element ref="text_service"><bounds x="300" y="130" width="60" height="10" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x01"><bounds x="20" y="144" width="26" height="18" /></element>
		<element ref="text_key_plus1"><bounds x="20" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x02"><bounds x="50" y="144" width="26" height="18" /></element>
		<element ref="text_key_plus10"><bounds x="50" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x04"><bounds x="80" y="144" width="26" height="18" /></element>
		<element ref="text_key_plus100"><bounds x="80" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x08"><bounds x="110" y="144" width="26" height="18" /></element>
		<element ref="text_key_h1"><bounds x="110" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x10"><bounds x="140" y="144" width="26" height="18" /></element>
		<element ref="text_key_h2"><bounds x="140" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x20"><bounds x="170" y="144" width="26" height="18" /></element>
		<element ref="text_key_reset"><bounds x="170" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x40"><bounds x="200" y="144" width="26" height="18" /></element>
		<element ref="text_key_count"><bounds x="200" y="147" width="26" height="12" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x80"><bounds x="230" y="144" width="26" height="18" /></element>
		<element ref="text_key_clear"><bounds x="230" y="147" width="26" height="12" /></element>
		<element ref="switch" inputtag="P1" inputmask="0x40"><bounds x="300" y="144" width="70" height="18" /></element>

		<!-- hopper empty switches, hopper 1 is P1 bit 4 -->
		<element ref="text_hopper_empty_click_to_toggle"><bounds x="10" y="178" width="250" height="10" /></element>
		<repeat count="2">
			<param name="n" start="1" increment="1" />
			<param name="x" start="20" increment="60" />
			<param name="tx" start="34" increment="60" />
			<param name="mask" start="0x10" lshift="1" />
			<element ref="toggle" inputtag="P1" inputmask="~mask~"><bounds x="~x~" y="192" width="10" height="8" /></element>
			<element ref="text_~n~"><bounds x="~tx~" y="192" width="44" height="8" /></element>
		</repeat>

		<!-- latch outputs: Q0-Q3 on the left, Q4-Q7 on the right -->
		<element ref="text_latch_outputs"><bounds x="10" y="212" width="120" height="10" /></element>
		<repeat count="2">
			<param name="first" start="0" increment="4" />
			<param name="x" start="20" increment="180" />
			<repeat count="4">
				<param name="q" start="~first~" increment="1" />
				<param name="y" start="226" increment="12" />
				<element name="out1~q~" ref="lamp"><bounds x="~x~" y="~y~" width="8" height="8" /></element>
			</repeat>
		</repeat>
		<element ref="text_q0_hopper_1"><bounds x="32" y="226" width="160" height="8" /></element>
		<element ref="text_q1_hopper_2"><bounds x="32" y="238" width="160" height="8" /></element>
		<element ref="text_q2_running"><bounds x="32" y="250" width="160" height="8" /></element>
		<element ref="text_q3_coin_return"><bounds x="32" y="262" width="160" height="8" /></element>
		<element ref="text_q4_after_vend"><bounds x="212" y="226" width="160" height="8" /></element>
		<element ref="text_q5_coin_enable"><bounds x="212" y="238" width="160" height="8" /></element>
		<element ref="text_q6_exact_change"><bounds x="212" y="250" width="160" height="8" /></element>
		<element ref="text_q7_sold_out"><bounds x="212" y="262" width="160" height="8" /></element>

		<!-- vend motors -->
		<element ref="text_vend_motors"><bounds x="10" y="282" width="120" height="10" /></element>
		<repeat count="8">
			<param name="n" start="1" increment="1" />
			<param name="x" start="20" increment="30" />
			<param name="lx" start="27" increment="30" />
			<element name="motor~n~" ref="lamp"><bounds x="~lx~" y="296" width="8" height="8" /></element>
			<element ref="text_c_~n~"><bounds x="~x~" y="306" width="22" height="8" /></element>
		</repeat>
	</view>

</mamelayout>
