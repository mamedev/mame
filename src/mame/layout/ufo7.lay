<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:hap, pizzzza19
Derived from ufo21.lay: grey panel and three buttons per player.
-->
<mamelayout version="2">

	<element name="black"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="gray"><rect><color red="0.6" green="0.6" blue="0.6" /></rect></element>
	<element name="ufo"><text string="~UFO~" /></element>
	<element name="text0"><text string="X:" align="1" /></element>
	<element name="text1"><text string="Y:" align="1" /></element>
	<element name="text2"><text string="Z:" align="1" /></element>
	<element name="text3"><text string="C:" align="1" /></element>

	<element name="digit" defstate="0">
		<led7seg><color red="1" green="0.3" blue="0.2" /></led7seg>
	</element>
	<element name="counter" defstate="0">
		<simplecounter digits="3" align="1"><color red="0.95" green="0.95" blue="0.95" /></simplecounter>
	</element>

	<repeat count="3">
		<param name="n" start="1" increment="1" />
		<element name="button~n~" defstate="0">
			<disk><color red="0" green="0" blue="0" /></disk>
			<disk>
				<bounds x="0.05" y="0.05" width="0.9" height="0.9" />
				<color state="0" red="0.7" green="0.7" blue="0.7" />
				<color state="1" red="1" green="1" blue="1" />
			</disk>
			<text string="~n~">
				<color red="0" green="0" blue="0" />
				<bounds x="0" y="0.2" width="1" height="0.6" />
			</text>
		</element>
	</repeat>

	<element name="lamp" defstate="0">
		<disk>
			<color state="0" red="0.2" green="0.05" blue="0" />
			<color state="1" red="1" green="0.4" blue="0.3" />
		</disk>
	</element>

	<view name="Internal Layout">
		<bounds x="0" y="0" width="200" height="90" />
		<element ref="black"><bounds x="0" y="0" width="200" height="90" /></element>
		<element ref="gray"><bounds x="99" y="0" width="2" height="80" /></element>
		<element ref="gray"><bounds x="0" y="60" width="200" height="30" /></element>

		<!-- credit displays -->
		<repeat count="2">
			<param name="n" start="0" increment="1" />
			<param name="x" start="60" increment="68" />
			<param name="dx" start="61" increment="68" />
			<element ref="black"><bounds x="~x~" y="70" width="12" height="17" /></element>
			<element name="digit~n~" ref="digit"><bounds x="~dx~" y="71" width="10" height="15" /></element>
		</repeat>

		<!-- position counters -->
		<repeat count="4">
			<param name="n" start="0" increment="1" />
			<param name="m" start="4" increment="1" />
			<param name="y" start="5" increment="5" />

			<element ref="text~n~">
				<bounds x="5" y="~y~" width="10" height="4" />
				<color red="0.85" green="0.85" blue="0.85" />
			</element>
			<element ref="text~n~">
				<bounds x="105" y="~y~" width="10" height="4" />
				<color red="0.85" green="0.85" blue="0.85" />
			</element>
			<element name="counter~n~" ref="counter"><bounds x="12" y="~y~" width="20" height="4" /></element>
			<element name="counter~m~" ref="counter"><bounds x="112" y="~y~" width="20" height="4" /></element>
		</repeat>

		<element ref="ufo">
			<bounds x="25" y="25" width="50" height="14" />
			<color red="1" green="0.3" blue="0.2" />
		</element>
		<element ref="ufo">
			<bounds x="125" y="25" width="50" height="14" />
			<color red="0.2" green="0.3" blue="1" />
		</element>

		<!-- lamps -->
		<repeat count="6">
			<param name="n" start="11" increment="1" />
			<param name="m" start="21" increment="1" />
			<param name="x" start="31" increment="7" />
			<param name="rx" start="131" increment="7" />
			<element name="lamp~n~" ref="lamp"><bounds x="~x~" y="44" width="3" height="3" /></element>
			<element name="lamp~m~" ref="lamp"><bounds x="~rx~" y="44" width="3" height="3" /></element>
		</repeat>

		<!-- control panel -->
		<repeat count="3">
			<param name="n" start="1" increment="1" />
			<param name="x" start="17" increment="13" />
			<param name="rx" start="147" increment="13" />
			<param name="mask" start="0x80" rshift="1" />
			<element ref="button~n~" inputtag="IN2" inputmask="~mask~">
				<bounds x="~x~" y="70" width="10" height="10" />
			</element>
			<element ref="button~n~" inputtag="IN1" inputmask="~mask~">
				<bounds x="~rx~" y="70" width="10" height="10" />
			</element>
		</repeat>
	</view>
</mamelayout>
