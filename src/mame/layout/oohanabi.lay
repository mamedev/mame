<!-- 4th reel (各図柄の中心を窓幅210の中央に合わせる定義) -->
	<element name="SREEL3">
		<rect><bounds x="0" y="0" width="735" height="100"/><color alpha="0.0"/></rect>
		<!-- 大当りは幅210いっぱい -->
		<text string="[  大  当  り  ]"> <bounds x="0.0"   y="0" width="210" height="100"/> <color red="1.0" green="0.2" blue="0.2"/> </text>
		<!-- 通常図柄は幅105だが、配置の基準を揃える -->
		<text string="[赤ドン]">         <bounds x="210.0" y="0" width="105" height="100"/> <color red="1.0" green="0.0" blue="0.0"/> </text>
		<text string="[三尺玉]">         <bounds x="315.0" y="0" width="105" height="100"/> <color red="0.9" green="0.5" blue="0.0"/> </text>
		<text string="[ハズレ]">         <bounds x="420.0" y="0" width="105" height="100"/> <color red="0.3" green="0.3" blue="0.3"/> </text>
		<text string="[青ドン]">         <bounds x="525.0" y="0" width="105" height="100"/> <color red="0.0" green="0.0" blue="1.0"/> </text>
		<text string="[一尺玉]">         <bounds x="630.0" y="0" width="105" height="100"/> <color red="0.3" green="1.0" blue="1.0"/> </text>
	</element>

<!-- View field -->

	<view name="AWP Simulated Video" showpointers="no">

	<!-- Screen size -->

		<element ref="screen_background_color">
			<bounds x="0" y="0" width="640" height="480"/>
		</element>

	<!-- Frame lamp (4th reel top lamp) -->

		<element name="lamp_frame_t0" ref="LFRAME_T0">
			<bounds x="0" y="0" width="188" height="50"/>
		</element>
		<element name="lamp_frame_t1" ref="LFRAME_T1">
			<bounds x="194" y="0" width="80" height="50"/>
		</element>
		<element name="lamp_frame_t2" ref="LFRAME_T2">
		<bounds x="280" y="0" width="80" height="50"/>
		</element>
		<element name="lamp_frame_t3" ref="LFRAME_T3">
			<bounds x="366" y="0" width="80" height="50"/>
		</element>
		<element name="lamp_frame_t4" ref="LFRAME_T4">
			<bounds x="452" y="0" width="188" height="50"/>
		</element>

	<!-- Frame lamp (4th reel side lamp) -->

		<element name="lamp_frame_sl0" ref="LFRAME_S0">
			<bounds x="120" y="60" width="29" height="70"/>
		</element>
		<element name="lamp_frame_sl1" ref="LFRAME_S1">
			<bounds x="149" y="60" width="29" height="70"/>
		</element>
		<element name="lamp_frame_sl2" ref="LFRAME_S2">
			<bounds x="178" y="60" width="29" height="70"/>
		</element>

		<element name="lamp_frame_sr2" ref="LFRAME_S2">
			<bounds x="433" y="60" width="29" height="70"/>
		</element>
		<element name="lamp_frame_sr1" ref="LFRAME_S1">
			<bounds x="462" y="60" width="29" height="70"/>
		</element>
		<element name="lamp_frame_sr0" ref="LFRAME_S0">
			<bounds x="491" y="60" width="29" height="70"/>
		</element>

	<!-- Betline lamps -->

		<element name="lamp_betline3" ref="LBETLINE3">
			<bounds x="20" y="110" width="80" height="40"/>
		</element>
		<element name="lamp_betline1" ref="LBETLINE1">
			<bounds x="20" y="160" width="80" height="40"/>
		</element>
		<element name="lamp_betline0" ref="LBETLINE0">
			<bounds x="20" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_betline2" ref="LBETLINE2">
			<bounds x="20" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_betline4" ref="LBETLINE4">
			<bounds x="20" y="310" width="80" height="40"/>
		</element>

	<!-- Stop button lamp -->

		<element name="lamp_stop0" ref="LSTOP0">
			<bounds x="165" y="386" width="35" height="35"/>
		</element>
		<element name="lamp_stop1" ref="LSTOP1">
			<bounds x="305" y="386" width="35" height="35"/>
		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="445" y="386" width="35" height="35"/>
		</element>

	<!-- Win lamp -->

		<element name="lamp_win" ref="LWIN">
			<bounds x="540" y="120" width="80" height="80"/>
		</element>
		<element ref="TWIN">
			<bounds x="545" y="150" width="70" height="20"/>
		</element>

	<!-- Replay lamp -->

		<element name="lamp_replay" ref="LREPLAY">
			<bounds x="540" y="210" width="80" height="40"/>
		</element>

	<!-- Start lamp -->

		<element name="lamp_start" ref="LSTART">
			<bounds x="540" y="260" width="80" height="40"/>
		</element>

	<!-- Insert medal lamp -->

		<element name="lamp_insert" ref="LINSERT">
			<bounds x="540" y="310" width="80" height="40"/>
		</element>

	<!-- Maxbet LED -->

		<element name="lamp_maxbet" ref="LMAXBET">
			<bounds x="30" y="430" width="60" height="35"/>
		</element>

	<!-- Credit SEG -->

		<element name="seg_credit0" ref="digit_r">
			<bounds x="170" y="336" width="20" height="35"/>
		</element>
		<element name="seg_credit1" ref="digit_r">
			<bounds x="190" y="336" width="20" height="35"/>
		</element>

	<!-- Bonus count SEG -->

		<element name="seg_count0" ref="digit_g">
			<bounds x="320" y="336" width="20" height="35"/>
		</element>
		<element name="seg_count1" ref="digit_g">
			<bounds x="340" y="336" width="20" height="35"/>
		</element>
		<element name="seg_count2" ref="digit_g">
			<bounds x="360" y="336" width="20" height="35"/>
		</element>

	<!-- Payout SEG -->

		<element name="seg_payout0" ref="digit_r">
			<bounds x="430" y="336" width="20" height="35"/>
		</element>
		<element name="seg_payout1" ref="digit_r">
			<bounds x="450" y="336" width="20" height="35"/>
		</element>

	<!-- Chance LED -->

		<element name="led_chance0" ref="LED_CHANCE0">
			<bounds x="250" y="350" width="8" height="8"/>
		</element>
		<element name="led_chance1" ref="LED_CHANCE1">
			<bounds x="275" y="350" width="8" height="8"/>
		</element>

	<!-- Reel -->

		<repeat count="3">

			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>
			<param name="dx" start="100" increment="140"/>

		<!-- Reel lamp 3x3 -->

			<element name="lamp_reel~i~_0" ref="LREEL~i~_0">
				<bounds x="~x~" y="140" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_1" ref="LREEL~i~_1">
				<bounds x="~x~" y="200" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_2" ref="LREEL~i~_2">
				<bounds x="~x~" y="260" width="120" height="60"/>
			</element>

		<!-- Reel pattern 0/1/2 -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Reel lamp for 4th reel 3x1 -->

		<element name="lamp_reel3_0" ref="LREEL3_0">
			<bounds x="215" y="60" width="70" height="70"/>
		</element>
		<element name="lamp_reel3_1" ref="LREEL3_1">
			<bounds x="285" y="60" width="70" height="70"/>
		</element>
		<element name="lamp_reel3_2" ref="LREEL3_2">
			<bounds x="355" y="60" width="70" height="70"/>
		</element>

	<!-- Reel pattern for 4th reel -->

<!-- Reel pattern for 4th reel -->

		<element ref="SREEL3">
			<bounds x="215" y="60" width="210" height="70"/>
			<xscroll name="reel3:scroll" size="0.285714" wrap="yes" min="0" max="65536"/>
		</element>

	<!-- Hopper & Coin solenoid -->

		<element name="signal_hopper" ref="SIGNALHOPPER">
			<bounds x="490" y="60" width="60" height="25"/>
		</element>
		<element name="signal_solenoid" ref="SIGNALSOLENOID">
			<bounds x="560" y="60" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="20" y="60" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="90" y="60" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
