	<element name="LCREDIT" defstate="0">
		<rect>
			<color red="0.25" green="0.50" blue="0.65"/>
		</rect>
		<text string=" CREDIT ">
			<color red="0.10" green="0.15" blue="0.50"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- insert medal lamps -->

	<element name="LINSMEDAL" defstate="0">
		<rect state="0">
			<color red="0.30" green="0.30" blue="0.05"/>
		</rect>
		<rect state="1">
			<color red="0.90" green="0.90" blue="0.15"/>
