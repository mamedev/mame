<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>

	<element name="digit">
		<led7seg>
			<color red="1.0" green="0.2" blue="0.2"/>
		</led7seg>
	</element>

<!-- Top Panel LAMPs -->

	<element name="LTOPPANELW" defstate="0">
		<rect state="0">
			<color red="0.20" green="0.04" blue="0.04"/>
		</rect>
		<rect state="1">
			<color red="1.00" green="0.20" blue="0.20"/>
