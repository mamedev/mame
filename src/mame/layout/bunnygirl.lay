		</rect>
		<rect state="1">
			<color red="0.15" green="1.00" blue="0.15"/>
		</rect>
	</element>

<!-- Right panel static labels -->

	<element name="TJACBB">
		<rect>
			<color red="0.02" green="0.18" blue="0.08"/>
		</rect>
		<text string=" JAC &amp; B.B ">
			<color red="0.65" green="0.95" blue="0.55"/>
