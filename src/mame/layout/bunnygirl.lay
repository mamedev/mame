	</element>

<!-- Wait time LEDs -->

	<element name="LWAITTIME_RED" defstate="0">
		<rect state="0">
			<color red="0.12" green="0.02" blue="0.02"/>
		</rect>
		<rect state="1">
			<color red="1.00" green="0.12" blue="0.12"/>
