		</element>

	<!-- Top Panel Lamps -->

		<element name="lamp_toppanelc0" ref="LTOPPANELC0">
			<bounds x="25" y="25" width="295" height="50"/>
		</element>
		<element name="lamp_toppanelc1" ref="LTOPPANELC1">
			<bounds x="320" y="25" width="295" height="50"/>
		</element>

		<!-- Upper row -->

		<element name="lamp_toppanelw0" ref="LTOPPANELW">
			<bounds x="0" y="0" width="108" height="25"/>
		</element>
		<element name="lamp_toppanelw1" ref="LTOPPANELW">
			<bounds x="108" y="0" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw2" ref="LTOPPANELW">
			<bounds x="214" y="0" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw3" ref="LTOPPANELW">
			<bounds x="320" y="0" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw4" ref="LTOPPANELW">
			<bounds x="426" y="0" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw5" ref="LTOPPANELW">
			<bounds x="532" y="0" width="108" height="25"/>
		</element>

		<!-- Side lamps share the corner output signals. -->

		<element name="lamp_toppanelw0" ref="LTOPPANELW">
			<bounds x="0" y="25" width="25" height="25"/>
		</element>
		<element name="lamp_toppanelw5" ref="LTOPPANELW">
			<bounds x="615" y="25" width="25" height="25"/>
		</element>
		<element name="lamp_toppanelw11" ref="LTOPPANELW">
			<bounds x="0" y="50" width="25" height="25"/>
		</element>
		<element name="lamp_toppanelw6" ref="LTOPPANELW">
			<bounds x="615" y="50" width="25" height="25"/>
		</element>

		<!-- Lower row -->

		<element name="lamp_toppanelw11" ref="LTOPPANELW">
			<bounds x="0" y="75" width="108" height="25"/>
		</element>
		<element name="lamp_toppanelw10" ref="LTOPPANELW">
			<bounds x="108" y="75" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw9" ref="LTOPPANELW">
			<bounds x="214" y="75" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw8" ref="LTOPPANELW">
			<bounds x="320" y="75" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw7" ref="LTOPPANELW">
			<bounds x="426" y="75" width="106" height="25"/>
		</element>
		<element name="lamp_toppanelw6" ref="LTOPPANELW">
			<bounds x="532" y="75" width="108" height="25"/>
		</element>

	<!-- Betline lamps -->

		<element name="lamp_betline4" ref="LBETLINE3">
			<bounds x="540" y="110" width="80" height="40"/>
		</element>
		<element name="lamp_betline1" ref="LBETLINE1">
			<bounds x="540" y="160" width="80" height="40"/>
		</element>
		<element name="lamp_betline0" ref="LBETLINE0">
			<bounds x="540" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_betline2" ref="LBETLINE2">
			<bounds x="540" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_betline3" ref="LBETLINE4">
			<bounds x="540" y="310" width="80" height="40"/>
		</element>

	<!-- stop / insert medal lamps -->

		<element name="lamp_stop0" ref="LSTOP0">
			<bounds x="145" y="365" width="70" height="35"/>
		</element>
		<element name="lamp_stop1" ref="LSTOP1">
			<bounds x="285" y="365" width="70" height="35"/>
		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="425" y="365" width="70" height="35"/>
		</element>
		<element name="lamp_insert" ref="LINSMEDAL">
			<bounds x="540" y="365" width="80" height="35"/>
		</element>

	<!-- Wait time LEDs -->

		<!-- Outputs are numbered from the bottom red LED upward. -->
		<repeat count="24">
			<param name="i" start="0" increment="1"/>
			<param name="y" start="330" increment="-7"/>
			<element name="led_waittime~i~" ref="LWAITTIME_RED">
				<bounds x="97" y="~y~" width="12" height="5"/>
			</element>
		</repeat>
		<repeat count="6">
			<param name="i" start="24" increment="1"/>
			<param name="y" start="162" increment="-7"/>
			<element name="led_waittime~i~" ref="LWAITTIME_GREEN">
				<bounds x="97" y="~y~" width="12" height="5"/>
			</element>
		</repeat>

	<!-- Right panel labels and SEGs -->

		<element ref="TJACBB">
			<bounds x="20" y="125" width="64" height="12"/>
		</element>
		<element name="seg_jacbb0" ref="digit">
			<bounds x="32" y="150" width="22" height="37"/>
		</element>
		<element name="seg_jacbb1" ref="digit">
			<bounds x="55" y="150" width="22" height="37"/>
		</element>

		<element ref="TCREDIT">
			<bounds x="20" y="200" width="64" height="12"/>
		</element>
		<element name="seg_credit0" ref="digit">
			<bounds x="32" y="225" width="22" height="37"/>
		</element>
		<element name="seg_credit1" ref="digit">
			<bounds x="55" y="225" width="22" height="37"/>
		</element>

		<element ref="TPAYOUT">
			<bounds x="20" y="275" width="64" height="12"/>
		</element>
		<element name="seg_payout0" ref="digit">
			<bounds x="32" y="300" width="22" height="37"/>
		</element>
		<element name="seg_payout1" ref="digit">
			<bounds x="55" y="300" width="22" height="37"/>
		</element>

	<!-- Game reels -->

		<repeat count="3">

			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>

			<element ref="LREEL">
				<bounds x="~x~" y="140" width="120" height="180"/>
			</element>

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="0" max="65536"/>
			</element>

		</repeat>

	<!-- Hopper & Coin solenoid -->

		<element name="signal_hopper" ref="SIGNALHOPPER">
			<bounds x="490" y="430" width="60" height="25"/>
		</element>
		<element name="signal_solenoid" ref="SIGNALSOLENOID">
			<bounds x="560" y="430" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="20" y="430" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="90" y="430" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
