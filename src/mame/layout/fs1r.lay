<mamelayout version="2">

	<element name="led" defstate="0">
		<disk state="0"><color red="0.22" green="0.26" blue="0.20" /></disk>
		<disk state="1"><color red="0.40" green="0.95" blue="0.28" /></disk>
	</element>
	<element name="led_red" defstate="0">
		<disk state="0"><color red="0.26" green="0.14" blue="0.12" /></disk>
		<disk state="1"><color red="0.95" green="0.18" blue="0.12" /></disk>
	</element>

	<element name="round_button">
		<disk state="0">
			<color red="0.10" green="0.10" blue="0.10" alpha="0"/>
		</disk>
		<disk state="1">
			<color red="0.16" green="0.16" blue="0.17" alpha="0.35"/>
		</disk>
	</element>

	<element name="lit_green" defstate="0">
		<disk state="0">
			<color red="0.32" green="0.92" blue="0.30" alpha="0"/>
		</disk>
		<disk state="1">
			<color red="0.32" green="0.92" blue="0.30" alpha="0.72"/>
		</disk>
	</element>

	<element name="lit_red" defstate="0">
		<disk state="0">
			<color red="0.95" green="0.20" blue="0.16" alpha="0"/>
		</disk>
		<disk state="1">
			<color red="0.95" green="0.20" blue="0.16" alpha="0.72"/>
		</disk>
	</element>

	<element name="lcda" defstate="0">
		<rect>
			<color state="0" red="0" green="0" blue="0" />
			<color state="7" red="0.95" green="0.95" blue="0.95" />
		</rect>
	</element>

	<!-- Cover the static 12-o'clock pointer in the panel SVG. -->
	<element name="knob_face">
		<disk><color red="0.616" green="0.624" blue="0.635"/></disk>
	</element>
	<element name="knob_inner">
		<disk><color red="0.345" green="0.349" blue="0.357"/></disk>
	</element>
	<element name="knob_hit">
		<disk>
			<color state="0" red="0.10" green="0.10" blue="0.10" alpha="0"/>
			<color state="1" red="0.22" green="0.22" blue="0.22" alpha="0.35"/>
		</disk>
	</element>
	<!-- Layout items cannot rotate by arbitrary angles, so the pointer is a set of pre-rotated SVGs. State 0 is min (-150 deg), 30 is max (+150). -->
