		<param name="id" value="KNOB1"/>
		<group ref="knob"><bounds x="1053.05" y="90.6" width="64.5" height="64.5"/></group>
		<param name="id" value="KNOB2"/>
		<group ref="knob"><bounds x="1213.0" y="90.75" width="64.5" height="64.5"/></group>
		<param name="id" value="KNOB3"/>
		<group ref="knob"><bounds x="1372.9" y="90.75" width="64.5" height="64.5"/></group>
		<param name="id" value="KNOB4"/>
		<group ref="knob"><bounds x="1532.85" y="90.75" width="64.5" height="64.5"/></group>
	</view>

	<script><![CDATA[
		file:set_resolve_tags_callback(function()
			local view = file.views["Internal Layout"]
			install_knobs(view)
			for i = 1, 4 do
				add_knob(view, "KNOB" .. i, "KNOB" .. i, 7, "KNOB" .. i .. "_tick")
			end
		end)

		KNOB_POINTER_STATES = 30

		local widgets = {}
		local pointers = {}

		function add_knob(view, clickarea_id, port_name, scale, tick_id)
			local field = get_port_field(port_name)
			if field == nil then
				return
			end
			local tick = get_layout_item(view, tick_id)
			table.insert(widgets, {
				clickarea = get_layout_item(view, clickarea_id),
				field = field,
				scale = scale,
				knob_dot = tick
			})
			if tick then
				local vmin = field.minvalue
				local vrange = field.maxvalue - field.minvalue
				tick:set_element_state_callback(function()
					local value = 0
					if vrange ~= 0 then
						value = (field.user_value - vmin) / vrange
					end
					if value < 0 then value = 0 elseif value > 1 then value = 1 end
					return math.floor(value * KNOB_POINTER_STATES + 0.5)
				end)
			end
		end

		function get_layout_item(view, item_id)
			local item = view.items[item_id]
			if item == nil then
				emu.print_error("Layout element: '" .. item_id .. "' not found.")
			end
			return item
		end

		function get_port_field(port_name)
			local port = file.device:ioport(port_name)
			if port == nil then
				emu.print_error("Port: '" .. port_name .. "' not found.")
				return nil
			end
			for _, field in pairs(port.fields) do
				return field
			end
			return nil
		end

		local function release_pointer(pointer_id)
			if pointers[pointer_id] then
				widgets[pointers[pointer_id].selected_widget].clickarea:set_state(0)
			end
			pointers[pointer_id] = nil
		end

		local function pointer_updated(type, id, dev, x, y, btn, dn, up, cnt)
			if btn & 1 == 0 then
				release_pointer(id)
				return
			end
			if dn & 1 ~= 0 then
				for i = 1, #widgets do
					if widgets[i].clickarea and widgets[i].clickarea.bounds:includes(x, y) then
						widgets[i].clickarea:set_state(1)
						pointers[id] = {
							selected_widget = i,
							start_y = y,
							start_value = widgets[i].field.user_value
						}
						break
					end
				end
			end
			if pointers[id] == nil then
				return
			end
			local pointer = pointers[id]
			local widget = widgets[pointer.selected_widget]
			local min_value = widget.field.minvalue
			local max_value = widget.field.maxvalue
			local step = (max_value - min_value) / (widget.scale * widget.clickarea.bounds.height)
			local new_value = math.floor(pointer.start_value + (pointer.start_y - y) * step + 0.5)
			if new_value < min_value then new_value = min_value end
			if new_value > max_value then new_value = max_value end
			if widget.field.is_analog then
				widget.field:set_value(new_value)
			else
				widget.field.user_value = new_value
			end
		end

		function install_knobs(view)
			view:set_pointer_updated_callback(pointer_updated)
			view:set_pointer_left_callback(function(type, id) release_pointer(id) end)
			view:set_pointer_aborted_callback(function(type, id) release_pointer(id) end)
			view:set_forget_pointers_callback(function()
				for id in pairs(pointers) do
					release_pointer(id)
				end
				pointers = {}
			end)
		end
	]]></script>

</mamelayout>
