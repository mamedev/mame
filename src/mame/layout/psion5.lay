Digitiser overlay for Psion Series 5 (English)
-->

<mamelayout version="2">

	<element name="overlay_left">
		<!-- background -->
		<rect>
			<bounds x="0" y="0" width="35" height="250" />
			<color red="0.80" green="0.80" blue="0.80" />
		</rect>

		<!-- icons (placeholder) -->
		<text string="Menu">
			<bounds x="5" y="16" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>

		<text string="Cut">
			<bounds x="5" y="56" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>
		<text string="Paste">
			<bounds x="5" y="73" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>

		<text string="IR">
			<bounds x="5" y="116" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>

		<text string="Zoom">
			<bounds x="5" y="156" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>
		<text string="+">
			<bounds x="5" y="173" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>

		<text string="Zoom">
			<bounds x="5" y="206" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>
		<text string="-">
			<bounds x="5" y="223" width="25" height="16" />
			<color red="0.07" green="0.06" blue="0.07" />
		</text>

		<!-- separators -->
		<rect>
			<bounds x="4" y="49" width="30" height="1" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>
		<rect>
			<bounds x="34" y="3" width="1" height="47" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>

		<rect>
			<bounds x="4" y="99" width="30" height="1" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>
		<rect>
			<bounds x="34" y="53" width="1" height="47" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>

		<rect>
			<bounds x="4" y="149" width="30" height="1" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>
		<rect>
			<bounds x="34" y="103" width="1" height="47" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>

		<rect>
			<bounds x="4" y="249" width="30" height="1" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>
		<rect>
			<bounds x="34" y="153" width="1" height="97" />
			<color red="0.07" green="0.06" blue="0.07" />
		</rect>
	</element>

	<element name="overlay_icons">
		<!-- background -->
		<rect>
			<bounds x="0" y="0" width="55" height="30" />
			<color red="0.93" green="0.48" blue="0.24" />
		</rect>
		<rect>
			<bounds x="55" y="0" width="640" height="30" />
			<color red="0.80" green="0.80" blue="0.80" />
		</rect>

		<!-- icons (placeholder) -->
		<disk>
			<bounds x="20" y="7.5" width="15" height="15" />
			<color red="0.07" green="0.06" blue="0.07" />
		</disk>
		<disk>
			<bounds x="87.5" y="7.5" width="15" height="15" />
			<color red="0.07" green="0.06" blue="0.07" />
