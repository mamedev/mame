		</disk>
		<disk>
			<bounds x="567.5" y="7.5" width="15" height="15" />
			<color red="0.07" green="0.06" blue="0.07" />
		</disk>
		<disk>
			<bounds x="647.5" y="7.5" width="15" height="15" />
			<color red="0.07" green="0.06" blue="0.07" />
