<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders: Roberto Fresca

************************************************

  Lucky Roulette Plus layout.

  37-LED European Roulette artwork with
  accurate number mapping, inverted LED matrix

  Vertical design (4:3).

************************************************
-->
<mamelayout version="2">

	<!-- Background 4:3, 1600x1200 -->
	<element name="bg_adjust">
		<rect>
			<bounds x="0" y="0" width="1600" height="1200" />
			<color red="0.0" green="0.1" blue="0.0" />
		</rect>
	</element>

	<!-- Static element simulating the physical roulette wheel -->
	<element name="roulette">
		<!-- 1. External plate -->
		<disk>
			<bounds x="0" y="0" width="100" height="100" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<!-- 2. Intermediate ring where the LEDs and numbers are placed -->
		<disk>
			<bounds x="6" y="6" width="88" height="88" />
			<color red="0.05" green="0.05" blue="0.05" />
		</disk>
		<!-- 3. Center plate -->
		<disk>
			<bounds x="17" y="17" width="66" height="66" />
			<color red="0.10" green="0.10" blue="0.10" />
		</disk>
		<!-- 4. Center cone element -->
		<disk>
			<bounds x="36" y="36" width="28" height="28" />
			<color red="0.20" green="0.20" blue="0.20" />
		</disk>
		<!-- 5. Turret spindle -->
		<disk>
			<bounds x="44" y="44" width="12" height="12" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<!-- 6. Roulette turret (horizontal piece) -->
		<rect>
			<bounds x="30" y="48" width="40" height="4" />
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
		<!-- 7. Roulette turret (verticalal piece) -->
		<rect>
			<bounds x="48" y="30" width="4" height="40" />
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<!-- BALL elements definitions -->
	<element name="BALL0">
		<disk state="0"><color red="0.0" green="0.3" blue="0" /></disk>
		<disk state="1"><color red="0" green="1" blue="0" /></disk>
	</element>

	<element name="BALL">
		<disk state="0"><color red="0.3" green="0" blue="0" /></disk>
		<disk state="1"><color red="1" green="0" blue="0" /></disk>
	</element>

	<!-- Roulette numbers definition -->
	<element name="n0"><text string="0"><color red="0.5" green="0.5" blue="0.5"/></text></element>
	<element name="n1"><text string="1"><color red="0.5" green="0.5" blue="0.5"/></text></element>
	<element name="n2"><text string="2"><color red="0.5" green="0.5" blue="0.5"/></text></element>
	<element name="n3"><text string="3"><color red="0.5" green="0.5" blue="0.5"/></text></element>
	<element name="n4"><text string="4"><color red="0.5" green="0.5" blue="0.5"/></text></element>
	<element name="n5"><text string="5"><color red="0.5" green="0.5" blue="0.5"/></text></element>
