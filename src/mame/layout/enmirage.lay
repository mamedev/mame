			<bounds left="139" top="75" right="163" bottom="81" />
		</element>
		<element name="1.1" ref="led_segement">
			<bounds left="164" top="78" right="170" bottom="107" />
		</element>
		<element name="1.2" ref="led_segement">
			<bounds left="164" top="108" right="170" bottom="137" />
