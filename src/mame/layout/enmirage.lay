	<element name="button_grey"><rect><color red="0.5" green="0.5" blue="0.5" /></rect></element>
	<element name="button_black"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="button_white"><rect><color red="0.978" green="0.888" blue="0.825" /></rect></element>

	<!-- Music keyboard -->
	<element name="key_white" defstate="0">
		<rect><color red="0.1" green="0.1" blue="0.1" /></rect>
		<rect state="0"><bounds x="0.04" y="0" width="0.92" height="0.99" /><color red="0.96" green="0.95" blue="0.92" /></rect>
		<rect state="1"><bounds x="0.04" y="0" width="0.92" height="0.99" /><color red="0.70" green="0.70" blue="0.68" /></rect>
	</element>
	<element name="key_black" defstate="0">
		<rect state="0"><color red="0.08" green="0.08" blue="0.08" /></rect>
		<rect state="1"><color red="0.40" green="0.40" blue="0.40" /></rect>
	</element>
	<!-- Pitch and mod wheels -->
	<element name="wheel_body"><rect><color red="0.02" green="0.02" blue="0.02" /></rect></element>
	<element name="wheel_face"><rect><color red="0.22" green="0.22" blue="0.22" /></rect></element>
	<element name="wheel_knob"><rect><color red="0.62" green="0.62" blue="0.62" /></rect></element>
	<element name="wheel_center"><rect><color red="0.40" green="0.40" blue="0.40" /></rect></element>
	<element name="invisible_rect"><rect><color alpha="0" /></rect></element>
	<element name="label_PITCH"><text string="PITCH"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="label_MOD"><text string="MOD"><color red="0.85" green="0.85" blue="0.85" /></text></element>

	<element name="keybed"><rect><color red="0.1" green="0.1" blue="0.1" /></rect></element>

	<element name="led_segement" defstate="0">
		<rect state="0"><color red="0.85" green="0.87" blue="0.36" alpha="0.1" /></rect>
		<rect state="1"><color red="0.85" green="0.87" blue="0.36" /></rect>
	</element>

	<element name="led_indicator" defstate="0">
