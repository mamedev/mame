		</element>

		<!-- Music keyboard: 61 keys, C2-C7 -->
		<element ref="keybed"><bounds x="-110" y="0" width="110" height="627" /></element>
		<element ref="keybed"><bounds x="0" y="437" width="1000" height="190" /></element>
		<repeat count="5">
			<param name="n" start="0" increment="1" />
			<param name="c" start="32" increment="182" />
			<param name="cs" start="50" increment="182" />
			<param name="d" start="58" increment="182" />
			<param name="ds" start="76" increment="182" />
			<param name="e" start="84" increment="182" />
			<param name="f" start="110" increment="182" />
			<param name="fs" start="128" increment="182" />
			<param name="g" start="136" increment="182" />
			<param name="gs" start="154" increment="182" />
			<param name="a" start="162" increment="182" />
			<param name="as" start="180" increment="182" />
			<param name="b" start="188" increment="182" />

			<element ref="key_white" inputtag="kbd~n~" inputmask="0x001"><bounds x="~c~" y="447" width="26" height="170" /></element>
			<element ref="key_white" inputtag="kbd~n~" inputmask="0x004"><bounds x="~d~" y="447" width="26" height="170" /></element>
			<element ref="key_white" inputtag="kbd~n~" inputmask="0x010"><bounds x="~e~" y="447" width="26" height="170" /></element>
			<element ref="key_white" inputtag="kbd~n~" inputmask="0x020"><bounds x="~f~" y="447" width="26" height="170" /></element>
			<element ref="key_white" inputtag="kbd~n~" inputmask="0x080"><bounds x="~g~" y="447" width="26" height="170" /></element>
			<element ref="key_white" inputtag="kbd~n~" inputmask="0x200"><bounds x="~a~" y="447" width="26" height="170" /></element>
			<element ref="key_white" inputtag="kbd~n~" inputmask="0x800"><bounds x="~b~" y="447" width="26" height="170" /></element>

			<element ref="key_black" inputtag="kbd~n~" inputmask="0x002"><bounds x="~cs~" y="447" width="16" height="105" /></element>
			<element ref="key_black" inputtag="kbd~n~" inputmask="0x008"><bounds x="~ds~" y="447" width="16" height="105" /></element>
			<element ref="key_black" inputtag="kbd~n~" inputmask="0x040"><bounds x="~fs~" y="447" width="16" height="105" /></element>
			<element ref="key_black" inputtag="kbd~n~" inputmask="0x100"><bounds x="~gs~" y="447" width="16" height="105" /></element>
			<element ref="key_black" inputtag="kbd~n~" inputmask="0x400"><bounds x="~as~" y="447" width="16" height="105" /></element>
		</repeat>
		<element ref="key_white" inputtag="kbd5" inputmask="0x001"><bounds x="942" y="447" width="26" height="170" /></element>
		<element ref="wheel_body"><bounds x="-100" y="462" width="40" height="140" /></element>
		<element ref="wheel_face"><bounds x="-94" y="467" width="28" height="130" /></element>
		<element ref="wheel_center"><bounds x="-94" y="531" width="28" height="2" /></element>
		<element id="slider_pitch_wheel" ref="invisible_rect"><bounds x="-94" y="467" width="28" height="130" /></element>
		<element id="slider_knob_pitch_wheel" ref="wheel_knob">
			<animate inputtag="pitch" inputmask="0xffff" />
			<bounds state="100" x="-94" y="467" width="28" height="20" />
			<bounds state="0" x="-94" y="577" width="28" height="20" />
		</element>
		<element ref="wheel_body"><bounds x="-55" y="462" width="40" height="140" /></element>
		<element ref="wheel_face"><bounds x="-49" y="467" width="28" height="130" /></element>
		<element id="slider_mod_wheel" ref="invisible_rect"><bounds x="-49" y="467" width="28" height="130" /></element>
		<element id="slider_knob_mod_wheel" ref="wheel_knob">
			<animate inputtag="mod" inputmask="0xffff" />
			<bounds state="100" x="-49" y="467" width="28" height="20" />
			<bounds state="0" x="-49" y="577" width="28" height="20" />
		</element>
		<element ref="label_PITCH"><bounds x="-105" y="605" width="50" height="16" /></element>
		<element ref="label_MOD"><bounds x="-60" y="605" width="50" height="16" /></element>
	</view>


	<script><![CDATA[
		file:set_resolve_tags_callback(
			function()
				local mgr = slider_manager:new(file.views["Default Layout"])
				mgr:add_sprung_slider("slider_pitch_wheel", "slider_knob_pitch_wheel", "pitch")
				mgr:add_slider("slider_mod_wheel", "slider_knob_mod_wheel", "mod")
			end)

		-----------------------------------------------------------------------
		-- Slider and knob library starts.
		-- Can be copied as-is to other layouts.
		-- version: 13
		-----------------------------------------------------------------------

		-- Constants.
		VERTICAL = 0
		HORIZONTAL = 1

		-- slider_manager class.
		slider_manager = {}

		function slider_manager:new(view)
			local obj = {
				-- Configuration. Can be overwritten in the resolve_tags callback.
				KNOB_DOT_ANGLE_SPAN = 150,  -- -/+ 150 degrees from top center.
				UPDATE_CLICK_STATE = true,

				view = view,
				widgets = {},   -- Stores slider and knob information.
				pointers = {},  -- Tracks pointer state.
				frame_id = 0,   -- Current frame identifier.

				-- No setmetatable in the layout plugin. Manually copy methods.

				add_slider = self.add_slider,
				add_sprung_slider = self.add_sprung_slider,
				add_knob = self.add_knob,
				add_encoder = self.add_encoder,
				add_slider_internal = self.add_slider_internal,
				add_knob_internal = self.add_knob_internal,

				get_layout_item = self.get_layout_item,
				get_port_field = self.get_port_field,
				clamp = self.clamp,

				set_click_state = self.set_click_state,
				release_pointer = self.release_pointer,
				pointer_updated = self.pointer_updated,

				get_knob_dot_bounds = self.get_knob_dot_bounds,
				configure_knob_dots = self.configure_knob_dots,

				pointer_left = self.pointer_left,
				pointer_aborted = self.pointer_aborted,
				forget_pointers = self.forget_pointers,
				track_frame_id = self.track_frame_id }

			view:set_prepare_items_callback(
				function()
					obj:track_frame_id()
				end)

			view:set_recomputed_callback(
				function()
					obj:configure_knob_dots()
				end)

			view:set_pointer_updated_callback(
				function(type, id, dev, x, y, btn, dn, up, cnt)
					obj:pointer_updated(type, id, dev, x, y, btn, dn, up, cnt)
				end)

			view:set_pointer_left_callback(
				function(type, id, dev, x, y, up, cnt)
					obj:pointer_left(type, id, dev, x, y, up, cnt)
				end)

			view:set_pointer_aborted_callback(
				function(type, id, dev, x, y, up, cnt)
					obj:pointer_aborted(type, id, dev, x, y, up, cnt)
				end)

			view:set_forget_pointers_callback(
				function()
					obj:forget_pointers()
				end)

			return obj
		end

		-- The knob's Y position must be animated using <animate inputtag="{port_name}">.
		-- The click area's vertical size must exactly span the range of the
		-- knob's movement.
		function slider_manager:add_slider(clickarea_id, knob_id, port_name)
			local field = self:get_port_field(port_name)
			if not field or field.is_analog or field.analog_wraps then
				emu.print_error("Slider port '" .. port_name .. "' must be " ..
					"an IPT_ADJUSTER. It must not use PORT_WRAPS.")
				return
			end
			self:add_slider_internal(clickarea_id, knob_id, field)
		end

		-- A spring-loaded slider or wheel.
		-- See docs for `add_slider()`.
		function slider_manager:add_sprung_slider(clickarea_id, knob_id, port_name)
			local field = self:get_port_field(port_name)
			if not field or not field.is_analog or not field.centerdelta or field.centerdelta == 0 or field.analog_wraps then
				emu.print_error("Slider port '" .. port_name .. "' must be " ..
					"an analog port that auto-centers. It must not use PORT_WRAPS.")
				return
			end
			self:add_slider_internal(clickarea_id, knob_id, field)
		end

		-- A sweep between the attached field's min and max values requires
		-- moving the pointer by `scale * clickarea.height` pixels, when drag
		-- direction is VERTICAL. Replace `height` with `width` when HORIZONTAL.
		--
		-- `dot_id` is optional. If not nil, this script will take control of the
		-- element's position as the knob rotates. The distance of the dot from
		-- the center of `clickarea` will be preserved during rotation.
		-- It is suggested you place the dot at the top-center of the knob.
		function slider_manager:add_knob(clickarea_id, port_name, scale, drag_direction, dot_id)
			local field = self:get_port_field(port_name)
			if not field or field.is_analog or field.analog_wraps then
				emu.print_error("Knob port '" .. port_name .."' must be an " ..
					"IPT_ADJUSTER and must not use PORT_WRAPS.")
				return
			end
			self:add_knob_internal(clickarea_id, field, scale, drag_direction, dot_id)
		end

		-- See `add_knob()` for info on `scale` and `dot_id`.
		-- It is assumed a full turn of the encoder changes the port value by:
		-- (maxvalue - minvalue).
		function slider_manager:add_encoder(clickarea_id, port_name, scale, drag_direction, dot_id)
			local field = self:get_port_field(port_name)
			if not field or not field.analog_wraps then
				emu.print_error("Encoder port '" .. port_name .."' must either be " ..
					"an IPT_ADJUSTER or IPT_POSITIONAL[_V], and it must use PORT_WRAPS.")
				return
			end
			self:add_knob_internal(clickarea_id, field, scale, drag_direction, dot_id)
		end

		function slider_manager:add_slider_internal(clickarea_id, knob_id, field)
			table.insert(self.widgets, {
				clickarea   = self:get_layout_item(clickarea_id),
				slider_knob = self:get_layout_item(knob_id),
				field       = field,
				is_knob     = false })
		end

		function slider_manager:add_knob_internal(clickarea_id, field, scale, drag_direction, dot_id)
			table.insert(self.widgets, {
				clickarea     = self:get_layout_item(clickarea_id),
				field         = field,
				is_knob       = true,
				scale         = scale,
				is_horizontal = (drag_direction == HORIZONTAL),
				knob_dot      = dot_id and self:get_layout_item(dot_id) })
		end

		function slider_manager:get_layout_item(item_id)
			local item = self.view.items[item_id]
			if item == nil then
				emu.print_error("Layout element: '" .. item_id .. "' not found.")
			end
			return item
		end

		function slider_manager:get_port_field(port_name)
			local port = file.device:ioport(port_name)
			if port == nil then
				emu.print_error("Port: '" .. port_name .. "' not found.")
				return nil
			end
			local field = nil
			local num_fields = 0
			for k, val in pairs(port.fields) do
				field = val
				num_fields = num_fields + 1
			end
			if not field then
				emu.print_error("Port '" .. port_name .. "' does not contain a field.")
				return null
			end
			if num_fields > 1 then
				emu.print_error("Port '" .. port_name .. "' contains more than 1 field.")
				return nil
			end
			return field
		end

		function slider_manager:clamp(x, minval, maxval)
			if x < minval then
				return minval
			elseif x > maxval then
				return maxval
			else
				return x
			end
		end

		function slider_manager:set_click_state(widget, state)
			if self.UPDATE_CLICK_STATE then
				if widget.is_knob then
					widget.clickarea:set_state(state)
				else
					widget.slider_knob:set_state(state)
				end
			end
		end

		function slider_manager:release_pointer(pointer_id)
			if self.pointers[pointer_id] then
				local widget = self.widgets[self.pointers[pointer_id].selected_widget]
				self:set_click_state(widget, 0)
				local field = widget.field
				if field.is_analog and not field.analog_wraps then
					field:clear_value()
				end
			end
			self.pointers[pointer_id] = nil
		end

		function slider_manager:pointer_updated(type, id, dev, x, y, btn, dn, up, cnt)
			-- If a button is not pressed, reset the state of the current pointer.
			if btn & 1 == 0 then
				self:release_pointer(id)
				return
			end

			-- If a button was just pressed, find the affected widget, if any.
			if dn & 1 ~= 0 then
				for i = 1, #self.widgets do
					local found, relative
					if self.widgets[i].slider_knob and self.widgets[i].slider_knob.bounds:includes(x, y) then
						found = true
						relative = true
					elseif self.widgets[i].clickarea.bounds:includes(x, y) then
						found = true
						relative = false
					end
					if found then
						self:set_click_state(self.widgets[i], 1)
						local start_value = self.widgets[i].field.port:read()
						self.pointers[id] = {
							selected_widget = i,
							relative = relative,
							start_x = x,
							start_y = y,
							start_value = start_value,
							last_frame_value = start_value,
							last_frame_id = self.frame_id }
						break
					end
				end
			end

			-- If there is no widget selected by the current pointer, we are done.
			if self.pointers[id] == nil then
				return
			end

			-- A widget is selected. Update its state based on the pointer's position.

			local pointer = self.pointers[id]
			local widget = self.widgets[pointer.selected_widget]

			local min_value = widget.field.minvalue
			local max_value = widget.field.maxvalue
			local value_range = max_value - min_value

			local new_value
			if widget.is_knob then
				if widget.is_horizontal then
					local step_x = value_range / (widget.scale * widget.clickarea.bounds.width)
					new_value = pointer.start_value + (x - pointer.start_x) * step_x
				else
					local step_y = value_range / (widget.scale * widget.clickarea.bounds.height)
					new_value = pointer.start_value + (pointer.start_y - y) * step_y
				end

				-- Limit large changes for encoder inputs on a single frame, to ensure
				-- that the direction of change is not ambiguous to the driver.
				if widget.field.analog_wraps then
					-- If frame tracking was perfect, the limit could be (value_range / 2 - 1).
					-- But, occasionally, the frame boundary won't exactly match the change of
					-- frame_id. Using the max_delta below ensures there is no ambiguity even
					-- in those cases.
					local max_delta = (value_range / 2.0 - 1.0) / 2.0
					new_value = self:clamp(new_value, pointer.last_frame_value - max_delta, pointer.last_frame_value + max_delta)

					if self.frame_id ~= pointer.last_frame_id then
						pointer.last_frame_id = self.frame_id
						pointer.last_frame_value = new_value
					end
				end
			else
				local knob_half_height = widget.slider_knob.bounds.height / 2
				local min_y = widget.clickarea.bounds.y0 + knob_half_height
				local max_y = widget.clickarea.bounds.y1 - knob_half_height

				if pointer.relative then
					-- User clicked on the knob. The new value will depend on how
					--  much the knob was dragged.
					new_value = pointer.start_value - value_range * (y - pointer.start_y) / (max_y - min_y)
				else
					-- User clicked elsewhere on the slider. The new value will depend on
					-- the absolute position of the click.
					new_value = max_value - value_range * (y - min_y) / (max_y - min_y)
				end
			end

			new_value = math.floor(new_value + 0.5)
			if widget.field.analog_wraps then
				new_value = (new_value - min_value) % (value_range + 1) + min_value
			else
				new_value = self:clamp(new_value, min_value, max_value)
			end

			if widget.field.is_analog then
				widget.field:set_value(new_value)
			else
				widget.field.user_value = new_value
			end
		end

		-- Rotates the position of the knob indicator around the knob's center.
		-- This will only work well for circular indicators (dots), since the
		-- indicator itself is not being rotated.
		function slider_manager:get_knob_dot_bounds(widget)
			local dot = widget.knob_dot_cache
			local value = (widget.field.port:read() - dot.value_min) / dot.value_range
			local angle = dot.angle_min + value * dot.angle_range
			local rx = -dot.center_y * math.sin(angle) * dot.aspect
			local ry = dot.center_y * math.cos(angle)
			local x = rx + dot.dx
			local y = ry + dot.dy
			return emu.render_bounds(x, y, x + dot.width, y + dot.height)
		end

		function slider_manager:configure_knob_dots()
			for i = 1, #self.widgets do
				local dot = self.widgets[i].knob_dot
				if dot then
					-- Remove bounds callback, since we need to access the
					-- configured bounds.
					dot:set_bounds_callback(nil)

					local field = self.widgets[i].field
					local knob_bounds = self.widgets[i].clickarea.bounds
					local dot_bounds = dot.bounds

					local angle_max, angle_min
					if field.analog_wraps then
						angle_max = 2.0 * math.pi
						angle_min = 0
					else
						angle_max = self.KNOB_DOT_ANGLE_SPAN * 2.0 * math.pi / 360.0
						angle_min = -angle_max
					end

					-- Compute the distance of the knob dot from the knob center.
					local dot_x = dot_bounds.x0 + dot_bounds.width / 2.0
					local dot_y = dot_bounds.y0 + dot_bounds.height / 2.0
					local knob_x = knob_bounds.x0 + knob_bounds.width / 2.0
					local knob_y = knob_bounds.y0 + knob_bounds.height / 2.0
					local radius = math.sqrt((dot_y - knob_y) ^ 2 + (dot_x - knob_x) ^ 2)

					self.widgets[i].knob_dot_cache = {
						width       = dot_bounds.width,
						height      = dot_bounds.height,
						aspect      = dot_bounds.aspect,
						value_min   = field.minvalue,
						value_range = field.maxvalue - field.minvalue,
						angle_min   = angle_min,
						angle_range = angle_max - angle_min,
						center_y    = -radius,
						dx = knob_bounds.x0 + (knob_bounds.width - dot_bounds.width) / 2.0,
						dy = knob_bounds.y0 + (knob_bounds.height - dot_bounds.height) / 2.0 }

					dot:set_bounds_callback(
						function()
							return self:get_knob_dot_bounds(self.widgets[i])
						end)
				end
			end
		end

		function slider_manager:pointer_left(type, id, dev, x, y, up, cnt)
			self:release_pointer(id)
		end

		function slider_manager:pointer_aborted(type, id, dev, x, y, up, cnt)
			self:release_pointer(id)
		end

		function slider_manager:forget_pointers()
			for id, pointer in pairs(self.pointers) do
				self:release_pointer(id)
			end
			self.pointers = {}
		end

		function slider_manager:track_frame_id()
			self.frame_id = (self.frame_id + 1) % 1000000
			-- 1M is arbitrary. Just need to ensure the same frame ID does not
			-- repeat between a pointer press and release.
		end
		-----------------------------------------------------------------------
		-- Slider and knob library ends.
		-----------------------------------------------------------------------
	]]></script>
</mamelayout>
