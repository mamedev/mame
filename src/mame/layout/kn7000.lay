		<element ref="pm_wing_l" inputtag="cpanel:CPR_SEG4" inputmask="0x80"><!-- BANK VIEW (PANEL MEMORY BANK SELECT) --><bounds x="579.272" y="217.133" width="82.438" height="45.072"/></element>
		<element ref="pm_wing_r" inputtag="cpanel:CPR_SEG3" inputmask="0x80"><!-- NEXT BANK --><bounds x="667.236" y="217.133" width="82.438" height="45.072"/></element>
		<element ref="green_led" name="cpr_led12"><!-- BANK VIEW (PANEL MEMORY BANK SELECT) --><bounds x="586.075" y="216.628" width="7.0" height="7.0"/></element>
		<element ref="bank_view_text"><bounds x="557.454" y="204.013" width="92.791" height="10.31"/></element>
		<element ref="next_bank_text"><bounds x="670.125" y="206.909" width="92.791" height="10.31"/></element>
		<element ref="panel_memory_text"><bounds x="549.028" y="251.152" width="230.707" height="13.413"/></element>
		<element ref="pm_rim"><bounds x="566.554" y="263.081" width="195.838" height="195.838"/></element>
		<element ref="pm_hub"><bounds x="616.861" y="313.389" width="95.223" height="95.223"/></element>
		<element ref="pm_led1" name="cpr_led72"><!-- SOUND GROUP 1 (PANEL MEMORY 1) --><bounds x="608.575" y="364.047" width="21.735" height="33.702"/></element>
		<element ref="pm_btn1" inputtag="cpanel:CPR_SEG0" inputmask="0x02"><!-- SOUND GROUP 1 (PANEL MEMORY 1) --><bounds x="567.312" y="364.047" width="56.981" height="62.881"/></element>
		<element ref="1_2_text"><bounds x="562.027" y="397.956" width="8.386" height="8.386"/></element>
		<element ref="pm_led2" name="cpr_led6"><!-- SOUND GROUP 2 (PANEL MEMORY 2) --><bounds x="627.724" y="395.162" width="33.702" height="21.735"/></element>
		<element ref="pm_btn2" inputtag="cpanel:CPR_SEG6" inputmask="0x40"><!-- SOUND GROUP 2 (PANEL MEMORY 2) --><bounds x="598.545" y="401.179" width="62.881" height="56.982"/></element>
		<element ref="2_2_text"><bounds x="624.149" y="454.165" width="8.386" height="8.386"/></element>
		<element ref="pm_led3" name="cpr_led5"><!-- SOUND GROUP 3 (PANEL MEMORY 3) --><bounds x="667.519" y="395.16" width="33.704" height="21.737"/></element>
		<element ref="pm_btn3" inputtag="cpanel:CPR_SEG5" inputmask="0x40"><!-- SOUND GROUP 3 (PANEL MEMORY 3) --><bounds x="667.519" y="401.181" width="62.879" height="56.977"/></element>
		<element ref="3_2_text"><bounds x="703.152" y="453.972" width="8.386" height="8.386"/></element>
		<element ref="pm_led4" name="cpr_led4"><!-- SOUND GROUP 4 (PANEL MEMORY 4) --><bounds x="698.633" y="364.047" width="21.737" height="33.704"/></element>
		<element ref="pm_btn4" inputtag="cpanel:CPR_SEG4" inputmask="0x40"><!-- SOUND GROUP 4 (PANEL MEMORY 4) --><bounds x="704.654" y="364.047" width="56.977" height="62.879"/></element>
		<element ref="4_2_text"><bounds x="758.545" y="400.082" width="8.386" height="8.386"/></element>
		<element ref="pm_led5" name="cpr_led3"><!-- SOUND GROUP 5 (PANEL MEMORY 5) --><bounds x="698.635" y="324.251" width="21.735" height="33.702"/></element>
		<element ref="pm_btn5" inputtag="cpanel:CPR_SEG3" inputmask="0x40"><!-- SOUND GROUP 5 (PANEL MEMORY 5) --><bounds x="704.654" y="295.075" width="56.979" height="62.879"/></element>
		<element ref="5_2_text"><bounds x="758.579" y="320.121" width="8.386" height="8.386"/></element>
		<element ref="pm_led6" name="cpr_led13"><!-- SOUND GROUP 6 (PANEL MEMORY 6) --><bounds x="667.519" y="305.103" width="33.702" height="21.735"/></element>
		<element ref="pm_btn6" inputtag="cpanel:CPR_SEG5" inputmask="0x80"><!-- SOUND GROUP 6 (PANEL MEMORY 6) --><bounds x="667.519" y="263.839" width="62.881" height="56.982"/></element>
		<element ref="6_2_text"><bounds x="714.125" y="270.326" width="8.386" height="8.386"/></element>
		<element ref="pm_led7" name="cpr_led14"><!-- SOUND GROUP 7 (PANEL MEMORY 7) --><bounds x="627.722" y="305.103" width="33.704" height="21.737"/></element>
		<element ref="pm_btn7" inputtag="cpanel:CPR_SEG6" inputmask="0x80"><!-- SOUND GROUP 7 (PANEL MEMORY 7) --><bounds x="598.547" y="263.842" width="62.879" height="56.977"/></element>
		<element ref="7_text"><bounds x="601.146" y="268.978" width="8.386" height="8.386"/></element>
		<element ref="pm_led8" name="cpr_led15"><!-- SOUND GROUP 8 (PANEL MEMORY 8) --><bounds x="608.575" y="324.249" width="21.737" height="33.704"/></element>
		<element ref="pm_btn8" inputtag="cpanel:CPR_SEG7" inputmask="0x80"><!-- SOUND GROUP 8 (PANEL MEMORY 8) --><bounds x="567.314" y="295.075" width="56.977" height="62.879"/></element>
		<element ref="8_text"><bounds x="559.066" y="317.339" width="8.386" height="8.386"/></element>
		<element ref="pm_set" inputtag="cpanel:CPR_SEG7" inputmask="0x40"><!-- SOUND SET (PANEL MEMORY SET) --><bounds x="639.224" y="335.752" width="50.497" height="50.497"/></element>
		<element ref="set_2_text"><bounds x="640.168" y="357.891" width="48.609" height="13.257"/></element>
		<element id="tempo_finger" ref="tempo_finger"><bounds x="93.3" y="370.6" width="32" height="32"/></element>
	</group>

	<group name="sd_block">
		<bounds x="0" y="0" width="500" height="80"/>
		<element ref="sd_bg"><bounds x="2" y="2" width="496" height="76"/></element>

		<element ref="minus_2_text"><bounds x="26" y="10" width="12" height="12"/></element>
		<element ref="plus_2_text"><bounds x="66" y="10" width="12" height="12"/></element>
