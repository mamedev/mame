		<repeat count="3">
			<param name="seg" start="8" increment="1"/>
			<param name="x0" start="543.5" increment="321.6"/>
			<repeat count="4">
				<param name="x" start="~x0~" increment="80.4"/>
				<param name="on" start="0x01" lshift="2"/>
				<param name="off" start="0x02" lshift="2"/>
				<element ref="mute_btn" inputtag="cpanel:CPC_SEG~seg~" inputmask="~on~"><bounds x="~x~" y="756" width="46" height="77"/></element>
				<element ref="mute_btn" inputtag="cpanel:CPC_SEG~seg~" inputmask="~off~"><bounds x="~x~" y="833" width="46" height="78"/></element>
			</repeat>
		</repeat>
