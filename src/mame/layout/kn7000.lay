		<element ref="stop_2_text"><bounds x="272" y="60" width="52" height="10"/></element>

		<element ref="sd_btn" inputtag="CPSD_SDSW" inputmask="0x08"><bounds x="350" y="28" width="46" height="28"/></element>
		<element ref="sd_ic_play"><bounds x="361" y="10" width="24" height="14"/></element>
		<element ref="green_led" name="sd_led1"><bounds x="351" y="12" width="8" height="8"/></element>
		<element ref="play_pause_text"><bounds x="335" y="60" width="76" height="10"/></element>

		<element ref="sd_in_use_text"><bounds x="406" y="11" width="72" height="9"/></element>
