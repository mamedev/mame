<?xml version="1.0"?>
<!--
license:CC0
-->

<mamelayout version="2">

	<element name="mode_text"><text string="MODE"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="roll_text"><text string="ROLL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="menu_text"><text string="MENU"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="submenu_text"><text string="SUB MENU"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="decno_text"><text string="DEC/NO"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="incyes_text"><text string="INC/YES"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="command_text"><text string="COMMAND"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="execute_text"><text string="EXECUTE"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<!-- Interactive elements -->

	<element name="rect_led" defstate="0">
		<rect state="0">
			<color red="0" green="0" blue="0" />
		</rect>
		<rect state="1">
			<color red="1" green="0.2" blue="0.2" />
		</rect>
		<rect state="2">
			<color red="0.2" green="1" blue="0.2" />
		</rect>
	</element>

	<element name="wide_button">
		<rect><bounds x="0" y="0" width="145" height="44"/><color red="0" green="0" blue="0" /></rect>
		<rect><bounds x="2" y="4" width="141" height="36"/><color red="0.05" green="0.05" blue="0.05" /></rect>
		<rect>
			<bounds x="10" y="4" width="125" height="36"/>
			<color state="0" red="0.1" green="0.1" blue="0.1"/>
			<color state="1" red="0.3" green="0.3" blue="0.3"/>
		</rect>
	</element>

	<!-- Style elements -->

	<element name="arrow_up">
		<image>
			<data><![CDATA[<svg width="20" height="25" viewBox="0 0 20 25"><path fill="#ccc" d="M 0,25 L 20,25 L 10,0 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="arrow_down">
		<image>
			<data><![CDATA[<svg width="20" height="25" viewBox="0 0 20 25"><path fill="#ccc" d="M 0,0 L 20,0 L 10,25 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="arrow_left">
		<image>
			<data><![CDATA[<svg width="25" height="20" viewBox="0 0 25 20"><path fill="#ccc" d="M 25,0 L 25,20 L 0,10 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="arrow_right">
		<image>
			<data><![CDATA[<svg width="25" height="20" viewBox="0 0 25 20"><path fill="#ccc" d="M 0,0 L 0,20 L 25,10 Z" /></svg>]]></data>
		</image>
	</element>

	<element name="panel_background">
		<rect><bounds x="0" y="0" width="10" height="10"/><color red="0.1" green="0.1" blue="0.1" /></rect>
	</element>

	<element name="btn_well">
		<rect><bounds x="0" y="0" width="145" height="44"/><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="bezel">
		<rect><bounds x="0" y="0" width="747" height="285"/><color red="0" green="0" blue="0" /></rect>
		<rect><bounds x="56.5" y="68.5" width="634" height="148"/><color red="0.345" green="0.969" blue="0" /></rect>
	</element>

	<group name="s330_focus">
		<bounds x="0" y="0" width="1875" height="436"/>
		<element ref="panel_background">
			<bounds x="0" y="0" width="1875" height="436"/>
		</element>

		<!-- LCD panel -->
		<element ref="bezel">
			<bounds x="40" y="108" width="750" height="245"/>
		</element>
		<screen index="0">
			<bounds x="98" y="177.5" width="634" height="106" />
		</screen>

		<element ref="btn_well"><bounds x="844" y="158" width="292" height="44"/></element>
		<!-- MODE -->
		<element ref="mode_text"><bounds x="844" y="125" width="145" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW0" inputmask="0x01"><bounds x="844" y="158" width="145" height="44"/></element>
		<element name="LED6" ref="rect_led"><bounds x="902" y="161" width="22" height="7" /></element>
		<!-- MENU -->
		<element ref="menu_text"><bounds x="991" y="125" width="145" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW0" inputmask="0x02"><bounds x="991" y="158" width="145" height="44"/></element>
		<element name="LED4" ref="rect_led"><bounds x="1053" y="161" width="22" height="7" /></element>

		<element ref="btn_well"><bounds x="844" y="309" width="292" height="44"/></element>
		<!-- ROLL -->
		<element ref="roll_text"><bounds x="844" y="276" width="145" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW1" inputmask="0x01"><bounds x="844" y="309" width="145" height="44"/></element>
		<element name="LED5" ref="rect_led"><bounds x="902" y="312" width="22" height="7" /></element>
		<!-- SUB MENU -->
		<element ref="submenu_text"><bounds x="991" y="276" width="145" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW1" inputmask="0x02"><bounds x="991" y="309" width="145" height="44"/></element>
		<element name="LED3" ref="rect_led"><bounds x="1053" y="312" width="22" height="7" /></element>

		<element ref="btn_well"><bounds x="1181" y="158" width="441" height="44"/></element>
		<!-- DEC/NO -->
		<element ref="decno_text"><bounds x="1181" y="125" width="145" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW0" inputmask="0x04"><bounds x="1181" y="158" width="145" height="44"/></element>
		<!-- up -->
		<element ref="arrow_up"><bounds x="1392" y="125" width="20" height="25"/></element>
		<element ref="wide_button" inputtag="KEYSW0" inputmask="0x08"><bounds x="1329" y="158" width="145" height="44"/></element>
		<!-- INC/YES -->
		<element ref="incyes_text"><bounds x="1481" y="125" width="141" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW0" inputmask="0x10"><bounds x="1477" y="158" width="145" height="44"/></element>

		<element ref="btn_well"><bounds x="1181" y="309" width="441" height="44"/></element>
		<!-- left -->
		<element ref="arrow_left"><bounds x="1241.5" y="278.5" width="25" height="20"/></element>
		<element ref="wide_button" inputtag="KEYSW1" inputmask="0x04"><bounds x="1181" y="309" width="145" height="44"/></element>
		<!-- down -->
		<element ref="arrow_down"><bounds x="1392" y="276" width="20" height="25"/></element>
		<element ref="wide_button" inputtag="KEYSW1" inputmask="0x08"><bounds x="1329" y="309" width="145" height="44"/></element>
		<!-- right -->
		<element ref="arrow_right"><bounds x="1537.5" y="278.5" width="25" height="20"/></element>
		<element ref="wide_button" inputtag="KEYSW1" inputmask="0x10"><bounds x="1477" y="309" width="145" height="44"/></element>

		<!-- COMMAND -->
		<element ref="command_text"><bounds x="1664" y="125" width="155" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW0" inputmask="0x20"><bounds x="1669" y="158" width="145" height="44"/></element>
		<element name="LED2" ref="rect_led"><bounds x="1731" y="161" width="22" height="7" /></element>
		<!-- EXECUTE -->
		<element ref="execute_text"><bounds x="1669" y="276" width="141" height="25" /></element>
		<element ref="wide_button" inputtag="KEYSW1" inputmask="0x20"><bounds x="1669" y="309" width="145" height="44"/></element>
		<element name="LED1" ref="rect_led"><bounds x="1731" y="312" width="22" height="7" /></element>
	</group>

	<view name="CRT + panel">
		<!-- CRT screen -->
		<screen index="1">
			<bounds x="0" y="0" width="336" height="252" />
		</screen>
		<!-- front panel (focus view) -->
		<group ref="s330_focus">
			<bounds x="0" y="252" width="336" height="78" />
		</group>
	</view>

	<view name="CRT + LCD">
		<!-- CRT screen -->
		<screen index="1">
			<bounds x="0" y="0" width="336" height="252" />
		</screen>
		<!-- LCD screen -->
		<screen index="0">
			<bounds x="0" y="252" width="336" height="56" />
		</screen>
	</view>
</mamelayout>