		<screen index="0"><bounds x="0" y="0" width="768" height="576" /></screen>

		<param name="tag" value="STROBE0" /><param name="label_y" value="0" /><param name="label_height" value="1" />
		<param name="id" value="answer_left_a" /><param name="lamp" value="0" /><param name="mask" value="0x01" /><param name="label" value="a" /><param name="colour" value="red" /><param name="red" value="0.72" /><param name="green" value="0.35" /><param name="blue" value="0.35" />
		<group ref="button"><bounds x="-105" y="128" width="72" height="72" /></group>
