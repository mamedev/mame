		<group ref="button"><bounds x="-105" y="236" width="72" height="72" /></group>
		<param name="id" value="answer_left_c" /><param name="lamp" value="2" /><param name="mask" value="0x04" /><param name="label" value="c" /><param name="colour" value="green" /><param name="red" value="0.35" /><param name="green" value="0.72" /><param name="blue" value="0.40" />
		<group ref="button"><bounds x="-105" y="344" width="72" height="72" /></group>

		<param name="id" value="answer_right_a" /><param name="lamp" value="9" /><param name="tag" value="STROBE1" /><param name="mask" value="0x02" /><param name="label" value="a" /><param name="colour" value="red" /><param name="red" value="0.72" /><param name="green" value="0.35" /><param name="blue" value="0.35" />
		<group ref="button"><bounds x="801" y="128" width="72" height="72" /></group>
		<param name="id" value="answer_right_b" /><param name="lamp" value="8" /><param name="mask" value="0x01" /><param name="label" value="b" /><param name="colour" value="blue" /><param name="red" value="0.35" /><param name="green" value="0.48" /><param name="blue" value="0.75" />
		<group ref="button"><bounds x="801" y="236" width="72" height="72" /></group>
		<param name="id" value="answer_right_c" /><param name="lamp" value="7" /><param name="tag" value="STROBE0" /><param name="mask" value="0x80" /><param name="label" value="c" /><param name="colour" value="green" /><param name="red" value="0.35" /><param name="green" value="0.72" /><param name="blue" value="0.40" />
		<group ref="button"><bounds x="801" y="344" width="72" height="72" /></group>

		<param name="id" value="spin" /><param name="lamp" value="6" /><param name="mask" value="0x40" /><param name="label" value="spin" /><param name="colour" value="yellow" /><param name="red" value="0.72" /><param name="green" value="0.63" /><param name="blue" value="0.35" /><param name="label_y" value="0.37" /><param name="label_height" value="0.26" />
