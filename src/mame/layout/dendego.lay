<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:hap

16:9 layout. Game 4:3 at full height, all original lamp outputs preserved.
Speed 0-120 km/h, numbers every 20. Red lamp5/lamp6 above speedometer.
White dial faces and black needles. Small decorative voltmeter fixed at 1.5 kV.
Pressure 0-15 kg/cm2 in mandatory 0.1 units; BOTH digital meters removed.
REQUIRES accompanying modified src/mame/taito/taitojc.cpp
and rebuilding MAME. No Lua or layout plugin needed. Do not install this
layout alone in an unpatched MAME: its pressure output will be absent.
Native pressure output: dendego_pressure_tenths (0..160), capped at 150
for drawing only. Original counter4/counter5 outputs and views retained.
Select Widescreen 16:9 Analog (Japanese/English) in Video Options.
-->
<mamelayout version="2">
	<element name="black">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>
	<element name="darkgray">
		<rect>
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
	</element>
	<element name="lightgray">
		<rect>
			<color red="0.6" green="0.6" blue="0.6" />
		</rect>
	</element>
	<element name="yellow">
		<rect>
			<color red="0.8" green="0.8" blue="0.1" />
		</rect>
	</element>
	<element name="blue">
		<rect>
			<color red="0.2" green="0.5" blue="0.8" />
		</rect>
	</element>
	<element name="text_throttle">
		<text string="THROTTLE:" align="1">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="text_throttle_j">
		<text string="マスコン:" align="1">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="text_dot">
		<text string="." align="0">
			<color red="1.0" green="1.0" blue="0.0" />
		</text>
	</element>
	<element name="text_speed">
		<text string="km/h" align="1">
			<color red="1.0" green="1.0" blue="0.0" />
		</text>
	</element>
	<element name="counter_throttle" defstate="0">
		<simplecounter maxstate="9" digits="1" align="1">
			<color red="1.0" green="1.0" blue="1.0" />
		</simplecounter>
	</element>
	<element name="counter_speed1" defstate="0">
		<simplecounter maxstate="999" digits="3" align="2">
			<color red="1.0" green="1.0" blue="0.0" />
		</simplecounter>
	</element>
	<element name="counter_speed2" defstate="0">
		<simplecounter maxstate="9" digits="1" align="1">
			<color red="1.0" green="1.0" blue="0.0" />
		</simplecounter>
	</element>
	<element name="text_brake">
		<text string="BRAKE:" align="1">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="text_brake_j">
		<text string="ブレーキ:" align="1">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="text_pressure">
		<text string="kg/cm²" align="1">
			<color red="1.0" green="1.0" blue="0.0" />
		</text>
	</element>
	<element name="counter_brake" defstate="0">
		<simplecounter maxstate="99" digits="1" align="1">
			<color red="1.0" green="1.0" blue="1.0" />
		</simplecounter>
	</element>
	<element name="counter_pressure1" defstate="0">
		<simplecounter maxstate="99" digits="2" align="2">
			<color red="1.0" green="1.0" blue="0.0" />
		</simplecounter>
	</element>
	<element name="counter_pressure2" defstate="0">
		<simplecounter maxstate="9" digits="1" align="1">
			<color red="1.0" green="1.0" blue="0.0" />
		</simplecounter>
	</element>
	<element name="lamp_white" defstate="0">
		<rect state="1">
			<color red="1.0" green="0.85" blue="0.65" />
		</rect>
		<rect state="0">
			<color red="0.2" green="0.2" blue="0.2" />
		</rect>
