<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:hap

16:9 analog dashboard; game screen remains 4:3 at full height.
White SVG dials, black SVG needles and all original lamp outputs.
Speed: counter2 in km/h, 0-120 scale (output range 0-130).
Pressure: dendego_pressure_tenths in 0.1 kg/cm2, 0-15 scale
(output range 0-160). Needles stop at the end of their scales.
Voltage: decorative 0-2 kV dial, always pointing at 1.5 kV.

SVG data is embedded so the internal layout needs no external artwork.
MAME's layout orientation only supports 90-degree steps; each output
state therefore selects a small SVG with an explicit rotation angle.
Dial labels use layout text because NanoSVG does not render SVG text.
The separate hub is shared by all three meters.

Only the Japanese and English analog views are provided. The original
Internal Layout views and their unused digital meter elements are removed.
Throttle/brake position counters are retained in the analog views.
-->
<mamelayout version="2">

	<element name="counter_throttle" defstate="0">
		<simplecounter maxstate="9" digits="1" align="1">
			<color red="1.0" green="1.0" blue="1.0" />
		</simplecounter>
	</element>

	<element name="counter_brake" defstate="0">
		<simplecounter maxstate="99" digits="1" align="1">
			<color red="1.0" green="1.0" blue="1.0" />
		</simplecounter>
	</element>

	<element name="lamp_white" defstate="0">
		<rect state="1">
			<color red="1.0" green="0.85" blue="0.65" />
		</rect>
		<rect state="0">
			<color red="0.2" green="0.2" blue="0.2" />
		</rect>
	</element>

	<element name="lamp_red" defstate="0">
		<rect state="1">
			<color red="1.0" green="0.1" blue="0.1" />
		</rect>
		<rect state="0">
			<color red="0.3" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="text_pwr">
		<text string="PWR">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_ok">
		<text string="OK">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_eme">
		<text string="EME">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_door">
		<text string="doors">
			<color red="0.9" green="0.1" blue="0.1" />
		</text>
	</element>

	<element name="text_pwr_j">
		<text string="三相">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_ok_j">
		<text string="常用">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_eme_j">
		<text string="非常">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_door_j">
		<text string="車内信号">
			<color red="0.9" green="0.1" blue="0.1" />
		</text>
	</element>

	<element name="text_1">
		<text string="1">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_2">
		<text string="2">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="text_3">
		<text string="3">
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
	</element>

	<element name="lamp_door" defstate="0">
		<disk state="1">
			<color red="1.0" green="0.85" blue="0.65" />
		</disk>
		<disk state="0">
			<color red="0.2" green="0.2" blue="0.2" />
		</disk>
	</element>

	<element name="lamp_start" defstate="0">
		<disk state="1">
			<color red="1.0" green="1.0" blue="0.3" />
		</disk>
		<disk state="0">
			<color red="0.2" green="0.2" blue="0.0" />
		</disk>
	</element>

	<element name="lamp_redd" defstate="0">
		<disk>
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<disk state="1">
			<color red="1.0" green="0.1" blue="0.1" />
			<bounds x="0.1" y="0.1" width="0.79" height="0.79" />
		</disk>
		<disk state="0">
			<color red="0.4" green="0.04" blue="0.04" />
			<bounds x="0.1" y="0.1" width="0.79" height="0.79" />
		</disk>
	</element>

	<element name="analog_panel">
		<rect>
			<color red="0.085" green="0.105" blue="0.105" alpha="1" />
		</rect>
	</element>

