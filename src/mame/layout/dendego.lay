	<script><![CDATA[
		local function needle(name, scale, maximum)
			file.elements[name]:set_draw_callback(function (state, bitmap)
				local angle = math.rad(135 + 270 * math.min(state, maximum or state) / scale)
				local dx, dy = math.cos(angle), math.sin(angle)
				local w, h = bitmap.width, bitmap.height
				local edge = 50 / math.min(w, h)
				local radius = 0.6 + edge
				local x0, y0 = 50 - 5 * dx, 50 - 5 * dy
				local x1, y1 = 50 + 40 * dx, 50 + 40 * dy
				local left = math.max(0, math.floor((math.min(x0, x1) - radius) * w / 100))
				local right = math.min(w - 1, math.ceil((math.max(x0, x1) + radius) * w / 100))
				local top = math.max(0, math.floor((math.min(y0, y1) - radius) * h / 100))
				local bottom = math.min(h - 1, math.ceil((math.max(y0, y1) + radius) * h / 100))
				for y = top, bottom do
					for x = left, right do
						local px, py = (x + 0.5) * 100 / w - 50, (y + 0.5) * 100 / h - 50
						local along = px * dx + py * dy
						local across = px * dy - py * dx
						local cap = math.max(-5 - along, 0, along - 40)
						local distance = math.sqrt(across * across + cap * cap)
						local alpha = math.floor(255 * math.min(1, math.max(0, (radius - distance) / (2 * edge))))
						if alpha > 0 then bitmap:plot(x, y, alpha << 24) end
					end
				end
			end)
		end
		needle('analog_speed_needle', 1200, 1200)
		needle('analog_pressure_needle', 1500)
	]]></script>
