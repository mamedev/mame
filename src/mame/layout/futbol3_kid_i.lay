<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders: Tomás García-Merás Capote (ClawGrip)
Gaelco kiddie rides, later PCB: lamps, motor and gift motor
-->
<mamelayout version="2">

	<element name="background">
		<rect><color red="0.06" green="0.06" blue="0.07" /></rect>
	</element>

	<element name="lamp" defstate="0">
		<disk state="0"><color red="0.2" green="0.2" blue="0.2" /></disk>
		<disk state="1"><color red="1.0" green="1.0" blue="1.0" /></disk>
	</element>

	<element name="text_lamps"><text string="LAMPS 1-4"><color red="0.7" green="0.7" blue="0.7" /></text></element>
	<element name="text_gift"><text string="GIFT MOTOR"><color red="0.7" green="0.7" blue="0.7" /></text></element>
	<element name="text_motor"><text string="MOTOR"><color red="0.7" green="0.7" blue="0.7" /></text></element>

	<view name="Outputs">
		<bounds x="0" y="0" width="280" height="210" />
		<element ref="background"><bounds x="0" y="0" width="280" height="210" /></element>

		<repeat count="4">
			<param name="i" start="0" increment="1" />
			<param name="x" start="32" increment="60" />
			<element name="lamp~i~" ref="lamp"><bounds x="~x~" y="30" width="36" height="36" /><color red="1.0" green="0.82" blue="0.15" /></element>
		</repeat>
		<element ref="text_lamps"><bounds x="90" y="76" width="100" height="12" /></element>

		<element name="gift_motor" ref="lamp"><bounds x="72" y="120" width="36" height="36" /><color red="0.15" green="1.0" blue="0.25" /></element>
		<element ref="text_gift"><bounds x="45" y="166" width="90" height="12" /></element>

		<element name="motor" ref="lamp"><bounds x="172" y="120" width="36" height="36" /><color red="0.15" green="1.0" blue="0.25" /></element>
		<element ref="text_motor"><bounds x="160" y="166" width="60" height="12" /></element>
	</view>

</mamelayout>
