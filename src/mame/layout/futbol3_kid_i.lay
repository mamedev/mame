-->
<mamelayout version="2">

	<element name="background">
		<rect><color red="0.06" green="0.06" blue="0.07" /></rect>
	</element>

	<element name="lamp" defstate="0">
		<disk state="0"><color red="0.22" green="0.17" blue="0.03" /></disk>
		<disk state="1"><color red="1.0" green="0.82" blue="0.15" /></disk>
	</element>

	<element name="motor" defstate="0">
		<disk state="0"><color red="0.04" green="0.18" blue="0.05" /></disk>
		<disk state="1"><color red="0.15" green="1.0" blue="0.25" /></disk>
	</element>

	<element name="text_lamps"><text string="LAMPS 1-4"><color red="0.7" green="0.7" blue="0.7" /></text></element>
	<element name="text_lamp5"><text string="LAMP 5"><color red="0.7" green="0.7" blue="0.7" /></text></element>
	<element name="text_motor"><text string="MOTOR"><color red="0.7" green="0.7" blue="0.7" /></text></element>

	<view name="Outputs">
		<bounds x="0" y="0" width="280" height="210" />
		<element ref="background"><bounds x="0" y="0" width="280" height="210" /></element>

		<element name="lamp0" ref="lamp"><bounds x="32" y="30" width="36" height="36" /></element>
		<element name="lamp1" ref="lamp"><bounds x="92" y="30" width="36" height="36" /></element>
		<element name="lamp2" ref="lamp"><bounds x="152" y="30" width="36" height="36" /></element>
		<element name="lamp3" ref="lamp"><bounds x="212" y="30" width="36" height="36" /></element>
		<element ref="text_lamps"><bounds x="90" y="76" width="100" height="12" /></element>

		<element name="lamp4" ref="lamp"><bounds x="72" y="120" width="36" height="36" /></element>
		<element ref="text_lamp5"><bounds x="60" y="166" width="60" height="12" /></element>

		<element name="motor" ref="motor"><bounds x="172" y="120" width="36" height="36" /></element>
		<element ref="text_motor"><bounds x="160" y="166" width="60" height="12" /></element>
	</view>

</mamelayout>
