		<text string=" plum ">     <bounds x="0" y="266.66" width="100" height="19.04"/> <color red="0.0" green="0.0" blue="1.0"/> </text>
		<text string=" SEVEN ">    <bounds x="0" y="285.71" width="100" height="19.04"/> <color red="1.0" green="0.0" blue="0.0"/> </text>
		<text string=" bell ">     <bounds x="0" y="304.76" width="100" height="19.04"/> <color red="0.8" green="0.8" blue="0.0"/> </text>
		<text string=" orange ">   <bounds x="0" y="323.80" width="100" height="19.04"/> <color red="1.0" green="0.6" blue="0.0"/> </text>
		<text string=" wing-b ">   <bounds x="0" y="342.85" width="100" height="19.04"/> <color red="0.3" green="0.7" blue="0.5"/> </text>
		<text string=" plum ">     <bounds x="0" y="361.90" width="100" height="19.04"/> <color red="0.0" green="0.0" blue="1.0"/> </text>
		<text string=" bell ">     <bounds x="0" y="380.95" width="100" height="19.04"/> <color red="0.8" green="0.8" blue="0.0"/> </text>
	</element>

<!-- View field -->

	<view name="AWP Simulated Video" showpointers="no">

	<!-- Screen size -->

		<element ref="screen_background_color">
			<bounds x="0" y="0" width="640" height="480"/>
		</element>

	<!-- Frame lamps -->

		<element name="lamp_frame0" ref="LFRAME0">
			<bounds x="0" y="0" width="106" height="40"/>
		</element>
		<element name="lamp_frame1" ref="LFRAME1">
			<bounds x="106" y="0" width="107" height="40"/>
		</element>
		<element name="lamp_frame2" ref="LFRAME2">
			<bounds x="213" y="0" width="107" height="40"/>
		</element>
		<element name="lamp_frame3" ref="LFRAME3">
			<bounds x="320" y="0" width="107" height="40"/>
		</element>
		<element name="lamp_frame4" ref="LFRAME4">
			<bounds x="427" y="0" width="107" height="40"/>
		</element>
		<element name="lamp_frame5" ref="LFRAME5">
			<bounds x="534" y="0" width="106" height="40"/>
		</element>

	<!-- Bonus game count "SEVEN" lamp -->

		<element name="lamp_7770" ref="L7770">
			<bounds x="155" y="55" width="65" height="65"/>
		</element>
		<element name="lamp_7771" ref="L7771">
			<bounds x="220" y="55" width="65" height="65"/>
		</element>
		<element name="lamp_7772" ref="L7772">
			<bounds x="285" y="55" width="65" height="65"/>
		</element>
		<element name="lamp_7773" ref="L7773">
			<bounds x="350" y="55" width="65" height="65"/>
		</element>
		<element name="lamp_7774" ref="L7774">
			<bounds x="415" y="55" width="65" height="65"/>
		</element>

	<!-- Betline lamps -->

		<element name="lamp_betline3" ref="LBETLINE3">
			<bounds x="20" y="110" width="80" height="40"/>
		</element>
		<element name="lamp_betline1" ref="LBETLINE1">
			<bounds x="20" y="160" width="80" height="40"/>
		</element>
		<element name="lamp_betline0" ref="LBETLINE0">
			<bounds x="20" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_betline2" ref="LBETLINE2">
			<bounds x="20" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_betline4" ref="LBETLINE4">
			<bounds x="20" y="310" width="80" height="40"/>
		</element>

	<!-- Stop lamp -->

		<element name="lamp_stop0" ref="LSTOP0">
			<bounds x="150" y="340" width="60" height="40"/>
		</element>
		<element name="lamp_stop1" ref="LSTOP1">
			<bounds x="290" y="340" width="60" height="40"/>
		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="430" y="340" width="60" height="40"/>
		</element>

	<!-- Pause lamp -->

		<element name="lamp_pause" ref="LPAUSE">
			<bounds x="540" y="290" width="80" height="40"/>
		</element>

	<!-- Credit lamp -->

		<element name="lamp_credit" ref="LCREDIT">
			<bounds x="20" y="380" width="80" height="40"/>
		</element>

	<!-- Credit SEG -->

		<element name="seg_credit0" ref="digit">
			<bounds x="560" y="165" width="20" height="30"/>
		</element>
		<element name="seg_credit1" ref="digit">
			<bounds x="580" y="165" width="20" height="30"/>
		</element>

	<!-- Payout SEG -->

		<element name="seg_payout0" ref="digit">
			<bounds x="560" y="235" width="20" height="30"/>
		</element>
		<element name="seg_payout1" ref="digit">
			<bounds x="580" y="235" width="20" height="30"/>
		</element>

	<!-- Text -->

		<element ref="TCREDITMETER">
			<bounds x="540" y="140" width="80" height="18"/>
		</element>
		<element ref="TWINMETER">
			<bounds x="540" y="210" width="80" height="18"/>
		</element>

	<!-- Game reels -->

		<repeat count="3">

			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>

		<!-- Reel backlight -->

			<element name="light_reel~i~" ref="LREEL">
				<bounds x="~x~" y="140" width="120" height="180"/>
			</element>

		<!-- Reel pattern -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Hopper & Coin solenoid -->

		<element name="signal_hopper" ref="SIGNALHOPPER">
			<bounds x="490" y="60" width="60" height="25"/>
		</element>
		<element name="signal_solenoid" ref="SIGNALSOLENOID">
			<bounds x="560" y="60" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="20" y="60" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="90" y="60" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
