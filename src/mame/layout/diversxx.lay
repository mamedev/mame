		</element>

	<!-- Reel -->

		<repeat count="3">

			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>

		<!-- Reel backlight -->

			<element ref="LREEL">
				<bounds x="~x~" y="140" width="120" height="180"/>
			</element>

		<!-- Reel pattern -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Knocker solenoid -->

		<element name="signal_knocker" ref="SIGNALKNOCKER">
			<bounds x="550" y="270" width="60" height="15"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="550" y="120" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="550" y="155" width="60" height="25"/>
