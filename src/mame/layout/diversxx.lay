	<!-- Machine status text -->

		<element ref="TEXT_MACHINESTATUS0">
			<bounds x="32" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_MACHINESTATUS1">
			<bounds x="62" y="66" width="24" height="10"/>
