	<!-- Bonus counter text -->

		<element ref="TEXT_BONUSCOUNT0">
			<bounds x="142" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT1">
			<bounds x="172" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT2">
			<bounds x="202" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT3">
			<bounds x="232" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT4">
			<bounds x="262" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT5">
			<bounds x="292" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT6">
			<bounds x="322" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT7">
			<bounds x="352" y="66" width="24" height="10"/>
		</element>
		<element ref="TEXT_BONUSCOUNT8">
			<bounds x="382" y="66" width="24" height="10"/>
