			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- Stop lamp -->

	<element name="LSTOP0" defstate="0">
		<rect state="0">
			<color red="0.2" green="0.2" blue="0.2"/>
		</rect>
		<rect state="1">
			<color red="0.8" green="0.2" blue="0.2"/>
		</rect>
		<text string=" STOP ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="LSTOP1" defstate="0">
		<rect state="0">
			<color red="0.2" green="0.2" blue="0.2"/>
		</rect>
		<rect state="1">
			<color red="0.8" green="0.2" blue="0.2"/>
