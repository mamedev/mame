<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.2" blue="0.2" />
		</led7seg>
	</element>

<!-- Frame lamps -->

	<element name="LFRAME0" defstate="0">
		<rect state="0">
			<color red="0.2" green="0.1" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.1" blue="0.1"/>
		</rect>
	</element>
	<element name="LFRAME1" defstate="0">
		<rect state="0">
			<color red="0.2" green="0.2" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="1.0" blue="0.1"/>
		</rect>
	</element>
	<element name="LFRAME2" defstate="0">
		<rect state="0">
			<color red="0.2" green="0.1" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.1" blue="0.1"/>
		</rect>
	</element>

<!-- Bet line lamp -->

	<element name="LBETLINE0" defstate="0">
		<rect state="0">
			<color red="0.25" green="0.1" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="0.65" green="0.2" blue="0.1"/>
		</rect>
		<text string=" 1 MEDAL ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="LBETLINE1" defstate="0">
		<rect state="0">
			<color red="0.25" green="0.15" blue="0.2"/>
		</rect>
		<rect state="1">
			<color red="0.65" green="0.30" blue="0.45"/>
		</rect>
		<text string=" 2 MEDAL ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="LBETLINE2" defstate="0">
		<rect state="0">
