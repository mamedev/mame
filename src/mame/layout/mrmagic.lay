		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="430" y="340" width="60" height="40"/>
		</element>

	<!-- Big chance lamp -->

		<element name="lamp_bigchance" ref="LBIGCHANCE">
			<bounds x="540" y="120" width="80" height="80"/>
		</element>
		<element ref="TBIGCHANCE0">
			<bounds x="545" y="140" width="70" height="20"/>
		</element>
		<element ref="TBIGCHANCE1">
			<bounds x="545" y="160" width="70" height="20"/>
		</element>

	<!-- Bonus count lamp -->

		<element name="lamp_bcount0" ref="LBCOUNT2">
			<bounds x="540" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_bcount1" ref="LBCOUNT1">
			<bounds x="540" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_bcount2" ref="LBCOUNT0">
			<bounds x="540" y="310" width="80" height="40"/>
		</element>

	<!-- Insert medal lamp -->

		<element name="lamp_insert" ref="LINSERT">
			<bounds x="520" y="360" width="40" height="40"/>
		</element>

	<!-- Wait lamp -->

		<element name="lamp_wait" ref="LWAIT">
			<bounds x="80" y="370" width="40" height="20"/>
		</element>

	<!-- Credit SEG -->

		<element name="seg_credit0" ref="digit">
			<bounds x="570" y="360" width="20" height="35"/>
		</element>
		<element name="seg_credit1" ref="digit">
			<bounds x="590" y="360" width="20" height="35"/>
		</element>

	<!-- Payout meter SEG -->

		<element name="seg_payout0" ref="digit">
			<bounds x="30" y="360" width="20" height="35"/>
		</element>
		<element name="seg_payout1" ref="digit">
			<bounds x="50" y="360" width="20" height="35"/>
		</element>

	<!-- Reel -->

		<repeat count="3">

			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>

		<!-- Reel backlight -->

			<element ref="LREEL">
				<bounds x="~x~" y="140" width="120" height="180"/>
			</element>

		<!-- Reel pattern -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Hopper & Coin solenoid -->

		<element name="st_hopper" ref="STHOPPER">
			<bounds x="490" y="60" width="60" height="25"/>
		</element>
		<element name="st_solenoid" ref="STSOLENOID">
			<bounds x="560" y="60" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="st_signal_big" ref="STSIGNALBIG">
			<bounds x="20" y="60" width="60" height="25"/>
		</element>
		<element name="st_signal_reg" ref="STSIGNALREG">
			<bounds x="90" y="60" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
