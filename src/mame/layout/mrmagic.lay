			<color red="0.1" green="0.25" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="0.1" green="0.65" blue="0.1"/>
		</rect>
		<text string=" 3 MEDAL ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="LBETLINE4" defstate="0">
		<rect state="0">
			<color red="0.1" green="0.25" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="0.1" green="0.65" blue="0.1"/>
