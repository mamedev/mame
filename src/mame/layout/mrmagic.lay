		</rect>
		<rect state="1">
			<color red="0.8" green="0.2" blue="0.2"/>
		</rect>
		<text string=" STOP ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- Bonus count lamp -->

	<element name="LBCOUNT0" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.2" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.82" blue="0.86"/>
		</rect>
		<text string=" BONUS ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="LBCOUNT1" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.2" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.82" blue="0.86"/>
		</rect>
		<text string=" BONUS ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="LBCOUNT2" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.2" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.82" blue="0.86"/>
		</rect>
		<text string=" BONUS ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- Big chance lamps -->

	<element name="LBIGCHANCE" defstate="0">
		<disk state="0">
			<color red="0.3" green="0.2" blue="0.0"/>
		</disk>
		<disk state="1">
			<color red="0.8" green="0.6" blue="0.1"/>
		</disk>
	</element>
	<element name="TBIGCHANCE0">
		<text string=" BONUS ">
			<color red="0.7" green="0.7" blue="0.0"/>
		</text>
	</element>
	<element name="TBIGCHANCE1">
		<text string=" CHANCE ">
			<color red="0.7" green="0.7" blue="0.0"/>
		</text>
	</element>

<!-- Insert medal lamps -->

	<element name="LINSERT" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.2" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="0.8" green="0.5" blue="0.1"/>
		</rect>
		<text string=" MEDALS ">
			<color red="0.65" green="0.65" blue="0.65"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- Wait lamp -->

	<element name="LWAIT" defstate="0">
		<text string=" WAIT " state="0">
			<color red="0.2" green="0.2" blue="0.0"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
		<text string=" WAIT " state="1">
			<color red="0.75" green="0.75" blue="0.0"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- Reel backlight -->

	<element name="LREEL">
		<rect>
			<color red="1.0" green="1.0" blue="1.0"/>
		</rect>
	</element>

<!-- Hopper & Solenoid -->

	<element name="STHOPPER" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.3" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="0.3" green="1.0" blue="1.0"/>
		</rect>
		<text string=" HOPPER ">
			<color red="0.0" green="0.0" blue="0.0"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="STSOLENOID" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.3" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="0.3" green="1.0" blue="1.0"/>
		</rect>
		<text string=" MEDAL LOCK ">
			<color red="0.0" green="0.0" blue="0.0"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

<!-- Bonus signal -->

	<element name="STSIGNALBIG" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.3" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="0.3" green="1.0" blue="1.0"/>
		</rect>
		<text string=" Signal BIG ">
			<color red="0.0" green="0.0" blue="0.0"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>
	<element name="STSIGNALREG" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.3" blue="0.3"/>
		</rect>
		<rect state="1">
			<color red="0.3" green="1.0" blue="1.0"/>
		</rect>
		<text string=" Signal REG ">
			<color red="0.0" green="0.0" blue="0.0"/>
			<bounds x="0" y="0.25" width="1" height="0.5"/>
		</text>
	</element>

