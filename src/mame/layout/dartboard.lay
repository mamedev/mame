		<element id="seg1:Dart Single 14" ref="hl66"><bounds x="45.451" y="10.151" width="3.385" height="3.591" /></element>
		<element id="seg:Dart Double 14" ref="hl67"><bounds x="44.148" y="9.552" width="2.336" height="3.777" /></element>
		<element id="seg:Dart Single 9" ref="hl68"><bounds x="49.906" y="10.163" width="4.737" height="3.965" /></element>
		<element id="seg:Dart Triple 9" ref="hl69"><bounds x="48.836" y="9.315" width="2.327" height="2.58" /></element>
		<element id="seg1:Dart Single 9" ref="hl70"><bounds x="46.484" y="7.448" width="3.831" height="3.902" /></element>
		<element id="seg:Dart Double 9" ref="hl71"><bounds x="45.308" y="6.515" width="3.14" height="3.637" /></element>
		<element id="seg:Dart Single 12" ref="hl72"><bounds x="51.163" y="8.906" width="3.965" height="4.737" /></element>
		<element id="seg:Dart Triple 12" ref="hl73"><bounds x="50.315" y="7.836" width="2.58" height="2.327" /></element>
		<element id="seg1:Dart Single 12" ref="hl74"><bounds x="48.448" y="5.484" width="3.902" height="3.831" /></element>
		<element id="seg:Dart Double 12" ref="hl75"><bounds x="47.515" y="4.308" width="3.637" height="3.14" /></element>
		<element id="seg:Dart Single 5" ref="hl76"><bounds x="52.895" y="8.244" width="2.805" height="5.045" /></element>
		<element id="seg:Dart Triple 5" ref="hl77"><bounds x="52.35" y="7.059" width="2.58" height="1.847" /></element>
		<element id="seg1:Dart Single 5" ref="hl78"><bounds x="51.151" y="4.451" width="3.591" height="3.385" /></element>
		<element id="seg:Dart Double 5" ref="hl79"><bounds x="50.552" y="3.148" width="3.777" height="2.336" /></element>
		<element id="seg:Dart Single Bull" ref="hl_bull"><bounds x="54.08" y="13.08" width="3.84" height="3.84" /></element>
		<element id="seg:Dart Double Bull" ref="hl_bullseye"><bounds x="55.16" y="14.16" width="1.68" height="1.68" /></element>

		<element id="warning" ref="warning"><bounds x="41" y="13.5" width="30" height="3" /></element>
	</view>

	<script><![CDATA[
		file:set_resolve_tags_callback(
			function ()
				local view = file.views['Dartboard']

				-- dart board targets and the optional missed dart sensor, by name
				local targets = { }
				for _, port in pairs(machine.ioport.ports) do
					for _, field in pairs(port.fields) do
						targets[field.default_name] = field
					end
				end
				local missed = targets['Missed Dart Sensor']

				-- highlight the targets while they're pressed (view.items can't be iterated with ipairs)
				for i = 1, #view.items do
					local item = view.items:at(i)
					local field = targets[(item.id or ''):match('^seg%d*:(.+)$')]
					if field then
						item:set_element_state_callback(
							function ()
								return (((field.port:read() ~ field.defvalue) & field.mask) ~= 0) and 1 or 0
							end)
					end
				end

				-- find the target under the pointer
				local board = view.items['board']
				local order = { 20, 1, 18, 4, 13, 6, 10, 15, 2, 17, 3, 19, 7, 16, 8, 11, 14, 9, 12, 5 }

				local function board_target(x, y)
					-- board coordinates, the double ring outer edge has radius 1
					local b = board.bounds
					local dx = (x - ((b.x0 + b.x1) / 2)) * 2.5 / b.width
					local dy = (y - ((b.y0 + b.y1) / 2)) * 2.5 / b.height
					local r = math.sqrt((dx * dx) + (dy * dy))
					if r >= 1.25 then
						return nil
					elseif r >= 1.0 then
						return missed
					elseif r < 0.07 then
						return targets['Dart Double Bull']
					elseif r < 0.16 then
						return targets['Dart Single Bull']
					end
					local number = order[(math.floor((math.deg(math.atan(dx, -dy)) + 9) / 18) % 20) + 1]
					local ring = 'Single'
					if (r >= 0.57) and (r < 0.67) then
						ring = 'Triple'
					elseif r >= 0.89 then
						ring = 'Double'
					end
					return targets['Dart ' .. ring .. ' ' .. number]
				end

				-- the target is held while the primary button is down
				local ptr_id = nil
				local held = nil

				local function release()
					if held then
						held:clear_value()
					end
					ptr_id = nil
					held = nil
				end

				local function pointer_updated(type, id, dev, x, y, btn, dn, up, cnt)
					if ptr_id == id then
						if (btn & 0x01) == 0 then
							release()
						end
					elseif (not ptr_id) and ((dn & 0x01) ~= 0) then
						held = board_target(x, y)
						if held then
							ptr_id = id
							held:set_value(1)
						end
					end
				end

				local function pointer_lost(type, id, dev, x, y, up, cnt)
					if ptr_id == id then
						release()
					end
				end

				view:set_pointer_updated_callback(pointer_updated)
				view:set_pointer_left_callback(pointer_lost)
				view:set_pointer_aborted_callback(pointer_lost)
				view:set_forget_pointers_callback(release)

				view.items['warning']:set_state(0)
			end)
	]]></script>
</mamelayout>
