<!--
Fantastic Car (Falgàs M89 hardware): the car dashboard, laid out as on the
real machine, and the front panel of the M89 box.  This program has no R.P.M
display code, so the display window stays dark.
-->
<mamelayout version="2">

	<element name="background">
		<rect>
			<color red="0.06" green="0.06" blue="0.07" />
		</rect>
	</element>

	<element name="plate">
		<rect>
			<color red="0.55" green="0.56" blue="0.60" />
		</rect>
		<rect>
			<bounds x="0.025" y="0.02" width="0.95" height="0.96" />
			<color red="0.14" green="0.14" blue="0.16" />
		</rect>
	</element>

	<element name="bezel">
		<rect>
			<color red="0.48" green="0.49" blue="0.53" />
		</rect>
		<rect>
			<bounds x="0.02" y="0.015" width="0.96" height="0.97" />
			<color red="0.05" green="0.05" blue="0.06" />
		</rect>
	</element>

	<element name="window">
		<rect>
			<color red="0.16" green="0.36" blue="0.72" />
		</rect>
		<rect>
			<bounds x="0.04" y="0.08" width="0.92" height="0.84" />
			<color red="0.03" green="0.03" blue="0.03" />
		</rect>
	</element>

	<element name="rpm_label">
		<rect>
			<color red="0.87" green="0.45" blue="0.38" />
		</rect>
		<text string="R.P.M">
			<color red="0.97" green="0.97" blue="0.97" />
		</text>
	</element>

	<element name="button_plate">
		<rect>
			<color red="0.87" green="0.66" blue="0.12" />
		</rect>
		<rect>
			<bounds x="0.06" y="0.04" width="0.88" height="0.92" />
			<color red="0.08" green="0.08" blue="0.09" />
		</rect>
	</element>

	<element name="button" defstate="0">
		<rect state="0">
			<color red="0.24" green="0.24" blue="0.26" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.96" blue="0.86" />
		</rect>
	</element>

	<element name="button_mark" defstate="0">
		<rect state="0">
			<color red="0.36" green="0.36" blue="0.36" />
		</rect>
		<rect state="1">
			<color red="1.00" green="1.00" blue="1.00" />
		</rect>
	</element>

	<element name="oil_lamp" defstate="0">
		<disk>
			<color red="0.55" green="0.56" blue="0.60" />
		</disk>
		<disk state="0">
			<bounds x="0.18" y="0.18" width="0.64" height="0.64" />
			<color red="0.30" green="0.05" blue="0.04" />
		</disk>
		<disk state="1">
			<bounds x="0.18" y="0.18" width="0.64" height="0.64" />
			<color red="1.00" green="0.15" blue="0.10" />
		</disk>
	</element>

	<element name="bar" defstate="0">
		<rect state="0">
			<color red="0.30" green="0.30" blue="0.30" />
		</rect>
		<rect state="1">
			<color red="1.00" green="1.00" blue="1.00" />
		</rect>
	</element>

	<element name="lens" defstate="0">
		<disk state="0">
			<color red="0.26" green="0.26" blue="0.26" />
		</disk>
		<disk state="1">
			<color red="1.00" green="1.00" blue="1.00" />
		</disk>
	</element>

	<element name="speed_lamp" defstate="0">
		<rect state="0">
			<color red="0.38" green="0.28" blue="0.05" />
		</rect>
		<rect state="1">
			<color red="1.00" green="0.80" blue="0.16" />
		</rect>
	</element>
	<element name="lbl_100">
		<text string="100"><color red="0.85" green="0.30" blue="0.10" /></text>
	</element>
	<element name="lbl_200">
		<text string="200"><color red="0.85" green="0.30" blue="0.10" /></text>
	</element>
	<element name="lbl_250">
		<text string="250"><color red="0.85" green="0.30" blue="0.10" /></text>
	</element>
	<element name="lbl_300">
		<text string="300"><color red="0.85" green="0.30" blue="0.10" /></text>
	</element>

	<element name="start_button" defstate="0">
		<rect>
			<color red="0.62" green="0.63" blue="0.66" />
		</rect>
		<rect state="0">
			<bounds x="0.1" y="0.06" width="0.8" height="0.88" />
			<color red="0.24" green="0.31" blue="0.26" />
		</rect>
		<rect state="1">
			<bounds x="0.1" y="0.06" width="0.8" height="0.88" />
			<color red="0.72" green="1.00" blue="0.76" />
		</rect>
	</element>

	<element name="arrow">
		<rect>
			<color red="0.85" green="0.25" blue="0.20" />
		</rect>
	</element>

	<element name="lbl_turbo">
		<text string="TURBO"><color red="0.78" green="0.78" blue="0.80" /></text>
	</element>
	<element name="lbl_sirena">
		<text string="SIRENA"><color red="0.78" green="0.78" blue="0.80" /></text>
	</element>
	<element name="lbl_radar">
		<text string="RADAR"><color red="0.78" green="0.78" blue="0.80" /></text>
	</element>
	<element name="lbl_oil">
		<text string="OIL"><color red="0.78" green="0.78" blue="0.80" /></text>
	</element>
	<element name="lbl_start">
		<text string="START"><color red="0.78" green="0.78" blue="0.80" /></text>
	</element>

	<element name="front">
		<rect>
			<color red="0.93" green="0.76" blue="0.12" />
		</rect>
	</element>

	<element name="led" defstate="0">
		<disk>
			<color red="0.05" green="0.05" blue="0.05" />
		</disk>
		<disk state="0">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0.30" green="0.05" blue="0.04" />
		</disk>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="1.00" green="0.20" blue="0.12" />
		</disk>
	</element>

	<element name="lbl_motor">
		<text string="Motor On"><color red="0.05" green="0.05" blue="0.05" /></text>
	</element>
	<element name="lbl_coin">
		<text string="Coin Input"><color red="0.05" green="0.05" blue="0.05" /></text>
	</element>
	<element name="lbl_timer">
		<text string="Timer-Sound"><color red="0.05" green="0.05" blue="0.05" /></text>
	</element>
	<element name="lbl_light">
		<text string="Light"><color red="0.05" green="0.05" blue="0.05" /></text>
	</element>

	<group name="dashboard">
		<bounds x="0" y="0" width="620" height="260" />

		<element ref="background">
			<bounds x="0" y="0" width="620" height="260" />
		</element>

		<!-- left pod -->
		<element ref="plate">
			<bounds x="10" y="10" width="190" height="240" />
		</element>
		<element ref="rpm_label">
			<bounds x="22" y="32" width="60" height="22" />
		</element>
		<element ref="window">
			<bounds x="92" y="22" width="96" height="42" />
		</element>

		<element ref="button_plate">
			<bounds x="38" y="96" width="48" height="104" />
		</element>
		<element name="turbo_lamp" ref="button" inputtag="IN0" inputmask="0x80">
			<bounds x="46" y="114" width="32" height="68" />
		</element>
		<element name="turbo_lamp" ref="button_mark" inputtag="IN0" inputmask="0x80">
			<bounds x="58" y="126" width="8" height="44" />
			<color red="0.62" green="0.62" blue="0.66" />
		</element>
		<element ref="lbl_turbo">
			<bounds x="34" y="204" width="56" height="12" />
		</element>

		<element ref="button_plate">
			<bounds x="92" y="96" width="48" height="104" />
		</element>
		<element name="siren_lamp" ref="button" inputtag="IN0" inputmask="0x40">
			<bounds x="100" y="114" width="32" height="68" />
		</element>
		<element name="siren_lamp" ref="button_mark" inputtag="IN0" inputmask="0x40">
			<bounds x="112" y="126" width="8" height="44" />
			<color red="0.92" green="0.12" blue="0.10" />
		</element>
		<element ref="lbl_sirena">
			<bounds x="88" y="204" width="56" height="12" />
		</element>

		<element ref="button_plate">
			<bounds x="146" y="96" width="48" height="104" />
		</element>
		<element name="radar_lamp" ref="button" inputtag="CONTROLS" inputmask="0x01">
			<bounds x="154" y="114" width="32" height="68" />
		</element>
		<element name="radar_lamp" ref="button_mark" inputtag="CONTROLS" inputmask="0x01">
			<bounds x="166" y="126" width="8" height="44" />
			<color red="0.18" green="0.40" blue="0.95" />
		</element>
		<element ref="lbl_radar">
			<bounds x="142" y="204" width="56" height="12" />
		</element>

		<element name="blink_lamp" ref="oil_lamp">
			<bounds x="16" y="200" width="20" height="20" />
		</element>
		<element ref="lbl_oil">
			<bounds x="13" y="224" width="26" height="12" />
		</element>

		<!-- centre pod: KITT's voice box between the scanner columns -->
		<element ref="plate">
			<bounds x="210" y="10" width="210" height="240" />
		</element>
		<element ref="bezel">
			<bounds x="234" y="14" width="162" height="232" />
		</element>
		<element name="voice0" ref="bar">
			<bounds x="240" y="22" width="34" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice3" ref="bar">
			<bounds x="280" y="22" width="70" height="20" />
			<color red="1.00" green="0.84" blue="0.16" />
		</element>
		<element name="voice0" ref="bar">
			<bounds x="356" y="22" width="34" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice1" ref="bar">
			<bounds x="240" y="50" width="40" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice2" ref="bar">
			<bounds x="286" y="50" width="58" height="20" />
			<color red="1.00" green="0.84" blue="0.16" />
		</element>
		<element name="voice1" ref="bar">
			<bounds x="350" y="50" width="40" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice2" ref="bar">
			<bounds x="240" y="78" width="47" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice1" ref="bar">
			<bounds x="293" y="78" width="44" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice2" ref="bar">
			<bounds x="343" y="78" width="47" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice3" ref="bar">
			<bounds x="240" y="106" width="49" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice0" ref="bar">
			<bounds x="295" y="106" width="40" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice3" ref="bar">
			<bounds x="341" y="106" width="49" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice3" ref="bar">
			<bounds x="240" y="134" width="49" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice0" ref="bar">
			<bounds x="295" y="134" width="40" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice3" ref="bar">
			<bounds x="341" y="134" width="49" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice2" ref="bar">
			<bounds x="240" y="162" width="47" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice1" ref="bar">
			<bounds x="293" y="162" width="44" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice2" ref="bar">
			<bounds x="343" y="162" width="47" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice1" ref="bar">
			<bounds x="240" y="190" width="40" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice2" ref="bar">
			<bounds x="286" y="190" width="58" height="20" />
			<color red="1.00" green="0.84" blue="0.16" />
		</element>
		<element name="voice1" ref="bar">
			<bounds x="350" y="190" width="40" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice0" ref="bar">
			<bounds x="240" y="218" width="34" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>
		<element name="voice3" ref="bar">
			<bounds x="280" y="218" width="70" height="20" />
			<color red="1.00" green="0.84" blue="0.16" />
		</element>
		<element name="voice0" ref="bar">
			<bounds x="356" y="218" width="34" height="20" />
			<color red="1.00" green="0.18" blue="0.12" />
		</element>

		<repeat count="4">
			<param name="n" start="0" increment="2" />
			<param name="y" start="25" increment="56" />
			<element name="scanner~n~" ref="lens">
				<bounds x="218" y="~y~" width="14" height="14" />
				<color red="1.00" green="0.16" blue="0.12" />
			</element>
			<element name="scanner~n~" ref="lens">
				<bounds x="398" y="~y~" width="14" height="14" />
				<color red="1.00" green="0.16" blue="0.12" />
			</element>
		</repeat>
		<repeat count="4">
			<param name="n" start="1" increment="2" />
			<param name="y" start="53" increment="56" />
			<element name="scanner~n~" ref="lens">
				<bounds x="218" y="~y~" width="14" height="14" />
				<color red="0.25" green="0.55" blue="1.00" />
			</element>
			<element name="scanner~n~" ref="lens">
				<bounds x="398" y="~y~" width="14" height="14" />
				<color red="0.25" green="0.55" blue="1.00" />
			</element>
		</repeat>

		<!-- right pod -->
		<element ref="plate">
			<bounds x="430" y="10" width="180" height="240" />
		</element>
		<element name="speed0" ref="speed_lamp">
			<bounds x="442" y="34" width="36" height="40" />
		</element>
		<element ref="lbl_100">
			<bounds x="446" y="44" width="28" height="20" />
		</element>
		<element name="speed1" ref="speed_lamp">
			<bounds x="482" y="38" width="36" height="40" />
		</element>
		<element ref="lbl_200">
			<bounds x="486" y="48" width="28" height="20" />
		</element>
		<element name="speed2" ref="speed_lamp">
			<bounds x="522" y="42" width="36" height="40" />
		</element>
		<element ref="lbl_250">
			<bounds x="526" y="52" width="28" height="20" />
		</element>
		<element name="speed3" ref="speed_lamp">
			<bounds x="562" y="46" width="36" height="40" />
		</element>
		<element ref="lbl_300">
			<bounds x="566" y="56" width="28" height="20" />
		</element>
		<element name="start_lamp" ref="start_button" inputtag="IN0" inputmask="0x10">
			<bounds x="500" y="118" width="36" height="76" />
		</element>
		<element ref="arrow">
			<bounds x="470" y="151" width="22" height="10" />
		</element>
		<element ref="arrow">
			<bounds x="544" y="151" width="22" height="10" />
		</element>
		<element ref="lbl_start">
			<bounds x="486" y="204" width="64" height="12" />
		</element>
	</group>

	<group name="front_panel">
		<bounds x="0" y="0" width="320" height="80" />

		<element ref="front">
			<bounds x="0" y="0" width="320" height="80" />
		</element>
		<element name="motor" ref="led">
			<bounds x="28" y="20" width="24" height="24" />
		</element>
		<element ref="lbl_motor">
			<bounds x="0" y="50" width="80" height="12" />
		</element>
		<element ref="led">
			<bounds x="108" y="20" width="24" height="24" />
		</element>
		<element ref="lbl_coin">
			<bounds x="80" y="50" width="80" height="12" />
		</element>
		<element ref="led">
			<bounds x="188" y="20" width="24" height="24" />
		</element>
		<element ref="lbl_timer">
			<bounds x="160" y="50" width="80" height="12" />
		</element>
		<element ref="led">
			<bounds x="268" y="20" width="24" height="24" />
		</element>
		<element ref="lbl_light">
			<bounds x="240" y="50" width="80" height="12" />
		</element>
	</group>

	<view name="Dashboard and Front Panel">
		<group ref="dashboard">
			<bounds x="0" y="0" width="620" height="260" />
		</group>
		<group ref="front_panel">
			<bounds x="150" y="270" width="320" height="80" />
		</group>
	</view>

	<view name="Dashboard">
		<group ref="dashboard">
			<bounds x="0" y="0" width="620" height="260" />
		</group>
	</view>

</mamelayout>
