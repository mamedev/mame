	<view name="Screen Only">
		<bounds x="0" y="0" width="768" height="576" />
		<screen index="0"><bounds x="0" y="0" width="768" height="576" /></screen>
	</view>

	<script><![CDATA[
		local lamp_items = {
			{ number = 0, face = "answer_left_a_face", highlight = "answer_left_a_highlight" },
			{ number = 1, face = "answer_left_b_face", highlight = "answer_left_b_highlight" },
			{ number = 2, face = "answer_left_c_face", highlight = "answer_left_c_highlight" },
			{ number = 4, face = "start_face", highlight = "start_highlight" },
			{ number = 5, face = "answer_right_c_face", highlight = "answer_right_c_highlight" },
			{ number = 6, face = "answer_right_b_face", highlight = "answer_right_b_highlight" },
			{ number = 7, face = "answer_right_a_face", highlight = "answer_right_a_highlight" },
			{ number = 8, face = "direction_left_face", highlight = "direction_left_highlight" },
			{ number = 9, face = "direction_right_face", highlight = "direction_right_highlight" },
			{ number = 10, face = "direction_up_face", highlight = "direction_up_highlight" },
			{ number = 11, face = "direction_down_face", highlight = "direction_down_highlight" },
			{ number = 12, face = "select_face", highlight = "select_highlight" },
			{ number = 13, face = "coin_acceptor_lamps" },
			{ number = 14, face = "name_panel_section_1" },
			{ number = 15, face = "name_panel_section_2" },
			{ number = 16, face = "name_panel_section_3" },
			{ number = 17, face = "name_panel_section_4" },
			{ number = 18, face = "name_panel_section_5" },
			{ number = 19, face = "name_panel_section_6" },
			{ number = 20, face = "name_panel_section_7" },
			{ number = 21, face = "name_panel_section_8" },
			{ number = 22, face = "name_panel_section_9" },
			{ number = 23, face = "name_panel_section_10" }
		}
		local maximum_level = 255
		local locked_coin_state = 256
		-- Model the fast end of miniature incandescent-lamp response ranges with
		-- exponential relaxation: 100 ms to 90% and 60 ms to 10% brightness.
		local rise_time_to_90_percent = 0.10
		local fall_time_to_10_percent = 0.06
		local response_scale = math.log(10.0)

		local function state_callback(lamp)
			return function () return math.floor(lamp.level + 0.5) end
		end
		local function coin_label_state_callback(label, lamp)
			return function () return label.output:get() ~= 0 and locked_coin_state or math.floor(lamp.level + 0.5) end
		end

		file:set_resolve_tags_callback(function ()
			local view = file.views["Screen and Controls"]
			local lamps = { }
			local coin_acceptor_lamp
			local name_panel_label = { item = view.items["name_panel_label"], level = 0 }
			local name_panel_lamp_count = 0
			for _, item in ipairs(lamp_items) do
				local lamp = {
					output = file.device:output(string.format("lamp%u", item.number)),
					face = view.items[item.face],
					highlight = item.highlight and view.items[item.highlight] or nil,
					name_panel = item.number >= 14 }
				lamp.level = lamp.output:get() ~= 0 and maximum_level or 0
				lamp.face:set_element_state_callback(state_callback(lamp))
				if lamp.highlight then lamp.highlight:set_element_state_callback(state_callback(lamp)) end
				if item.number == 13 then coin_acceptor_lamp = lamp end
				if lamp.name_panel then
					name_panel_label.level = name_panel_label.level + lamp.level
					name_panel_lamp_count = name_panel_lamp_count + 1
				end
				table.insert(lamps, lamp)
			end
			name_panel_label.level = name_panel_label.level / name_panel_lamp_count
			name_panel_label.item:set_element_state_callback(state_callback(name_panel_label))

			local coin_labels = {
				{ item = view.items["coin_pound_label"], output = file.device:output("coin_lockout0") },
				{ item = view.items["coin_50p_label"], output = file.device:output("coin_lockout1") },
				{ item = view.items["coin_20p_label"], output = file.device:output("coin_lockout2") },
				{ item = view.items["coin_10p_label"], output = file.device:output("coin_lockout3") },
				{ item = view.items["coin_5p_label"], output = file.device:output("coin_lockout4") }
			}
			for _, label in ipairs(coin_labels) do
				label.item:set_element_state_callback(coin_label_state_callback(label, coin_acceptor_lamp))
			end
			view.items["coin_two_pounds_label"]:set_element_state_callback(state_callback(coin_acceptor_lamp))

			local previous_time = emu.attotime(machine.time)
			view:set_prepare_items_callback(function ()
				local current_time = machine.time
				local elapsed = (current_time - previous_time):as_double()
				previous_time = emu.attotime(current_time)
				local name_panel_level = 0
				for _, lamp in ipairs(lamps) do
					local target = lamp.output:get() ~= 0 and maximum_level or 0
					if elapsed < 0 or elapsed > 0.25 then
						lamp.level = target
					elseif target ~= lamp.level then
						local response_time = target > lamp.level and rise_time_to_90_percent or fall_time_to_10_percent
						lamp.level = lamp.level + (target - lamp.level) * (1.0 - math.exp(-response_scale * elapsed / response_time))
						if math.abs(target - lamp.level) < 0.5 then lamp.level = target end
					end
					if lamp.name_panel then name_panel_level = name_panel_level + lamp.level end
				end
				name_panel_label.level = name_panel_level / name_panel_lamp_count
			end)
		end)
	]]></script>
</mamelayout>
