<!--
Control positions are reconstructed from photographs of a surviving Top of
the Pops cabinet.  Button legends are simplified, and exact illuminated
shades are visual estimates.  The coin acceptor follows the unit visible in
the cabinet photographs.  The upper illuminated name panel is visible in the
photographs, but its ten output-to-section assignments and simplified logo
treatment are reconstructions.
-->
<mamelayout version="2">
	<element name="panel">
		<rect><color red="0.025" green="0.025" blue="0.055" /></rect>
	</element>
	<element name="coin_input">
		<rect><color alpha="0.0" /></rect>
	</element>

