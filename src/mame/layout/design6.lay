<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:Dirk Best

Azkoyen "Design" D6 layout
-->
<mamelayout version="2">

	<!-- basic elements -->

	<element name="panel">
		<rect><color red="0.16" green="0.16" blue="0.17" /></rect>
	</element>

	<element name="bezel">
		<rect><color red="0.02" green="0.02" blue="0.03" /></rect>
	</element>

	<element name="vfd">
		<led16segsc><color red="0.0" green="0.85" blue="0.75" /></led16segsc>
	</element>

	<element name="button" defstate="0">
		<disk state="0"><color red="0.80" green="0.80" blue="0.80" /></disk>
		<disk state="1"><color red="0.45" green="0.45" blue="0.45" /></disk>
	</element>

	<element name="button_red" defstate="0">
		<disk state="0"><color red="0.80" green="0.12" blue="0.10" /></disk>
		<disk state="1"><color red="0.45" green="0.06" blue="0.05" /></disk>
	</element>

	<element name="key" defstate="0">
		<rect state="0"><color red="0.80" green="0.80" blue="0.80" /></rect>
		<rect state="1"><color red="0.45" green="0.45" blue="0.45" /></rect>
	</element>

	<element name="switch" defstate="0">
		<rect state="0"><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect state="1"><color red="0.95" green="0.65" blue="0.10" /></rect>
		<text state="0" string="NORMAL"><color red="0.85" green="0.85" blue="0.85" /></text>
		<text state="1" string="CONTROL"><color red="0.0" green="0.0" blue="0.0" /></text>
	</element>

	<element name="toggle" defstate="0">
		<rect state="0"><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect state="1"><color red="0.85" green="0.20" blue="0.15" /></rect>
	</element>

	<element name="lamp" defstate="0">
		<disk state="0"><color red="0.20" green="0.08" blue="0.05" /></disk>
		<disk state="1"><color red="1.00" green="0.45" blue="0.10" /></disk>
	</element>

	<!-- text on buttons -->

	<element name="text_1"><text string="1"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_2"><text string="2"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_3"><text string="3"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_4"><text string="4"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_5"><text string="5"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_6"><text string="6"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_A"><text string="A"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_B"><text string="B"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_C"><text string="C"><color red="0.0" green="0.0" blue="0.0" /></text></element>
	<element name="text_D"><text string="D"><color red="0.0" green="0.0" blue="0.0" /></text></element>

	<!-- labels -->

	<element name="text_selection"><text string="SELECTION" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_coin_return"><text string="COIN RETURN"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_keypad"><text string="KEYPAD" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_service"><text string="SERVICE" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_outputs"><text string="OUTPUTS" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_sensors"><text string="SENSORS (click to toggle)" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_hopper"><text string="Hopper motor" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_sorter"><text string="Sorter coil" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_extractor"><text string="Extractor" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_recovery"><text string="Recovery motor" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_valid"><text string="Valid coin" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_enable"><text string="Enable" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_escret"><text string="Escrow return" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_esccoll"><text string="Escrow collect" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_flap"><text string="Flap (sim.)" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_empty"><text string="Hopper empty 1 2 3" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>
	<element name="text_full"><text string="Hopper full 1 2 3" align="1"><color red="0.75" green="0.75" blue="0.75" /></text></element>

	<!-- the display, VFD digit 15 is leftmost -->

	<group name="display">
		<bounds x="0" y="0" width="380" height="50" />
		<element ref="bezel"><bounds x="0" y="0" width="380" height="50" /></element>
		<repeat count="16">
			<param name="n" start="15" increment="-1" />
			<param name="x" start="14" increment="22" />
			<element name="vfd~n~" ref="vfd"><bounds x="~x~" y="8" width="20" height="34" /></element>
		</repeat>
	</group>

	<!-- status outputs and sensor toggles -->

	<group name="status">
		<bounds x="0" y="0" width="380" height="120" />

		<element ref="text_outputs"><bounds x="0" y="0" width="120" height="10" /></element>

		<element ref="text_hopper"><bounds x="0" y="14" width="80" height="8" /></element>
		<repeat count="3">
			<param name="n" start="1" increment="1" />
			<param name="x" start="85" increment="12" />
			<element name="hopper_motor~n~" ref="lamp"><bounds x="~x~" y="14" width="8" height="8" /></element>
		</repeat>

		<element ref="text_sorter"><bounds x="140" y="14" width="80" height="8" /></element>
		<repeat count="3">
			<param name="n" start="1" increment="1" />
			<param name="x" start="215" increment="12" />
			<element name="sorter_coil~n~" ref="lamp"><bounds x="~x~" y="14" width="8" height="8" /></element>
		</repeat>

		<element name="recovery_motor" ref="lamp"><bounds x="0" y="28" width="8" height="8" /></element>
		<element ref="text_recovery"><bounds x="12" y="28" width="110" height="8" /></element>
		<element name="coin_valid" ref="lamp"><bounds x="127" y="28" width="8" height="8" /></element>
		<element ref="text_valid"><bounds x="139" y="28" width="110" height="8" /></element>
		<element name="enable" ref="lamp"><bounds x="254" y="28" width="8" height="8" /></element>
		<element ref="text_enable"><bounds x="266" y="28" width="110" height="8" /></element>
		<element name="escrow_return" ref="lamp"><bounds x="0" y="40" width="8" height="8" /></element>
		<element ref="text_escret"><bounds x="12" y="40" width="110" height="8" /></element>
		<element name="escrow_collect" ref="lamp"><bounds x="127" y="40" width="8" height="8" /></element>
		<element ref="text_esccoll"><bounds x="139" y="40" width="110" height="8" /></element>
		<element name="flap" ref="lamp"><bounds x="254" y="40" width="8" height="8" /></element>
		<element ref="text_flap"><bounds x="266" y="40" width="110" height="8" /></element>

		<element ref="text_extractor"><bounds x="0" y="54" width="80" height="8" /></element>
		<repeat count="6">
			<param name="n" start="1" increment="1" />
			<param name="x" start="85" increment="12" />
			<element name="extractor~n~" ref="lamp"><bounds x="~x~" y="54" width="8" height="8" /></element>
		</repeat>

		<element ref="text_sensors"><bounds x="0" y="74" width="200" height="10" /></element>

		<element ref="text_empty"><bounds x="0" y="88" width="110" height="8" /></element>
		<element ref="toggle" inputtag="IN1" inputmask="0x20"><bounds x="115" y="88" width="10" height="8" /></element>
		<element ref="toggle" inputtag="IN1" inputmask="0x10"><bounds x="128" y="88" width="10" height="8" /></element>
		<element ref="toggle" inputtag="IN1" inputmask="0x08"><bounds x="141" y="88" width="10" height="8" /></element>

		<element ref="text_full"><bounds x="0" y="102" width="110" height="8" /></element>
		<element ref="toggle" inputtag="IN1" inputmask="0x80"><bounds x="115" y="102" width="10" height="8" /></element>
		<element ref="toggle" inputtag="IN0" inputmask="0x80"><bounds x="128" y="102" width="10" height="8" /></element>
		<element ref="toggle" inputtag="IN3" inputmask="0x08"><bounds x="141" y="102" width="10" height="8" /></element>
	</group>

	<view name="Machine">
		<element ref="panel"><bounds x="0" y="0" width="400" height="330" /></element>

		<group ref="display"><bounds x="10" y="10" width="380" height="50" /></group>

		<!-- selection buttons -->
		<element ref="text_selection"><bounds x="10" y="72" width="100" height="10" /></element>
		<repeat count="6">
			<param name="n" start="1" increment="1" />
			<param name="mask" start="0x02" lshift="1" />
			<param name="x" start="20" increment="30" />
			<element ref="button" inputtag="KEY0" inputmask="~mask~"><bounds x="~x~" y="88" width="22" height="22" /></element>
			<element ref="text_~n~"><bounds x="~x~" y="92" width="22" height="14" /></element>
		</repeat>

		<!-- coin return button -->
		<element ref="button_red" inputtag="KEY0" inputmask="0x01"><bounds x="330" y="84" width="30" height="30" /></element>
		<element ref="text_coin_return"><bounds x="305" y="118" width="80" height="10" /></element>

		<!-- operator keypad and service switch -->
		<element ref="text_keypad"><bounds x="10" y="136" width="100" height="10" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x10"><bounds x="20" y="150" width="22" height="18" /></element>
		<element ref="text_A"><bounds x="20" y="152" width="22" height="14" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x20"><bounds x="50" y="150" width="22" height="18" /></element>
		<element ref="text_B"><bounds x="50" y="152" width="22" height="14" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x40"><bounds x="80" y="150" width="22" height="18" /></element>
		<element ref="text_C"><bounds x="80" y="152" width="22" height="14" /></element>
		<element ref="key" inputtag="KEY3" inputmask="0x80"><bounds x="110" y="150" width="22" height="18" /></element>
		<element ref="text_D"><bounds x="110" y="152" width="22" height="14" /></element>

		<element ref="text_service"><bounds x="200" y="136" width="70" height="10" /></element>
		<element ref="switch" inputtag="IN0" inputmask="0x40"><bounds x="200" y="150" width="70" height="18" /></element>

		<group ref="status"><bounds x="10" y="196" width="380" height="120" /></group>
	</view>

</mamelayout>
