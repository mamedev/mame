	<element name="label_c0">
		<text string="M1">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="label_c1">
		<text string="MREQ">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="label_c2">
		<text string="IORQ">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="label_c3">
		<text string="RD">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="label_c4">
		<text string="WR">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
