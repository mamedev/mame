			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="label_c9">
		<text string="MCYCL">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>

	<view name="Internal Layout">
		<!-- Bus analyzer -->
		<repeat count="16">
			<param name="n" start="15" increment="-1" />
			<param name="x" start="1" increment="10" />
			<element name="a~n~" ref="led">
				<bounds xc="~x~" y="0" width="6" height="6" />
			</element>
			<element ref="label_a~n~">
				<bounds xc="~x~" y="8" width="10" height="4" />
			</element>
		</repeat>
		<repeat count="8">
			<param name="n" start="7" increment="-1" />
			<param name="x" start="1" increment="10" />
			<element name="d~n~" ref="led">
				<bounds xc="~x~" y="22" width="6" height="6" />
			</element>
			<element ref="label_d~n~">
				<bounds xc="~x~" y="30" width="10" height="4" />
			</element>
		</repeat>
		<repeat count="9">
			<param name="n" start="0" increment="1" />
			<param name="x" start="91" increment="10" />
			<element name="c~n~" ref="led">
				<bounds xc="~x~" y="22" width="6" height="6" />
			</element>
			<element ref="label_c~n~">
				<bounds xc="~x~" y="30" width="10" height="4" />
			</element>
		</repeat>
		<element name="c9" ref="led">
			<bounds xc="194" y="22" width="6" height="6" />
		</element>
		<element ref="label_c9">
			<bounds xc="194" y="30" width="10" height="4" />
		</element>

		<!-- Led address display -->
		<repeat count="8">
			<param name="n" start="7" increment="-1" />
			<param name="x" start="215" increment="18" />
			<element name="digit~n~" ref="digit">
				<bounds x="~x~" y="0" width="18" height="26" />
			</element>
		</repeat>
	</view>
</mamelayout>
