<mamelayout version="2">
	<element name="digit" defstate="0">
		<led7seg>
			<color red="0.4" green="1.0" blue="0" />
		</led7seg>
	</element>

	<element name="led" defstate="0">
		<disk state="0">
			<color red="0.15" green="0.01" blue="0.01" />
		</disk>
		<disk state="1">
			<color red="0.40" green="0.04" blue="0.04" />
		</disk>
		<disk state="2">
			<color red="0.70" green="0.07" blue="0.07" />
		</disk>
		<disk state="3">
			<color red="1.00" green="0.10" blue="0.10" />
		</disk>
	</element>

	<element name="label_a0">
		<text string="A0">
			<color red="0.8" green="0.8" blue="0.8" />
		</text>
	</element>
	<element name="label_a1">
		<text string="A1">
			<color red="0.8" green="0.8" blue="0.8" />
