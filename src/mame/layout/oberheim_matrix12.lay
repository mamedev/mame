<mamelayout version="2">
	<element name="txt_master">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string=" MASTER" align="1"><color red="0.80" green="0.80" blue="0.80"/></text>
	</element>
	<element name="txt_volume"><text string="VOLUME"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_tune_page"><text string="TUNE PAGE"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_master_page"><text string="MASTER PAGE"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_programmer">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string=" PROGRAMMER" align="1"><color red="0.80" green="0.80" blue="0.80"/></text>
	</element>
	<element name="txt_patch_l"><text string="PATCH" align="1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_patch_name"><text string="PATCH NAME" align="1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice"><text string="VOICE"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice_1"><text string="1-2"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice_2"><text string="3-4"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice_3"><text string="5-6"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice_4"><text string="7-8"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice_5"><text string="9-10"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_voice_6"><text string="11-12"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_curr_page"><text string="CURRENT PAGE" align="1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_modulation_page">
		<text string="MODULATION PAGE" align="2"><color red="0.65" green="0.80" blue="0.40"/></text>
	</element>
	<element name="txt_multi_patch_page">
		<text string="MULTI PATCH PAGE" align="1"><color red="0.70" green="0.70" blue="0.70"/></text>
	</element>
	<element name="txt_single"><text string="SINGLE"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_patch"><text string="PATCH"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_multi_grey"><text string="MULTI"><color red="0.70" green="0.70" blue="0.70"/></text></element>
	<element name="txt_patch_grey"><text string="PATCH"><color red="0.70" green="0.70" blue="0.70"/></text></element>
	<element name="txt_store"><text string="STORE"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_patch_edit"><text string="PATCH EDIT"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_voices_1_6"><text string="VOICES 1-6" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_voices_7_12"><text string="VOICES 7-12" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_plus"><text string="+"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_minus"><text string="-"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<repeat count="10">
		<param name="num" start="0" increment="1"/>
		<element name="txt_~num~"><text string="~num~"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	</repeat>

	<element name="txt_mod_src_x_sel">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string=" MODULATION SOURCE/X SELECT" align="1"><color red="0.80" green="0.80" blue="0.80"/></text>
	</element>
	<element name="txt_mod_src_sel">
		<text string="MODULATION SOURCE SELECT" align="1"><color red="0.90" green="0.90" blue="0.90"/></text>
	</element>
	<element name="txt_x_sel"><text string="X SELECT" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_release"><text string="RELEASE"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a1"><text string="LEVER 1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a2"><text string="LEVER 2"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a3"><text string="PEDAL 1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a4"><text string="PEDAL 2"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a5"><text string="VIB"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a6"><text string="KEYBOARD"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a7"><text string="LAG"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_a8"><text string="VELOCITY"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_b1"><text string="VELOCITY"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_b2"><text string="PRESSURE"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_b3"><text string="ENV X"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_b4"><text string="LFO X"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_b5"><text string="TRACK X"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_mod_label_b6"><text string="RAMP X"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_sel_label_b1"><text string="9"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_sel_label_b2"><text string="0"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_sel_label_b3"><text string="+"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_sel_label_b4"><text string="-"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_sel_label_b5"><text string="QUANTIZE"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_sel_label_b6"><text string="CLEAR"><color red="1.0" green="1.0" blue="1.0"/></text></element>

	<element name="txt_audio_out">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string="AUDIO OUT"><color red="0.90" green="0.90" blue="0.90"/></text>
	</element>
	<element name="txt_left"><text string="LEFT" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_mono"><text string="MONO"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_right"><text string="RIGHT" align="2"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_trigger"><text string="TRIGGER"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_trig_in"><text string="IN"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_pedal_input"><text string="PEDAL INPUT"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_advance"><text string="ADVANCE"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_chain"><text string="CHAIN"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_cassette"><text string="CASSETTE"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_to"><text string="TO" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_from"><text string="FROM" align="2"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_midi">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string="MIDI"><color red="0.90" green="0.90" blue="0.90"/></text>
	</element>
	<element name="txt_midi_in"><text string="IN" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_midi_out"><text string="OUT"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_midi_thru"><text string="THRU" align="2"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_mem_protect"><text string="MEMORY PROTECT"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_on"><text string="ON" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_off"><text string="OFF" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_page_mod">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string=" PAGE MODIFIER" align="1"><color red="0.80" green="0.80" blue="0.80"/></text>
	</element>
	<element name="txt_switch_mode"><text string="SWITCH MODE" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>
	<element name="txt_modulation"><text string="MODULATION" align="1"><color red="0.65" green="0.80" blue="0.40"/></text></element>
	<element name="txt_page_select"><text string="PAGE SELECT" align="1"><color red="0.65" green="0.80" blue="0.40"/></text></element>
	<element name="txt_on_off"><text string="ON / OFF" align="1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_value_x"><text string="VALUE X" align="1"><color red="1.0" green="1.0" blue="1.0"/></text></element>
	<element name="txt_page_2"><text string="PAGE 2" align="1"><color red="0.90" green="0.90" blue="0.90"/></text></element>

	<element name="txt_page_sel">
		<rect><color red="0.30" green="0.30" blue="0.30"/></rect>
		<text string=" SINGLE/MULTI PATCH PAGE SELECT" align="1"><color red="0.80" green="0.80" blue="0.80"/></text>
	</element>
	<element name="txt_levers">
		<rect><color red="0.20" green="0.20" blue="0.20"/></rect>
		<text string=" LEVERS" align="1"><color red="0.80" green="0.80" blue="0.80"/></text>
	</element>

	<element name="case_grey"><rect><color red="0.30" green="0.30" blue="0.30"/></rect></element>
	<element name="case_dark"><rect><color red="0.20" green="0.20" blue="0.20"/></rect></element>
	<element name="case_shadow"><rect><color red="0.10" green="0.10" blue="0.10"/></rect></element>
	<element name="wood"><rect><color red="0.50" green="0.25" blue="0.10"/></rect></element>
	<element name="dark_wood"><rect><color red="0.25" green="0.10" blue="0.05"/></rect></element>
	<element name="blue_line"><rect><color red="0.25" green="0.50" blue="0.70"/></rect></element>
	<element name="white_line"><rect><color red="0.75" green="0.75" blue="0.75"/></rect></element>
	<element name="cyan_line"><rect><color red="0.65" green="0.75" blue="0.75"/></rect></element>
	<element name="grey_line"><rect><color red="0.60" green="0.60" blue="0.60"/></rect></element>
	<element name="green_line"><rect><color red="0.60" green="0.70" blue="0.30"/></rect></element>
	<element name="black_rect"><rect><color red="0" green="0" blue="0"/></rect></element>
	<element name="transparent"><rect><color red="0" green="0" blue="0" alpha="0"/></rect></element>

	<element name="plugin_warning" defstate="1">
		<rect state="1"><color red="1" green="1" blue="0" alpha="0.2"/></rect>
		<text state="1" string="*** to control levers and knobs with a mouse, enable the layout plugin ***">
			<color red="0.9" green="0.9" blue="0.9"/>
		</text>
	</element>

	<element name="patch_edit_lines">
		<image><data><![CDATA[
			<svg width="150" height="28">
				<g stroke="#a6bfbf" stroke-width="1" fill="none">
					<polyline points=" 24,1  24,14  13,23  13,27"/>
					<polyline points=" 45,1  45,14  38,20  38,27"/>
					<polyline points=" 66,1  66,14  63,17  63,27"/>
					<polyline points=" 84,1  84,14  87,17  87,27"/>
					<polyline points="105,1 105,14 112,20 112,27"/>
					<polyline points="126,1 126,14 137,23 137,27"/>
				</g>
			</svg>
		]]></data></image>
	</element>

	<element name="led">
		<disk>
			<color state="0" red="0.45" green="0.25" blue="0.25"/>
			<color state="1" red="0.85" green="0.35" blue="0.40"/>
		</disk>
	</element>

	<element name="button">
		<image state="0"><data><![CDATA[
			<svg width="25" height="25">
				<rect x="0.5" y="0.5" width="24" height="24" rx="1" ry="1" fill="#393939" stroke="#000000" stroke-width="1"/>
				<circle cx="12.5" cy="12.5" r="9" fill="#424242" stroke="#212121" stroke-width="1"/>
			</svg>
		]]></data></image>
		<image state="1"><data><![CDATA[
			<svg width="25" height="25">
				<rect x="0.5" y="0.5" width="24" height="24" rx="1" ry="1" fill="#303030" stroke="#000000" stroke-width="1"/>
				<circle cx="12.5" cy="12.5" r="8.5" fill="#353535" stroke="#212121" stroke-width="1"/>
			</svg>
		]]></data></image>
	</element>

	<element name="red_button">
		<image state="0"><data><![CDATA[
			<svg width="25" height="25">
				<rect x="0.5" y="0.5" width="24" height="24" rx="2" ry="2" fill="#aa350f" stroke="#000000" stroke-width="1"/>
				<circle cx="12.5" cy="12.5" r="9" fill="#b64624" stroke="#4a1505" stroke-width="1"/>
			</svg>
		]]></data></image>
		<image state="1"><data><![CDATA[
			<svg width="25" height="25">
				<rect x="0.5" y="0.5" width="24" height="24" rx="1" ry="1" fill="#8e2c0c" stroke="#000000" stroke-width="1"/>
				<circle cx="12.5" cy="12.5" r="8.5" fill="#91381c" stroke="#4a1505" stroke-width="1"/>
			</svg>
		]]></data></image>
	</element>

	<element name="knob">
		<image state="0"><data><![CDATA[
			<svg width="39" height="39">
				<circle cx="19.5" cy="19.5" r="19.5" fill="#252525" stroke-width="0"/>
				<circle cx="19.5" cy="19.5" r="9" fill="#424242" stroke="#303030" stroke-width="4"/>
			</svg>
		]]></data></image>
		<image state="1"><data><![CDATA[
			<svg width="39" height="39">
				<circle cx="19.5" cy="19.5" r="19.5" fill="#303030" stroke-width="0"/>
				<circle cx="19.5" cy="19.5" r="9" fill="#575757" stroke="#404040" stroke-width="4"/>
				<polygon fill="#808080" points="1,19.5 7,16 7,23"/>
				<polygon fill="#808080" points="38,19.5 32,16 32,23"/>
			</svg>
		]]></data></image>
	</element>
	<element name="knob_dot"><disk><color red="0.70" green="0.70" blue="0.70"/></disk></element>
	<element name="knob_value"><simplecounter digits="1"><color red="0.90" green="0.90" blue="0.90"/></simplecounter></element>

	<group name="knob">
		<element ref="knob" id="~knob_id~"><bounds x="0" y="0" width="39" height="39"/></element>
		<element ref="knob_dot" id="~knob_id~_dot"><bounds x="17" y="3" width="5" height="5"/></element>
	</group>

	<element name="vfd_background"><rect><color red="0.05" green="0.50" blue="0.35"/></rect></element>
	<element name="vfd_char"><led14seg><color red="0.00" green="1.00" blue="0.80"/></led14seg></element>
	<element name="vfd_line">
		<rect>
			<color state="0" red="0.00" green="1.00" blue="0.80" alpha="0.13"/>
			<color state="1" red="0.00" green="1.00" blue="0.80" alpha="0.80"/>
		</rect>
	</element>

	<group name="vfd">
		<element ref="vfd_background">
			<bounds x="0" y="0" width="295" height="30"/>
		</element>
		<repeat count="40">
			<param name="char_i" start="1" increment="1"/>
			<param name="char_x" start="7" increment="7"/>
			<element ref="vfd_char" name="vfd_~vfd_id~_char_~char_i~">
				<bounds x="~char_x~" y="10" width="6" height="9"/>
			</element>
			<element ref="vfd_line" name="vfd_~vfd_id~_line_~char_i~">
				<bounds x="~char_x~" y="22" width="5" height="1"/>
			</element>
		</repeat>
	</group>

	<element name="lever_well">
		<rect>
			<bounds x="0" y="0" width="70" height="80"/>
			<color red="0.15" green="0.15" blue="0.15"/>
		</rect>
		<rect>
			<bounds x="4" y="4" width="62" height="72"/>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>
	<element name="lever_bg"><rect><color red="0.10" green="0.10" blue="0.10"/></rect></element>
	<element name="lever_knob"><rect><color red="0.20" green="0.20" blue="0.20"/></rect></element>

	<group name="lever">
		<element ref="lever_bg" id="~lever_id~"><bounds x="0" y="0" width="28" height="72"/></element>
		<element ref="lever_knob" id="~lever_id~_knob">
			<animate inputtag="~lever_id~" inputmask="0xffff"/>
			<bounds state="100" x="0" y="0" width="28" height="14"/>
			<bounds state="0" x="0" y="58" width="28" height="14"/>
		</element>
	</group>

	<element name="whitekey">
		<rect>
			<color state="0" red="0.90" green="0.90" blue="0.90"/>
			<color state="1" red="0.50" green="0.50" blue="0.50"/>
		</rect>
	</element>

	<element name="blackkey">
		<rect>
			<bounds x="0" y="0" width="21" height="135"/>
			<color red="0.05" green="0.05" blue="0.05"/>
		</rect>
		<rect>
			<bounds x="2" y="8" width="17" height="125"/>
			<color state="0" red="0.20" green="0.20" blue="0.20"/>
			<color state="1" red="0.50" green="0.50" blue="0.50"/>
		</rect>
	</element>

	<group name="keyboard_octave">
		<bounds x="0" y="0" width="245" height="210"/>
		<element ref="whitekey"><bounds x="1" y="0" width="33" height="210"/></element><!-- C -->
		<element ref="whitekey"><bounds x="36" y="0" width="33" height="210"/></element><!-- D -->
		<element ref="whitekey"><bounds x="71" y="0" width="33" height="210"/></element><!-- E -->
		<element ref="whitekey"><bounds x="106" y="0" width="33" height="210"/></element><!-- F -->
		<element ref="whitekey"><bounds x="141" y="0" width="33" height="210"/></element><!-- G -->
		<element ref="whitekey"><bounds x="176" y="0" width="33" height="210"/></element><!-- A -->
		<element ref="whitekey"><bounds x="211" y="0" width="33" height="210"/></element><!-- B -->
		<element ref="blackkey"><bounds x="21" y="0" width="21" height="135"/></element><!-- C# -->
		<element ref="blackkey"><bounds x="63" y="0" width="21" height="135"/></element><!-- D# -->
		<element ref="blackkey"><bounds x="125" y="0" width="21" height="135"/></element><!-- F# -->
		<element ref="blackkey"><bounds x="164" y="0" width="21" height="135"/></element><!-- G# -->
		<element ref="blackkey"><bounds x="204" y="0" width="21" height="135"/></element><!-- A# -->
	</group>

	<group name="case">
		<bounds x="0" y="0" width="1500" height="750"/>

		<!-- Case -->

		<element ref="wood"><bounds x="8" y="8" width="22" height="735"/></element>
		<element ref="dark_wood"><bounds x="30" y="526" width="14" height="210"/></element>
		<element ref="wood"><bounds x="1470" y="8" width="22" height="735"/></element>
		<element ref="dark_wood"><bounds x="1456" y="526" width="14" height="210"/></element>

		<element ref="case_dark"><bounds x="30" y="12" width="1440" height="22"/></element>
		<element ref="case_grey"><bounds x="30" y="34" width="1440" height="386"/></element>
		<element ref="case_dark"><bounds x="30" y="420" width="1440" height="86"/></element>
		<element ref="case_shadow"><bounds x="30" y="506" width="1440" height="20"/></element>

		<!-- I/O labels -->

		<element ref="white_line"><bounds x="190" y="49" width="80" height="1"/></element>
		<element ref="txt_audio_out"><bounds x="208" y="46" width="44" height="8"/></element>
		<element ref="txt_left"><bounds x="190" y="37" width="24" height="6"/></element>
		<element ref="txt_mono"><bounds x="215" y="37" width="30" height="6"/></element>
		<element ref="txt_right"><bounds x="246" y="37" width="24" height="6"/></element>

		<element ref="txt_trigger"><bounds x="814" y="37" width="36" height="6"/></element>
		<element ref="txt_trig_in"><bounds x="814" y="43" width="36" height="6"/></element>
		<element ref="txt_pedal_input"><bounds x="848" y="47" width="44" height="6"/></element>
