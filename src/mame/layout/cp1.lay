<?xml version="1.0"?>
<!--
license:CC0-1.0
-->
<mamelayout version="2">

<!-- define elements -->

	<element name="rect"><rect /></element>

	<repeat count="10">
		<param name="n" start="0" increment="1" />
		<element name="text_~n~"><text string="~n~" /></element>
	</repeat>

	<element name="text_kosmos"><text string="kosmos" /></element>
	<element name="text_port2"><text string="Port 2  Ausgang/Output" /></element>
	<element name="text_port1"><text string="Port 1  Eingang/Input" /></element>
	<element name="text_cp1"><text string="CP1  Computer-Praxis" /></element>

	<element name="led" defstate="0">
		<disk><color red="0.23" green="0.05" blue="0.05" /></disk>
		<disk state="0"><bounds x="0.11" y="0.11" width="0.78" height="0.78" /><color red="0.35" green="0.06" blue="0.06" /></disk>
		<disk state="1"><bounds x="0.11" y="0.11" width="0.78" height="0.78" /><color red="1.0" green="0.23" blue="0.14" /></disk>
		<disk state="1"><bounds x="0.25" y="0.25" width="0.3" height="0.3" /><color red="1.0" green="0.82" blue="0.75" /></disk>
	</element>

	<element name="switch" defstate="1">
		<rect><bounds x="0" y="0" width="16" height="40" /><color red="0.09" green="0.09" blue="0.09" /></rect>
		<rect state="1"><bounds x="3" y="3" width="10" height="15" /><color red="0.83" green="0.83" blue="0.82" /></rect>
		<rect state="0"><bounds x="3" y="22" width="10" height="15" /><color red="0.83" green="0.83" blue="0.82" /></rect>
	</element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.23" blue="0.16" /></led7seg>
	</element>

	<element name="key" defstate="0">
		<rect><bounds x="0" y="0" width="36" height="28" /><color red="0.6" green="0.6" blue="0.59" /></rect>
		<rect><bounds x="0" y="0" width="34" height="26" /><color red="1.0" green="1.0" blue="1.0" /></rect>
		<rect state="0"><bounds x="2" y="2" width="32" height="24" /><color red="0.9" green="0.9" blue="0.89" /></rect>
		<rect state="1"><bounds x="2" y="2" width="32" height="24" /><color red="0.95" green="0.76" blue="0.1" /></rect>
	</element>

	<element name="key_wide" defstate="0">
		<rect><bounds x="0" y="0" width="76" height="28" /><color red="0.6" green="0.6" blue="0.59" /></rect>
		<rect><bounds x="0" y="0" width="74" height="26" /><color red="1.0" green="1.0" blue="1.0" /></rect>
		<rect state="0"><bounds x="2" y="2" width="72" height="24" /><color red="0.9" green="0.9" blue="0.89" /></rect>
		<rect state="1"><bounds x="2" y="2" width="72" height="24" /><color red="0.95" green="0.76" blue="0.1" /></rect>
	</element>

	<!-- the function keys carry their English and German names -->
	<element name="label_step">
		<text string="STEP"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Schritt"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_stp">
		<text string="STP"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Stopp"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_run">
		<text string="RUN"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Lauf"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_cal">
		<text string="CAL"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Cass. lesen"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_clr">
		<text string="CLR"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Irrtum"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_acc">
		<text string="ACC"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Akku"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_cas">
		<text string="CAS"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Cass. speichern"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_pc">
		<text string="PC"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="Programmzähler"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_out">
		<text string="OUT"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="auslesen"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>
	<element name="label_inp">
		<text string="INP"><bounds x="0" y="0" width="76" height="12" /><color red="0.08" green="0.08" blue="0.08" /></text>
		<text string="eingeben"><bounds x="0" y="13" width="76" height="7" /><color red="0.19" green="0.19" blue="0.48" /></text>
	</element>

<!-- build screen -->

	<view name="Internal Layout">
		<bounds x="0" y="0" width="608" height="402" />

		<element ref="rect"><bounds x="0" y="0" width="608" height="402" /><color red="0.24" green="0.27" blue="0.26" /></element>

		<!-- I/O module: Port 2 LEDs, Port 1 switches -->
		<element ref="rect"><bounds x="8" y="0" width="592" height="104" /><color red="0.15" green="0.17" blue="0.17" /></element>
		<element ref="rect"><bounds x="10" y="0" width="588" height="102" /><color red="0.2" green="0.22" blue="0.22" /></element>
		<element ref="text_kosmos"><bounds x="10" y="2" width="60" height="12" /><color red="0.85" green="0.85" blue="0.85" /></element>
		<element ref="text_port2"><bounds x="88" y="2" width="200" height="12" /><color red="0.85" green="0.85" blue="0.85" /></element>
		<element ref="text_port1"><bounds x="368" y="2" width="200" height="12" /><color red="0.85" green="0.85" blue="0.85" /></element>

		<repeat count="8">
			<param name="i" start="0" increment="1" />
			<param name="n" start="1" increment="1" />
			<param name="mask" start="0x01" lshift="1" />
			<param name="led_x" start="67" increment="32" />
			<param name="sw_x" start="348" increment="32" />
			<element name="p2_led~i~" ref="led"><bounds x="~led_x~" y="43" width="18" height="18" /></element>
			<element ref="text_~n~"><bounds x="~led_x~" y="82" width="18" height="12" /><color red="0.54" green="0.54" blue="0.56" /></element>
			<element ref="switch" inputtag="PORT1" inputmask="~mask~" inputraw="yes"><bounds x="~sw_x~" y="36" width="16" height="40" /></element>
			<element ref="text_~n~"><bounds x="~sw_x~" y="82" width="16" height="12" /><color red="0.54" green="0.54" blue="0.56" /></element>
		</repeat>

		<!-- display -->
		<element ref="rect"><bounds x="26" y="128" width="302" height="88" /><color red="0.17" green="0.17" blue="0.17" /></element>
		<element ref="rect"><bounds x="30" y="132" width="294" height="80" /><color red="0.12" green="0.02" blue="0.02" /></element>
		<element name="digit5" ref="digit"><bounds x="42" y="144" width="40" height="56" /></element>
		<element name="digit4" ref="digit"><bounds x="98" y="144" width="40" height="56" /></element>
		<element name="digit3" ref="digit"><bounds x="138" y="144" width="40" height="56" /></element>
		<element name="digit2" ref="digit"><bounds x="194" y="144" width="40" height="56" /></element>
		<element name="digit1" ref="digit"><bounds x="234" y="144" width="40" height="56" /></element>
		<element name="digit0" ref="digit"><bounds x="274" y="144" width="40" height="56" /></element>

		<element ref="text_kosmos"><bounds x="418" y="160" width="100" height="14" /></element>
		<element ref="text_cp1"><bounds x="368" y="179" width="200" height="12" /><color red="0.85" green="0.85" blue="0.85" /></element>

		<!-- keyboard -->
		<element ref="rect"><bounds x="26" y="239" width="556" height="148" /><color red="0.03" green="0.03" blue="0.03" /></element>
		<element ref="rect"><bounds x="28" y="241" width="552" height="144" /><color red="0.07" green="0.07" blue="0.07" /></element>

		<!-- digit keys 0-7 -->
		<repeat count="2">
			<param name="line" start="4" increment="-1" />
			<param name="first" start="0" increment="4" />
			<param name="first_x" start="38" increment="160" />
			<repeat count="4">
				<param name="n" start="~first~" increment="1" />
				<param name="mask" start="0x01" lshift="1" />
				<param name="x" start="~first_x~" increment="40" />
				<element ref="key" inputtag="LINE~line~" inputmask="~mask~"><bounds x="~x~" y="251" width="36" height="28" /></element>
				<element ref="text_~n~"><bounds x="~x~" y="258" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
			</repeat>
		</repeat>
		<element ref="key" inputtag="LINE2" inputmask="0x01"><bounds x="358" y="251" width="36" height="28" /></element>
		<element ref="text_8"><bounds x="358" y="258" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
		<element ref="key" inputtag="LINE2" inputmask="0x02"><bounds x="398" y="251" width="36" height="28" /></element>
		<element ref="text_9"><bounds x="398" y="258" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>

		<!-- function keys -->
		<element ref="key_wide" inputtag="LINE1" inputmask="0x02"><bounds x="78" y="283" width="76" height="28" /></element>
		<element ref="label_step"><bounds x="78" y="287" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE1" inputmask="0x04"><bounds x="158" y="283" width="76" height="28" /></element>
		<element ref="label_stp"><bounds x="158" y="287" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE1" inputmask="0x08"><bounds x="238" y="283" width="76" height="28" /></element>
		<element ref="label_run"><bounds x="238" y="287" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE1" inputmask="0x01"><bounds x="318" y="283" width="76" height="28" /></element>
		<element ref="label_cal"><bounds x="318" y="287" width="76" height="20" /></element>

		<element ref="key_wide" inputtag="LINE0" inputmask="0x02"><bounds x="118" y="315" width="76" height="28" /></element>
		<element ref="label_clr"><bounds x="118" y="319" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE0" inputmask="0x08"><bounds x="198" y="315" width="76" height="28" /></element>
		<element ref="label_acc"><bounds x="198" y="319" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE0" inputmask="0x01"><bounds x="278" y="315" width="76" height="28" /></element>
		<element ref="label_cas"><bounds x="278" y="319" width="76" height="20" /></element>

		<element ref="key_wide" inputtag="LINE0" inputmask="0x04"><bounds x="118" y="347" width="76" height="28" /></element>
		<element ref="label_pc"><bounds x="118" y="351" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE2" inputmask="0x04"><bounds x="198" y="347" width="76" height="28" /></element>
		<element ref="label_out"><bounds x="198" y="351" width="76" height="20" /></element>
		<element ref="key_wide" inputtag="LINE2" inputmask="0x08"><bounds x="278" y="347" width="76" height="28" /></element>
		<element ref="label_inp"><bounds x="278" y="351" width="76" height="20" /></element>

		<!-- number block, wired in parallel with the digit keys -->
		<element ref="key" inputtag="LINE3" inputmask="0x08"><bounds x="454" y="251" width="36" height="28" /></element>
		<element ref="text_7"><bounds x="454" y="258" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
		<element ref="key" inputtag="LINE2" inputmask="0x01"><bounds x="494" y="251" width="36" height="28" /></element>
		<element ref="text_8"><bounds x="494" y="258" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
		<element ref="key" inputtag="LINE2" inputmask="0x02"><bounds x="534" y="251" width="36" height="28" /></element>
		<element ref="text_9"><bounds x="534" y="258" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
		<repeat count="3">
			<param name="n" start="4" increment="1" />
			<param name="mask" start="0x01" lshift="1" />
			<param name="x" start="454" increment="40" />
			<element ref="key" inputtag="LINE3" inputmask="~mask~"><bounds x="~x~" y="283" width="36" height="28" /></element>
			<element ref="text_~n~"><bounds x="~x~" y="290" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
		</repeat>
		<repeat count="3">
			<param name="n" start="1" increment="1" />
			<param name="mask" start="0x02" lshift="1" />
			<param name="x" start="454" increment="40" />
			<element ref="key" inputtag="LINE4" inputmask="~mask~"><bounds x="~x~" y="315" width="36" height="28" /></element>
			<element ref="text_~n~"><bounds x="~x~" y="322" width="36" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
		</repeat>
		<element ref="key_wide" inputtag="LINE4" inputmask="0x01"><bounds x="454" y="347" width="76" height="28" /></element>
		<element ref="text_0"><bounds x="454" y="354" width="76" height="14" /><color red="0.08" green="0.08" blue="0.08" /></element>
	</view>
</mamelayout>
