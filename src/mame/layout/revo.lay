	<view name="Digitiser Overlay (no icons)">
		<bounds left="0" right="527" top="0" bottom="224" />
		<screen index="0">
			<bounds left="0" right="527" top="0" bottom="208" />
		</screen>

		<element ref="overlay_left">
			<bounds x="0" y="0" width="30" height="178" />
