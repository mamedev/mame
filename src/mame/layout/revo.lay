<mamelayout version="2">

	<element name="overlay_left">
		<!-- background -->
		<rect>
			<bounds x="0" y="0" width="30" height="260" />
			<color red="0.73" green="0.83" blue="0.75" />
		</rect>

		<!-- icons (placeholder) -->
		<text string="Menu">
			<bounds x="2.5" y="16" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>

		<text string="Cut">
			<bounds x="2.5" y="56" width="25" height="16" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
