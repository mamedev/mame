<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders: Roberto Fresca

**********************************************

  Rula layout.
  Background, field, and 37 LEDs roulette.

  Vertical design.

**********************************************
-->
<mamelayout version="2">

	<!-- Background 4:3, 1600x1200 -->
	<element name="bg_adjust">
		<rect>
			<bounds x="0" y="0" width="1600" height="1200" />
			<color red="0.0" green="0.1" blue="0.0" />
		</rect>
	</element>

	<!-- Static element to simulate physically the roulette -->
	<element name="roulette">
		<!-- 1. External plate -->
		<disk>
			<bounds x="0" y="0" width="100" height="100" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<!-- 2. Intermediate channel, where the LEDs will be placed -->
		<disk>
			<bounds x="6" y="6" width="88" height="88" />
			<color red="0.05" green="0.05" blue="0.05" />
		</disk>
		<!-- 3. Center plate of the roulette -->
		<disk>
			<bounds x="16" y="16" width="68" height="68" />
			<color red="0.10" green="0.10" blue="0.10" />
		</disk>
		<!-- 4. Intermediate disk for the cone -->
		<disk>
			<bounds x="36" y="36" width="28" height="28" />
			<color red="0.20" green="0.20" blue="0.20" />
		</disk>
		<!-- 5. Spindle of the turret -->
		<disk>
			<bounds x="44" y="44" width="12" height="12" />
			<color red="0.0" green="0.0" blue="0.0" />
		</disk>
		<!-- 6. Roulette turret (horizontal piece) -->
		<rect>
			<bounds x="30" y="48" width="40" height="4" />
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
		<!-- 7. Roulette turret (verticalal piece) -->
		<rect>
			<bounds x="48" y="30" width="4" height="40" />
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<!-- Dynamic elements for green/red LEDs -->
	<element name="BALL0">
		<disk state = "0">
			<color red="0.0" green="0.3" blue="0" />
		</disk>
		<disk state = "1">
			<color red="0" green="1" blue="0" />
		</disk>
	</element>

	<element name="BALL">
		<disk state = "0">
			<color red="0.3" green="0" blue="0" />
		</disk>
		<disk state = "1">
			<color red="1" green="0" blue="0" />
		</disk>
	</element>

	<view name="Lamps">

		<!-- Forced BG 4:3 (real layout margins) -->
		<element ref="bg_adjust">
			<bounds x="0" y="0" width="1600" height="1200" />
		</element>

		<!-- Game screen -->
		<screen index="0">
			<bounds left="28" top="32" right="880" bottom="1168" />
		</screen>

		<!-- Roulette structure -->
		<element ref="roulette">
			<bounds x="1031.50" y="190.50" width="417" height="417" />
		</element>

		<!-- Roulette LEDs -->
		<element name="lamp0" ref="BALL0">
			<bounds x="1366.86330" y="279.26824" width="24" height="24" />
		</element>
		<element name="lamp1" ref="BALL">
			<bounds x="1383.34769" y="304.05396" width="24" height="24" />
		</element>
		<element name="lamp2" ref="BALL">
			<bounds x="1395.40620" y="331.26901" width="24" height="24" />
		</element>
		<element name="lamp3" ref="BALL">
			<bounds x="1402.69186" y="360.13052" width="24" height="24" />
		</element>
		<element name="lamp4" ref="BALL">
			<bounds x="1404.99512" y="389.80815" width="24" height="24" />
		</element>
		<element name="lamp5" ref="BALL">
			<bounds x="1402.24970" y="419.44817" width="24" height="24" />
		</element>
