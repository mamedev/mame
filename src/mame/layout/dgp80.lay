<mamelayout version="2">
	<element name="digit" defstate="0">
		<led7seg>
			<color red="0.75" green="0.0" blue="0.0" />
		</led7seg>
	</element>
	<element name="background">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<view name="Default Layout">
		<!-- Black background -->
		<element ref="background">
			<bounds left="00" top="00" right="195" bottom="60" />
		</element>

		<element name="dg1" ref="digit">
			<bounds x="10" y="10" width="25" height="40" />
		</element>
		<element name="dg2" ref="digit">
			<bounds x="35" y="10" width="25" height="40" />
		</element>
		<element name="dg3" ref="digit">
			<bounds x="60" y="10" width="25" height="40" />
		</element>
		<element name="dg4" ref="digit">
			<bounds x="85" y="10" width="25" height="40" />
		</element>
		<element name="dg5" ref="digit">
			<bounds x="135" y="10" width="25" height="40" />
		</element>
		<element name="dg6" ref="digit">
			<bounds x="160" y="10" width="25" height="40" />
		</element>
	</view>
</mamelayout>
