<!-- View field -->

	<view name="AWP Simulated Video" showpointers="no">

	<!-- Screen size -->

		<element ref="screen_background_color">
			<bounds x="0" y="0" width="640" height="480"/>
		</element>

	<!-- Frame lamps -->

		<!-- Frame top lmap -->
		<element name="lamp_frame0" ref="LFRAME0">
			<bounds x="230" y="5" width="60" height="35"/>
		</element>
		<element name="lamp_frame1" ref="LFRAME1">
			<bounds x="290" y="5" width="60" height="35"/>
		</element>
		<element name="lamp_frame2" ref="LFRAME2">
			<bounds x="350" y="5" width="60" height="35"/>
		</element>

		<!-- "Rock'n Roll" lmap left -->
		<element name="lamp_frame3" ref="LFRAME3">
			<bounds x="115" y="45" width="100" height="35"/>
		</element>
		<!-- "7 7 7" lmap -->
		<element name="lamp_frame4" ref="LFRAME4">
			<bounds x="230" y="45" width="60" height="35"/>
		</element>
		<element name="lamp_frame5" ref="LFRAME5">
			<bounds x="290" y="45" width="60" height="35"/>
		</element>
		<element name="lamp_frame6" ref="LFRAME6">
			<bounds x="350" y="45" width="60" height="35"/>
		</element>
		<!-- "Rock'n Roll" lmap right -->
		<element name="lamp_frame7" ref="LFRAME7">
			<bounds x="425" y="45" width="100" height="35"/>
		</element>

	<!-- Betline lamps -->

		<element name="lamp_betline3" ref="LBETLINE3">
			<bounds x="20" y="110" width="80" height="40"/>
		</element>
		<element name="lamp_betline1" ref="LBETLINE1">
			<bounds x="20" y="160" width="80" height="40"/>
		</element>
		<element name="lamp_betline0" ref="LBETLINE0">
			<bounds x="20" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_betline2" ref="LBETLINE2">
			<bounds x="20" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_betline4" ref="LBETLINE4">
			<bounds x="20" y="310" width="80" height="40"/>
		</element>

	<!-- Stop lamp -->

		<element name="lamp_stop0" ref="LSTOP0">
			<bounds x="150" y="340" width="60" height="40"/>
		</element>
		<element name="lamp_stop1" ref="LSTOP1">
			<bounds x="290" y="340" width="60" height="40"/>
		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="430" y="340" width="60" height="40"/>
		</element>

	<!-- Start lamp -->

		<element name="lamp_start" ref="LSTART">
			<bounds x="480" y="92" width="80" height="20"/>
		</element>

	<!-- (Insert) medal lamp -->

		<element name="lamp_insert" ref="LINSERT">
			<bounds x="480" y="112" width="80" height="20"/>
		</element>

	<!-- Gameover lamp -->

		<element name="lamp_gameover" ref="LGAMEOVER">
			<bounds x="540" y="92" width="40" height="40"/>
		</element>

	<!-- Credit lamp -->

		<element name="led_button0" ref="LED_BUTTON0">
			<bounds x="540" y="240" width="30" height="23"/>
		</element>

	<!-- Payout lamp -->

		<element name="lamp_payout" ref="LPAYOUT">
			<bounds x="540" y="280" width="30" height="23"/>
		</element>

	<!-- Bonus count lamp ("1 2 3") -->

		<element name="lamp_bcount0" ref="LBCOUNT0">
			<bounds x="540" y="198" width="20" height="20"/>
		</element>
		<element name="lamp_bcount1" ref="LBCOUNT1">
			<bounds x="570" y="198" width="20" height="20"/>
		</element>
		<element name="lamp_bcount2" ref="LBCOUNT2">
			<bounds x="600" y="198" width="20" height="20"/>
		</element>

	<!-- Bonus count SEG -->

		<element name="seg_bonus" ref="digit">
			<bounds x="572" y="156" width="14" height="23"/>
		</element>

	<!-- Credit SEG -->

		<element name="seg_credit0" ref="digit">
			<bounds x="574" y="240" width="14" height="23"/>
		</element>
		<element name="seg_credit1" ref="digit">
			<bounds x="590" y="240" width="14" height="23"/>
		</element>

	<!-- Payout SEG -->

		<element name="seg_payout0" ref="digit">
			<bounds x="574" y="280" width="14" height="23"/>
		</element>
		<element name="seg_payout1" ref="digit">
			<bounds x="590" y="280" width="14" height="23"/>
		</element>

	<!-- Reel -->

		<repeat count="3">
			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>

		<!-- Reel lamp -->

			<element name="lamp_reel~i~_0" ref="LREEL~i~_0">
				<bounds x="~x~" y="140" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_1" ref="LREEL~i~_1">
				<bounds x="~x~" y="200" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_2" ref="LREEL~i~_2">
				<bounds x="~x~" y="260" width="120" height="60"/>
			</element>

		<!-- Reel pattern -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Hopper & Coin solenoid -->

		<element name="signal_hopper" ref="SIGNALHOPPER">
			<bounds x="490" y="10" width="60" height="25"/>
		</element>
		<element name="signal_solenoid" ref="SIGNALSOLENOID">
			<bounds x="560" y="10" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="20" y="10" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="90" y="10" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
