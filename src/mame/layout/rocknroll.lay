<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>

	<element name="digit">
		<led7seg>
			<color red="1.0" green="0.2" blue="0.2"/>
		</led7seg>
	</element>

<!-- Frame lamps -->

	<!-- Frame top lamp -->
	<element name="LFRAME0" defstate="1">
		<rect state="0">
			<color red="0.2" green="0.1" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.1" blue="0.1"/>
