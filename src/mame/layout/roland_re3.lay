	<script><![CDATA[
		file:set_resolve_tags_callback(
			function()
				local view = file.views["Front Panel"]
				install_slider_callbacks(view)
				add_knob(view, "knob_INPUT", "INPUT", 2.5, VERTICAL, "dot_INPUT")
				add_knob(view, "knob_INPUT2", "INPUT2", 2.5, VERTICAL, "dot_INPUT2")
				add_knob(view, "knob_KNOB6", "KNOB6", 2.5, VERTICAL, "dot_KNOB6")
				add_knob(view, "knob_KNOB5", "KNOB5", 2.5, VERTICAL, "dot_KNOB5")
				add_knob(view, "knob_KNOB0", "KNOB0", 2.5, VERTICAL, "dot_KNOB0")
				add_knob(view, "knob_KNOB1", "KNOB1", 2.5, VERTICAL, "dot_KNOB1")
				add_knob(view, "knob_KNOB2", "KNOB2", 2.5, VERTICAL, "dot_KNOB2")
				view.items["warning"]:set_state(0)
			end)

		-----------------------------------------------------------------------
