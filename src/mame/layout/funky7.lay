<!-- View field -->

	<view name="AWP Simulated Video" showpointers="no">

	<!-- Screen size -->

		<bounds left="0" right="147" top="0" bottom="100"/>

		<element ref="static_bgcolor">
			<bounds left="0" right="147" top="0" bottom="100"/>
		</element>

	<!-- Digital back color -->

		<element name="digit0_back" ref="segbgcolor">
			<bounds x="34" y="8" width="80" height="55"/>
		</element>

	<!-- Digital -->

		<element name="digit0_red" ref="digit_red">
