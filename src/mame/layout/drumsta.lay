	</view>

	<script><![CDATA[
		file:set_resolve_tags_callback(function()
			local view = file.views["Front Panel"]
			local knobs, switches, pointers = {}, {}, {}
			for _, index in ipairs({23, 7, 3, 5, 1, 6, 2, 4, 0, 15, 11, 13, 9, 14, 10, 12, 8, 18, 22, 17, 21, 19}) do
				local port = file.device:ioport("AN" .. index)
				local field
				for _, candidate in pairs(port.fields) do field = candidate break end
				local item = view.items["knob" .. index]
				table.insert(knobs, {item = item, field = field})
			end
			do
				local field = file.device:ioport("SW0").fields["Tom Select"]
				local item = view.items["switch0"]
				table.insert(switches, {item = item, field = field, mask = 0x60, values = {32, 96, 64}})
			end
			do
				local field = file.device:ioport("SW0").fields["Write"]
				local item = view.items["switch1"]
				table.insert(switches, {item = item, field = field, mask = 0x80, values = {0, 128}})
			end
			do
				local field = file.device:ioport("SW1").fields["Rimshot / Handclap / Cowbell Select"]
				local item = view.items["switch2"]
				table.insert(switches, {item = item, field = field, mask = 0x60, values = {32, 96, 64}})
			end
			do
				local field = file.device:ioport("SW1").fields["Hi-Hat Select"]
				local item = view.items["switch3"]
				table.insert(switches, {item = item, field = field, mask = 0x80, values = {0, 128}})
			end
			do
				local field = file.device:ioport("SW2").fields["Conga Select"]
				local item = view.items["switch4"]
				table.insert(switches, {item = item, field = field, mask = 0x60, values = {32, 96, 64}})
			end
			do
				local field = file.device:ioport("SW2").fields["Cymbal Select"]
				local item = view.items["switch5"]
				table.insert(switches, {item = item, field = field, mask = 0x80, values = {0, 128}})
			end
			do
				local field = file.device:ioport("SW3").fields["Congas / Maracas / Claves Select"]
				local item = view.items["switch6"]
				table.insert(switches, {item = item, field = field, mask = 0x60, values = {32, 96, 64}})
			end
			view:set_pointer_updated_callback(function(kind, id, device, x, y, buttons, pressed)
				if (buttons & 1) == 0 then pointers[id] = nil return end
				if (pressed & 1) ~= 0 then
					for _, switch in ipairs(switches) do
						if switch.item.bounds:includes(x, y) then
							local value = switch.field.port:read() & switch.mask
							for n, option in ipairs(switch.values) do
								if value == option then switch.field.user_value = switch.values[n % #switch.values + 1] break end
							end
						end
					end
					for _, knob in ipairs(knobs) do
						if knob.item.bounds:includes(x, y) then
							pointers[id] = {knob = knob, y = y, value = knob.field.port:read()}
							break
						end
					end
				end
				local p = pointers[id]
				if p then
					local value = p.value + (p.y - y) * 100 / (p.knob.item.bounds.height * 3)
					p.knob.field.user_value = math.max(0, math.min(100, math.floor(value + 0.5)))
				end
			end)
			view:set_pointer_left_callback(function(kind, id) pointers[id] = nil end)
			view:set_pointer_aborted_callback(function(kind, id) pointers[id] = nil end)
			view:set_forget_pointers_callback(function() pointers = {} end)
			view.items["help"]:set_state(0)
		end)
	]]></script>
</mamelayout>
