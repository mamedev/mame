<?xml version="1.0"?>
<!--
license:CC0-1.0

Zenith Z-22 with a blank border around the active display

The screen is 80 x 25 characters on a 4:3 tube, so one character is
10 x 24 units here. The border is two characters at the left and right
and one character at the top and bottom.
-->

<mamelayout version="2">

	<element name="background"><rect><color red="0.0" green="0.0" blue="0.0" /></rect></element>

	<view name="Screen">
		<bounds left="0" top="0" right="840" bottom="648" />

		<element ref="background"><bounds x="0" y="0" width="840" height="648" /></element>

		<screen index="0">
			<bounds x="20" y="24" width="800" height="600" />
		</screen>
	</view>

</mamelayout>
