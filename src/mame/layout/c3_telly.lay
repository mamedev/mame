	<view name="Screen and Lamps">
		<bounds x="-144" y="-192" width="1056" height="960" />
		<element ref="panel">
			<bounds x="-144" y="-192" width="1056" height="960" />
		</element>

		<element ref="name_panel_frame">
			<bounds x="72" y="-168" width="552" height="108" />
		</element>
		<repeat count="5">
			<param name="n" start="14" increment="1" />
			<param name="group" start="5" increment="-1" />
			<param name="x" start="84" increment="52.8" />
			<element id="name_panel_telly_~group~" name="lamp~n~" ref="name_panel">
				<bounds x="~x~" y="-156" width="51.8" height="84" />
			</element>
		</repeat>
		<repeat count="5">
			<param name="n" start="19" increment="1" />
			<param name="group" start="5" increment="-1" />
			<param name="x" start="348" increment="52.8" />
			<element id="name_panel_addicts_~group~" name="lamp~n~" ref="name_panel">
