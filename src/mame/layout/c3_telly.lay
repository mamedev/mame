<!--
Physical control positioning is reconstructed from photographs of a Top of
the Pops Cobra 3 cabinet, the only known source for this cabinet layout.  The
Telly Addicts cabinet may differ, and the button shades are visual estimates.
The ten Telly and Addicts outputs are assumed to represent five illuminated
zones behind each half of the cabinet name panel.  The panel position, lamp
arrangement and purple logo colour have not been confirmed.
The coin-value text does not illuminate on the physical coin acceptor; its
highlighting here indicates the coin-channel acceptance state for convenience.
-->
<mamelayout version="2">
	<element name="panel">
		<rect>
			<color red="0.05" green="0.05" blue="0.05" />
		</rect>
	</element>
	<element name="coin_input">
		<rect>
			<color alpha="0.0" />
		</rect>
	</element>

	<element name="lamp_violet" defstate="0">
		<rect>
			<color red="0.01" green="0.01" blue="0.01" />
		</rect>
		<rect>
			<bounds x="0.10" y="0.10" width="0.80" height="0.80" />
			<color state="0" red="0.20" green="0.05" blue="0.24" />
			<color state="255" red="0.75" green="0.25" blue="0.90" />
		</rect>
	</element>
