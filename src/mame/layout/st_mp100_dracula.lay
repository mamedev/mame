<!-- Line colours -->

	<element name="Draw_Grey">
		<rect><color red="0.15" green="0.15" blue="0.15" /><bounds left="0" top="0" right="1" bottom="1" /></rect>
	</element>

	<!-- Reusable multi-digit display. Params: count, n0 (highest digit number), x0 (left edge), y (top) -->
	<group name="Digit_Display">
		<repeat count="~count~">
			<param name="n" start="~n0~" increment="-1" />
			<param name="x" start="~x0~" increment="14" />
			<element ref="Digit" name="digit~n~"><bounds x="~x~" y="~y~" width="10" height="15" /></element>
		</repeat>
	</group>


