<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>

	<element name="digit">
		<led7seg>
			<color red="1.0" green="0.2" blue="0.2"/>
		</led7seg>
	</element>

<!-- Frame lamp text -->

	<element name="TBIGCHANCE">
		<text string=" BIG CHANCE ">
			<color red="0.85" green="0.85" blue="0.85"/>
			<bounds x="0" y="0.15" width="1" height="1.0"/>
		</text>
	</element>
	<element name="T777" defstate="0">
		<text string=" 7   7   7 ">
			<color red="1.0" green="0.84" blue="0.0"/>
			<bounds x="0" y="0.15" width="1" height="1.0"/>
		</text>
	</element>

