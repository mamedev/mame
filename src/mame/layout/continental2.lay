<!-- View field -->

	<view name="AWP Simulated Video" showpointers="no">

	<!-- Screen size -->

		<element ref="screen_background_color">
			<bounds x="0" y="0" width="640" height="480"/>
		</element>

	<!-- Frame lamps -->

		<element name="lamp_frame0" ref="LFRAME0">
			<bounds x="0" y="0" width="105" height="50"/>
		</element>
		<element name="lamp_frame1" ref="LFRAME0">
			<bounds x="105" y="0" width="105" height="50"/>
		</element>

		<element name="lamp_frame2" ref="LFRAME1">
			<bounds x="215" y="0" width="52.5" height="50"/>
		</element>
		<element name="lamp_frame3" ref="LFRAME1">
			<bounds x="267.5" y="0" width="52.5" height="50"/>
		</element>
		<element name="lamp_frame4" ref="LFRAME1">
			<bounds x="320" y="0" width="52.5" height="50"/>
		</element>
		<element name="lamp_frame5" ref="LFRAME1">
			<bounds x="372.5" y="0" width="52.5" height="50"/>
		</element>

		<element name="lamp_frame6" ref="LFRAME2">
			<bounds x="430" y="0" width="105" height="50"/>
		</element>
		<element name="lamp_frame7" ref="LFRAME2">
			<bounds x="535" y="0" width="105" height="50"/>
		</element>

	<!-- Frame lamp text -->

		<element ref="TBIGCHANCE">
			<bounds x="0" y="8" width="210" height="30"/>
		</element>
		<element ref="T777">
			<bounds x="215" y="8" width="210" height="30"/>
		</element>
		<element ref="TBIGCHANCE">
			<bounds x="430" y="8" width="210" height="30"/>
		</element>

	<!-- Betline lamps -->

		<element name="lamp_betline3" ref="LBETLINE3">
			<bounds x="20" y="110" width="80" height="40"/>
		</element>
		<element name="lamp_betline1" ref="LBETLINE1">
			<bounds x="20" y="160" width="80" height="40"/>
		</element>
		<element name="lamp_betline0" ref="LBETLINE0">
			<bounds x="20" y="210" width="80" height="40"/>
		</element>
		<element name="lamp_betline2" ref="LBETLINE2">
			<bounds x="20" y="260" width="80" height="40"/>
		</element>
		<element name="lamp_betline4" ref="LBETLINE4">
			<bounds x="20" y="310" width="80" height="40"/>
		</element>

	<!-- Stop lamp -->

		<element name="lamp_stop0" ref="LSTOP0">
			<bounds x="150" y="340" width="60" height="40"/>
		</element>
		<element name="lamp_stop1" ref="LSTOP1">
			<bounds x="290" y="340" width="60" height="40"/>
		</element>
		<element name="lamp_stop2" ref="LSTOP2">
			<bounds x="430" y="340" width="60" height="40"/>
		</element>

	<!-- Gameover lamp -->

		<element name="lamp_gameover" ref="LGAMEOVER">
			<bounds x="540" y="95" width="80" height="40"/>
		</element>

	<!-- Credit lamp -->

		<element name="lamp_credit" ref="LCREDIT">
			<bounds x="540" y="145" width="80" height="40"/>
		</element>

	<!-- Win meter lamp -->

		<element name="lamp_payout" ref="LPAYOUT">
			<bounds x="540" y="245" width="80" height="40"/>
		</element>

	<!-- Insert medal lamp -->

		<element name="lamp_insert" ref="LINSERT">
			<bounds x="540" y="345" width="80" height="40"/>
		</element>

	<!-- Start lamp -->

		<element name="lamp_start" ref="LSTART">
			<bounds x="20" y="370" width="80" height="40"/>
		</element>

	<!-- Bonus count lamp ("1 2 3") -->

		<element name="lamp_bcount0" ref="LBCOUNT0">
			<bounds x="415" y="100" width="20" height="20"/>
		</element>
		<element name="lamp_bcount1" ref="LBCOUNT1">
			<bounds x="450" y="100" width="20" height="20"/>
		</element>
		<element name="lamp_bcount2" ref="LBCOUNT2">
			<bounds x="485" y="100" width="20" height="20"/>
		</element>

	<!-- Bonus count SEG -->

		<element name="seg_bonus" ref="digit">
			<bounds x="453" y="70" width="14" height="20"/>
		</element>

	<!-- Credit SEG -->

		<element name="seg_credit0" ref="digit">
			<bounds x="560" y="192" width="20" height="35"/>
		</element>
		<element name="seg_credit1" ref="digit">
			<bounds x="580" y="192" width="20" height="35"/>
		</element>

	<!-- Payout SEG -->

		<element name="seg_payout0" ref="digit">
			<bounds x="560" y="292" width="20" height="35"/>
		</element>
		<element name="seg_payout1" ref="digit">
			<bounds x="580" y="292" width="20" height="35"/>
		</element>

	<!-- Button LED -->

		<element name="led_button0" ref="LED_BUTTON0">
			<bounds x="20" y="430" width="40" height="40"/>
		</element>
		<element name="led_button1" ref="LED_BUTTON1">
			<bounds x="70" y="430" width="40" height="40"/>
		</element>

	<!-- Reel -->

		<repeat count="3">
			<param name="i" start="0" increment="1"/>
			<param name="x" start="120" increment="140"/>

		<!-- Reel lamp -->

			<element name="lamp_reel~i~_0" ref="LREEL~i~_0">
				<bounds x="~x~" y="140" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_1" ref="LREEL~i~_1">
				<bounds x="~x~" y="200" width="120" height="60"/>
			</element>
			<element name="lamp_reel~i~_2" ref="LREEL~i~_2">
				<bounds x="~x~" y="260" width="120" height="60"/>
			</element>

		<!-- Reel pattern -->

			<element ref="SREEL~i~">
				<bounds x="~x~" y="140" width="120" height="180"/>
				<yscroll name="reel~i~:scroll" size="0.15" wrap="yes" min="65536" max="0"/>
			</element>

		</repeat>

	<!-- Hopper & Coin solenoid -->

		<element name="signal_hopper" ref="SIGNALHOPPER">
			<bounds x="490" y="60" width="60" height="25"/>
		</element>
		<element name="signal_solenoid" ref="SIGNALSOLENOID">
			<bounds x="560" y="60" width="60" height="25"/>
		</element>

	<!-- Big bonus & Regular bonus signal -->

		<element name="signal_big" ref="SIGNALBIG">
			<bounds x="20" y="60" width="60" height="25"/>
		</element>
		<element name="signal_jac" ref="SIGNALJAC">
			<bounds x="90" y="60" width="60" height="25"/>
		</element>

	</view>
</mamelayout>
