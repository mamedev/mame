<mamelayout version="2">

<!-- Define elements -->

	<element name="screen_background_color">
		<rect>
			<color red="0.00" green="0.00" blue="0.00"/>
		</rect>
	</element>

	<element name="digit">
		<led7seg>
			<color red="1.0" green="0.2" blue="0.2"/>
		</led7seg>
	</element>

<!-- Frame lamps -->

	<element name="LFRAME" defstate="0">
		<rect state="0">
			<color red="0.3" green="0.1" blue="0.1"/>
		</rect>
		<rect state="1">
			<color red="1.0" green="0.3" blue="0.1"/>
		</rect>
	</element>

<!-- Bonus game count "777" lamp -->

	<element name="L7770" defstate="0">
