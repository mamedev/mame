<?xml version="1.0"?>
<!--
license:CC0-1.0

Gaelco Loto-Play "multn" board. PORTB bits 0 to 6 carry a common anode seven segment font,
and the value displayed is a credit counter clamped to ten.
-->
<mamelayout version="2">

	<element name="background">
		<rect><color red="0.05" green="0.045" blue="0.05" /></rect>
	</element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.00" green="0.18" blue="0.14" /></led7seg>
	</element>

	<view name="Credit Counter">
		<bounds left="0" top="0" right="12" bottom="18" />
		<element ref="background"><bounds x="0" y="0" width="12" height="18" /></element>
		<element name="digit0" ref="digit"><bounds x="2" y="2" width="8" height="14" /></element>
	</view>

</mamelayout>
