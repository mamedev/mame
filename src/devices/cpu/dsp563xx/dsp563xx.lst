0c1e00 clb s,d              - s:acc(1) d:acc(0)
	u64 v = $s;
	if(v == 0) {
		$d:w(0);
	} else {
		u64 shifted = v << 8;
		u64 val = (shifted & 0x8000000000000000ULL) ? ~shifted : shifted;
		val |= 0xff;
		int bsr = 0;
		for(int bit = 63; bit >= 0; --bit) if(val & (1ULL << bit)) { bsr = bit; break; }
		int count = bsr - 54;
		$d:w((u64)(u32)count << 24);
	}

014085 cmp #i,d              - i:imm6(8) d:acc(3)
	(void)do_sub56(u64($i) << 24, $d);

