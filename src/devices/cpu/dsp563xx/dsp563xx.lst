000084 reset                 -
	// Software reset: only the interrupt priority register and on-chip
	// peripherals are affected. The processor state is unchanged and
	// execution continues with the next instruction (manual 13-161).

000004 rti                   - out
	m_npc = get_ssh();
	set_sr(get_ssl());
	dec_sp();

00000c rts                   - out
	m_npc = get_ssh();
	dec_sp();

