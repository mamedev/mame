064020 rep xy:ea             - ea:eam1(8) xy:xyc(6)
	m_temp_lc = get_lc();
	set_lc($xy:m.read_dword($ea));
	m_rep = true;

060020 rep xy:aa             - aa:asa6(8) xy:xyc(6)
