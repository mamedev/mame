0c1ff0 cmpu s1,s2            - s1:daos3(1, 0) s2:acc(0)
	u64 s1v = $s1 & 0xffffffffffffULL;
	u64 s2v = $s2 & 0xffffffffffffULL;
	m_ccr &= ~(CCR_N|CCR_Z|CCR_V|CCR_C);
	if(s1v == s2v)
		m_ccr |= CCR_Z;
	if(s1v > s2v)
		m_ccr |= (CCR_N|CCR_C);
