0100c0 mpy +s,#i,d           - i:imm5m(8) s:damo2(4) d:acc(3) +:sign(2)
	s64 r = (s64)util::sext($s, 24) * (s64)util::sext($i, 24);
	r <<= 1;
	if($+)
		r = -r;
	$d:w(r);
	do_mpy56(r);

012780 mpyss +s1,s2,d        - ss:ss1(6) d:acc(5) +:sign(4) s1:damo4_a(0) s2:damo4_b(0)
	int uu = BIT(opcode, 6);
	s64 p = uu ? (s64)(u32)$s1 * (s64)(u32)$s2 : (s64)util::sext($s1, 24) * (s64)(u32)$s2;
	s64 r = p << 1;
	if($+)
		r = -r;
	$d:w(r);
	do_mpy56(r);

0141c0 mpyi +#i,s,d          - s:qq2(4) d:acc(3) +:sign(2) i:eximm()
	s64 r = (s64)util::sext($s, 24) * (s64)util::sext($i, 24);
	r <<= 1;
	if($+)
		r = -r;
	$d:w(r);
	do_mpy56(r);

0100c1 mpyr +s,#i,d          - i:imm5m(8) s:damo2(4) d:acc(3) +:sign(2)
	s64 r = (s64)util::sext($s, 24) * (s64)util::sext($i, 24);
	r <<= 1;
	if($+)
		r = -r;
	$d:w(r);
	do_mpy56(r);
	$d:w(do_rnd56((u64)r & 0xffffffffffffff));

0141c1 mpyri +#i,s,d         - s:qq2(4) d:acc(3) +:sign(2) i:eximm()
	s64 r = (s64)util::sext($s, 24) * (s64)util::sext($i, 24);
	r <<= 1;
	if($+)
		r = -r;
	$d:w(r);
	do_mpy56(r);
	$d:w(do_rnd56((u64)r & 0xffffffffffffff));

01d815 norm r,d              - r:ar(8) d:acc(3)
	int _ri = BIT(opcode, 8, 3) & 7;
	u32 _rm = (m_mr & MR_SC) ? 0xffff : 0xffffff;
	u32 _c = m_ccr & CCR_C;
	if(m_ccr & CCR_E) {
		$d:w(do_asr56(1, $d));
		set_r(_ri, (get_r(_ri) + 1) & _rm);
	} else if((m_ccr & CCR_U) && !(m_ccr & CCR_Z)) {
		$d:w(do_asl56(1, $d));
		set_r(_ri, (get_r(_ri) - 1) & _rm);
	}
	m_ccr = (m_ccr & ~CCR_C) | _c;

0c1e20 normf s,d             - s:actrl(1) d:acc(0)
	bool c = BIT(m_ccr, CCR_C);
	if(BIT($s, 23))
		$d:w(do_asl56((u8)((u32)(-util::sext($s, 24)) & 0x3fffffff), $d));
	else
		$d:w(do_asr56((u8)($s & 0xff), $d));
	if(c)
	{
		m_ccr |= CCR_C;
	}
	else
	{
		m_ccr &= ~CCR_C;
	}

014082 or #i,d               - i:imm6(8) d:acc(3)
	u32 r = $d:1 | $i;
	m_ccr = m_ccr & ~(CCR_V|CCR_Z|CCR_N);
	if(!r) {
		m_ccr = m_ccr | CCR_Z;
	} else if(BIT(r, 23)) {
		m_ccr = m_ccr | CCR_N;
	}
	$d:w1(r);

0140c2 or #i,d               - d:acc(3) i:eximm()
	u32 r = $d:1 | $i;
	m_ccr = m_ccr & ~(CCR_V|CCR_Z|CCR_N);
	if(!r) {
		m_ccr = m_ccr | CCR_Z;
	} else if(BIT(r, 23)) {
		m_ccr = m_ccr | CCR_N;
	}
	$d:w1(r);

0000f8 ori #i,ctrl           - i:imm8(8) ctrl:ctrl(0)
	$ctrl:w($ctrl | $i);

