	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_TMP2 = read(m_TMP);
	m_TMP2 = do_ror(m_TMP2);
	write(m_TMP, m_TMP2);
	prefetch();

