inc_xav_zpg
	m_TMP = read_pc();
	m_PC++;
	m_TMP2 = read_zeropage(m_TMP);
	m_TMP2++;
	set_nz(m_TMP2);
	write_zeropage(m_TMP, m_TMP2);
	prefetch();

inc_xav_zpx
	m_TMP = read_pc();
	m_PC++;
	read_zeropage(m_TMP); // dummy read
	m_TMP = uint8_t(m_TMP+m_X);
	m_TMP2 = read_zeropage(m_TMP);
	m_TMP2++;
	set_nz(m_TMP2);
	write_zeropage(m_TMP, m_TMP2);
	prefetch();

inc_aba
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_TMP2 = read(m_TMP);
	m_TMP2++;
	set_nz(m_TMP2);
	write(m_TMP, m_TMP2);
	prefetch();

inc_abx
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read(set_l(m_TMP, m_TMP+m_X));
	m_TMP += m_X;
	m_TMP2 = read(m_TMP);
	m_TMP2++;
	set_nz(m_TMP2);
	write(m_TMP, m_TMP2);
	prefetch();

dec_xav_zpg
	m_TMP = read_pc();
	m_PC++;
	m_TMP2 = read_zeropage(m_TMP);
	m_TMP2--;
	set_nz(m_TMP2);
	write_zeropage(m_TMP, m_TMP2);
	prefetch();

dec_xav_zpx
	m_TMP = read_pc();
	m_PC++;
	read_zeropage(m_TMP); // dummy read
	m_TMP = uint8_t(m_TMP+m_X);
	m_TMP2 = read_zeropage(m_TMP);
	m_TMP2--;
	set_nz(m_TMP2);
	write_zeropage(m_TMP, m_TMP2);
	prefetch();

dec_aba
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_TMP2 = read(m_TMP);
	m_TMP2--;
	set_nz(m_TMP2);
	write(m_TMP, m_TMP2);
	prefetch();

dec_abx
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read(set_l(m_TMP, m_TMP+m_X));
	m_TMP += m_X;
	m_TMP2 = read(m_TMP);
	m_TMP2--;
	set_nz(m_TMP2);
	write(m_TMP, m_TMP2);
	prefetch();

brk_xav_imp
	// Hold the selected source throughout interrupt entry.
	m_interrupt_is_nmi = m_irq_taken && m_nmi_pending;
	if(m_interrupt_is_nmi)
		m_nmi_pending = false;
	if(m_irq_taken) {
		read_pc();
	} else {
		read_pc();
		m_PC++;
	}
	write_codebank_stack(m_SP, m_codebank);
	set_codebank(0x00);
	dec_codebank_stack_pointer();
	write_stack(m_SP, m_PC >> 8);
	dec_SP();
	write_stack(m_SP, m_PC);
	dec_SP();
	write_stack(m_SP, m_P);
	dec_SP();
	if(m_irq_taken)
		m_P &= ~F_B;
	// TODO: Verify BRK's live status updates.
	m_P |= F_I;
	if(m_interrupt_is_nmi) {
		standard_irq_callback(NMI_LINE, m_PC);
		if (m_interrupt_vector_callback.isnull())
		{
			m_PC = read_arg(0xfffa);
			m_PC = set_h(m_PC, read_arg(0xfffb));
		}
		else
		{
			if (m_interrupt_vector_callback(0,1) != -1)
			{
				m_PC = m_interrupt_vector_callback(0,1);
				m_PC = set_h(m_PC, m_interrupt_vector_callback(0,0));
			}
			else
			{
				m_PC = read_arg(0xfffa);
				m_PC = set_h(m_PC, read_arg(0xfffb));
			}
		}
	} else {
		if(m_irq_taken)
			standard_irq_callback(IRQ_LINE, m_PC);
		if (m_interrupt_vector_callback.isnull())
		{
			m_PC = read_arg(0xfffe);
			m_PC = set_h(m_PC, read_arg(0xffff));
		}
		else
		{
			if (m_interrupt_vector_callback(1,1) != -1)
			{
				m_PC = m_interrupt_vector_callback(1,1);
				m_PC = set_h(m_PC, m_interrupt_vector_callback(1,0));
			}
			else
			{
				m_PC = read_arg(0xfffe);
				m_PC = set_h(m_PC, read_arg(0xffff));
			}
		}
	}
	m_irq_taken = false;
	prefetch();
	m_inst_state = -1;

rti_xav_imp
	read_pc();
	read_stack(m_SP);
	inc_SP();
	m_P = read_stack(m_SP) | F_E;
	inc_SP();
	m_PC = read_stack(m_SP);
	inc_SP();
	m_PC = set_h(m_PC, read_stack(m_SP));
	inc_codebank_stack_pointer();
	m_TMP2 = read_codebank_stack(m_SP);
	set_codebank(m_TMP2);
	prefetch();

plp_xav_imp
	read_pc();
	read_stack(m_SP);
	inc_SP();
	m_TMP = read_stack(m_SP) | F_E;
	prefetch();
	m_P = m_TMP; // Do *not* move it before the prefetch
