	m_TMP2 = read((m_SRC << 16) | m_X);
	write((m_DST << 16) | m_Y, m_TMP2);
	read_pc();
	read_pc();
	m_X--;
	m_Y--;
	m_A--;
	if(m_A != 0xffff)
		m_PC -= 3;
	prefetch();

#   miscellaneous

xba_imp
	read_pc();
	read_pc();
	m_A = (m_A >> 8) | (m_A << 8);
	set_nz(m_A);
	prefetch();

# STP stops the clock; only RESB restarts it (§7.15)
stp_imp
	read_pc();
	read_pc();
	for(;;) {
		eat-all-cycles;
	}

# WAI pulls RDY low until an interrupt arrives (§7.13)
wai_imp
	read_pc();
	read_pc();
	while(!m_nmi_pending && !m_irq_state && !m_abort_state) {
		eat-all-cycles;
	}
	prefetch();

ora_idx
	m_TMP2 = read_pc();
	m_PC++;
	if(m_D & 0xff) {
		read_pc();
	}
	read_pc();
	m_TMP3 = dp_idx(m_TMP2, m_X);
	m_TMP = read(m_TMP3);
	m_TMP = set_h(m_TMP, read(dp_lng(m_TMP3, 1)));
	m_VAL = read(ab(m_TMP));
	m_A = set_l(m_A, m_A | m_VAL);
	set_nz(m_A);
	prefetch();

