#
# WDC W65C816
# Section references are from the September 13, 2010 version of the WDC W65C816S
# datasheet.  Cycle counts are from Table 5-4.

reset
	read_pc();
	read_pc();
	read(m_SP);
	dec_SP();
	read(m_SP);
	dec_SP();
	read(m_SP);
	dec_SP();
	m_P |= F_I;
	m_PC = read_vector(VEC_RESET);
	m_PC = set_h(m_PC, read_vector(VEC_RESET + 1));
	prefetch();
	m_inst_state = -1;

#   flags and mode control

clc_imp
	read_pc();
	m_P &= ~F_C;
	prefetch();

sec_imp
	read_pc();
	m_P |= F_C;
	prefetch();

cld_imp
	read_pc();
	m_P &= ~F_D;
	prefetch();

sed_imp
	read_pc();
	m_P |= F_D;
	prefetch();

clv_imp
	read_pc();
	m_P &= ~F_V;
	prefetch();

cli_imp
	read_pc();
	prefetch();
	m_P &= ~F_I; // Do *not* move it before the prefetch

sei_imp
	read_pc();
	prefetch();
	m_P |= F_I; // Do *not* move it before the prefetch

nop_imp
	read_pc();
	prefetch();

wdm_imm
	m_TMP2 = read_pc();
	m_PC++;
	m_wdm_w(m_TMP2);
	prefetch();

xce_imp
	read_pc();
	m_TMP2 = m_P & F_C;
	if(m_E)
		m_P |= F_C;
	else
		m_P &= ~F_C;
	if(m_TMP2) {
		m_E = 1;
		m_SP = 0x0100 | (m_SP & 0xff);
		m_X &= 0xff;
		m_Y &= 0xff;
	} else
		m_E = 0;
	update_state_base();
	prefetch();

rep_imm
	m_TMP2 = read_pc();
	m_PC++;
	read_pc();
	m_P &= ~m_TMP2;
	update_state_base();
	prefetch();

sep_imm
	m_TMP2 = read_pc();
	m_PC++;
	read_pc();
	m_P |= m_TMP2;
	update_state_base();
	if(m_P & F_X) {
		m_X &= 0xff;
		m_Y &= 0xff;
	}
	prefetch();

php_imp
	read_pc();
	write(m_SP, m_P);
	dec_SP();
	prefetch();

plp_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_TMP2 = read(m_SP);
	prefetch();
	m_P = m_TMP2; // Do *not* move it before the prefetch
	update_state_base();
	if(m_P & F_X) {
		m_X &= 0xff;
		m_Y &= 0xff;
	}

#   jumps

jmp_adr
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_PC = m_TMP;
	prefetch();

jmp_abl
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_TMP2 = read_pc();
	m_PC++;
	m_PC = m_TMP;
	m_PB = m_TMP2;
	prefetch();

#   stack

pha_imp
	read_pc();
	write(m_SP, m_A);
	dec_SP();
	prefetch();

pha_w_imp
	read_pc();
	write(m_SP, m_A >> 8);
	dec_SP();
	write(m_SP, m_A);
	dec_SP();
	prefetch();

pla_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_A = set_l(m_A, read(m_SP));
	set_nz(m_A);
	prefetch();

pla_w_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_A = read(m_SP);
	inc_SP();
	m_A = set_h(m_A, read(m_SP));
	set_nz16(m_A);
	prefetch();

tsx_imp
	read_pc();
	m_X = set_l(m_X, m_SP);
	set_nz(m_X);
	prefetch();

tsx_w_imp
	read_pc();
	m_X = m_SP;
	set_nz16(m_X);
	prefetch();

txs_imp
	read_pc();
	if(m_E)
		m_SP = 0x0100 | (m_X & 0xff);
	else
		m_SP = m_X;
	prefetch();

#   branches
#
#   2 cycles, +1 when taken (note 5), and +1 more when a taken branch crosses a
#   page in emulation mode (note 6).  The PC wraps inside the bank (§3.4).

bcc_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(!(m_P & F_C)) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bcs_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(m_P & F_C) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

beq_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(m_P & F_Z) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bne_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(!(m_P & F_Z)) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bmi_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(m_P & F_N) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bpl_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(!(m_P & F_N)) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bvc_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(!(m_P & F_V)) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bvs_rel
	m_TMP2 = read_pc();
	m_PC++;
	if(m_P & F_V) {
		read_pc();
		if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
			read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
		}
		m_PC += int8_t(m_TMP2);
	}
	prefetch();

bra_rel
	m_TMP2 = read_pc();
	m_PC++;
	read_pc();
	if(m_E && page_changing(m_PC, int8_t(m_TMP2))) {
		read_arg(set_l(m_PC, m_PC + int8_t(m_TMP2)));
	}
	m_PC += int8_t(m_TMP2);
	prefetch();

brl_rell
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read_pc();
	m_PC += m_TMP;
	prefetch();

#   jumps, calls and returns

jmp_ind
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_PC = read(m_TMP);
	m_PC = set_h(m_PC, read(uint16_t(m_TMP + 1)));
	prefetch();

# JML (a) takes its pointer from bank 0, like JMP (a) (§7.9), but loads PBR too
jml_ind
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	m_TMP3 = read(m_TMP);
	m_TMP3 = set_h(m_TMP3, read(uint16_t(m_TMP + 1)));
	m_PB = read(uint16_t(m_TMP + 2));
	m_PC = m_TMP3;
	prefetch();

# JMP (a,x) and JSR (a,x) index into a table in the *program* bank (§7.9)
jmp_iax
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read_pc();
	m_TMP3 = m_TMP + m_X;
	m_PC = read_arg(m_TMP3);
	m_PC = set_h(m_PC, read_arg(uint16_t(m_TMP3 + 1)));
	prefetch();

# Unlike the 6502, the 65816 fetches both operand bytes before it pushes.
jsr_adr
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read_pc();
	m_TMP3 = m_PC - 1;
	write(m_SP, m_TMP3 >> 8);
	dec_SP();
	write(m_SP, m_TMP3);
	dec_SP();
	m_PC = m_TMP;
	prefetch();

jsr_iax
	m_TMP = read_pc();
	m_PC++;
	write(m_SP, m_PC >> 8);
	dec_SP();
	write(m_SP, m_PC);
	dec_SP();
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read_pc();
	m_TMP3 = m_TMP + m_X;
	m_PC = read_arg(m_TMP3);
	m_PC = set_h(m_PC, read_arg(uint16_t(m_TMP3 + 1)));
	prefetch();

jsl_abl
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	write(m_SP, m_PB);
	dec_SP_nw();
	read(m_SP);
	m_TMP2 = read_pc();
	m_PC++;
	m_TMP3 = m_PC - 1;
	write(m_SP, m_TMP3 >> 8);
	dec_SP_nw();
	write(m_SP, m_TMP3);
	dec_SP_nw();
	m_PC = m_TMP;
	m_PB = m_TMP2;
	prefetch();

rts_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_PC = read(m_SP);
	inc_SP();
	m_PC = set_h(m_PC, read(m_SP));
	read_pc();
	m_PC++;
	prefetch();

rtl_imp
	read_pc();
	read_pc();
	inc_SP_nw();
	m_TMP = read(m_SP);
	inc_SP_nw();
	m_TMP = set_h(m_TMP, read(m_SP));
	inc_SP_nw();
	m_PB = read(m_SP);
	m_PC = m_TMP + 1;
	prefetch();

#   interrupts and returns from them

brk_imm
	if(m_irq_taken || m_nmi_pending) {
		read_pc();
	} else {
		read_pc();
		m_PC++;
	}
	write(m_SP, m_PB);
	dec_SP();
	write(m_SP, m_PC >> 8);
	dec_SP();
	write(m_SP, m_PC);
	dec_SP();
	write(m_SP, m_P);
	dec_SP();
	if(m_nmi_pending) {
		standard_irq_callback(NMI_LINE, m_PC);
		m_nmi_pending = false;
		m_TMP = VEC_N_NMI;
	} else if(m_irq_taken) {
		standard_irq_callback(IRQ_LINE, m_PC);
		m_TMP = VEC_N_IRQ;
	} else
		m_TMP = VEC_N_BRK;
	m_irq_taken = false;
	m_P = (m_P | F_I) & ~F_D; // Do *not* move after the prefetch
	m_PB = 0;
	m_PC = read_vector(m_TMP);
	m_PC = set_h(m_PC, read_vector(m_TMP + 1));
	prefetch();
	m_inst_state = -1;

brk_e_imm
	if(m_irq_taken || m_nmi_pending) {
		read_pc();
	} else {
		read_pc();
		m_PC++;
	}
	write(m_SP, m_PC >> 8);
	dec_SP();
	write(m_SP, m_PC);
	dec_SP();
	write(m_SP, (m_irq_taken || m_nmi_pending) ? (m_P & ~F_B) : (m_P | F_B));
	dec_SP();
	if(m_nmi_pending) {
		standard_irq_callback(NMI_LINE, m_PC);
		m_nmi_pending = false;
		m_TMP = VEC_E_NMI;
	} else if(m_irq_taken) {
		standard_irq_callback(IRQ_LINE, m_PC);
		m_TMP = VEC_E_IRQ;
	} else
		m_TMP = VEC_E_IRQ;
	m_irq_taken = false;
	m_P = (m_P | F_I) & ~F_D; // Do *not* move after the prefetch
	m_PB = 0;
	m_PC = read_vector(m_TMP);
	m_PC = set_h(m_PC, read_vector(m_TMP + 1));
	prefetch();
	m_inst_state = -1;

cop_imm
	read_pc();
	m_PC++;
	write(m_SP, m_PB);
	dec_SP();
	write(m_SP, m_PC >> 8);
	dec_SP();
	write(m_SP, m_PC);
	dec_SP();
	write(m_SP, m_P);
	dec_SP();
	m_P = (m_P | F_I) & ~F_D; // Do *not* move after the prefetch
	m_PB = 0;
	m_PC = read_vector(VEC_N_COP);
	m_PC = set_h(m_PC, read_vector(VEC_N_COP + 1));
	prefetch();
	m_inst_state = -1;

cop_e_imm
	read_pc();
	m_PC++;
	write(m_SP, m_PC >> 8);
	dec_SP();
	write(m_SP, m_PC);
	dec_SP();
	write(m_SP, m_P | F_B);
	dec_SP();
	m_P = (m_P | F_I) & ~F_D; // Do *not* move after the prefetch
	m_PB = 0;
	m_PC = read_vector(VEC_E_COP);
	m_PC = set_h(m_PC, read_vector(VEC_E_COP + 1));
	prefetch();
	m_inst_state = -1;

rti_imp
	read_pc();
	read_pc();
	inc_SP();
	m_TMP2 = read(m_SP);
	inc_SP();
	m_PC = read(m_SP);
	inc_SP();
	m_PC = set_h(m_PC, read(m_SP));
	inc_SP();
	m_PB = read(m_SP);
	m_P = m_TMP2;
	update_state_base();
	if(m_P & F_X) {
		m_X &= 0xff;
		m_Y &= 0xff;
	}
	prefetch();

rti_e_imp
	read_pc();
	read_pc();
	inc_SP();
	m_TMP2 = read(m_SP);
	inc_SP();
	m_PC = read(m_SP);
	inc_SP();
	m_PC = set_h(m_PC, read(m_SP));
	m_P = m_TMP2;
	update_state_base();
	prefetch();

#   index register increment and decrement

inx_imp
	read_pc();
	m_X = set_l(m_X, do_inc(m_X));
	prefetch();

inx_w_imp
	read_pc();
	m_X = do_inc16(m_X);
	prefetch();

iny_imp
	read_pc();
	m_Y = set_l(m_Y, do_inc(m_Y));
	prefetch();

iny_w_imp
	read_pc();
	m_Y = do_inc16(m_Y);
	prefetch();

dex_imp
	read_pc();
	m_X = set_l(m_X, do_dec(m_X));
	prefetch();

dex_w_imp
	read_pc();
	m_X = do_dec16(m_X);
	prefetch();

dey_imp
	read_pc();
	m_Y = set_l(m_Y, do_dec(m_Y));
	prefetch();

dey_w_imp
	read_pc();
	m_Y = do_dec16(m_Y);
	prefetch();

#   stack

phx_imp
	read_pc();
	write(m_SP, m_X);
	dec_SP();
	prefetch();

phx_w_imp
	read_pc();
	write(m_SP, m_X >> 8);
	dec_SP();
	write(m_SP, m_X);
	dec_SP();
	prefetch();

phy_imp
	read_pc();
	write(m_SP, m_Y);
	dec_SP();
	prefetch();

phy_w_imp
	read_pc();
	write(m_SP, m_Y >> 8);
	dec_SP();
	write(m_SP, m_Y);
	dec_SP();
	prefetch();

plx_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_X = set_l(m_X, read(m_SP));
	set_nz(m_X);
	prefetch();

plx_w_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_X = read(m_SP);
	inc_SP();
	m_X = set_h(m_X, read(m_SP));
	set_nz16(m_X);
	prefetch();

ply_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_Y = set_l(m_Y, read(m_SP));
	set_nz(m_Y);
	prefetch();

ply_w_imp
	read_pc();
	read(m_SP);
	inc_SP();
	m_Y = read(m_SP);
	inc_SP();
	m_Y = set_h(m_Y, read(m_SP));
	set_nz16(m_Y);
	prefetch();

phb_imp
	read_pc();
	write(m_SP, m_DB);
	dec_SP();
	prefetch();

phk_imp
	read_pc();
	write(m_SP, m_PB);
	dec_SP();
	prefetch();

plb_imp
	read_pc();
	read(m_SP);
	inc_SP_nw();
	m_DB = read(m_SP);
	set_nz(m_DB);
	prefetch();

phd_imp
	read_pc();
	write(m_SP, m_D >> 8);
	dec_SP_nw();
	write(m_SP, m_D);
	dec_SP_nw();
	prefetch();

pld_imp
	read_pc();
	read(m_SP);
	inc_SP_nw();
	m_D = read(m_SP);
	inc_SP_nw();
	m_D = set_h(m_D, read(m_SP));
	set_nz16(m_D);
	prefetch();

pea_imm16
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	write(m_SP, m_TMP >> 8);
	dec_SP_nw();
	write(m_SP, m_TMP);
	dec_SP_nw();
	prefetch();

# PEI reads its pointer with dp_lng(), which steps out of the direct page
# rather than wrapping inside it, even in emulation mode (§7.2.1)
pei_zpg
	m_TMP2 = read_pc();
	m_PC++;
	if(m_D & 0xff) {
		read_pc();
	}
	m_TMP3 = dp(m_TMP2);
	m_TMP = read(m_TMP3);
	m_TMP = set_h(m_TMP, read(dp_lng(m_TMP3, 1)));
	write(m_SP, m_TMP >> 8);
	dec_SP_nw();
	write(m_SP, m_TMP);
	dec_SP_nw();
	prefetch();

per_rell
	m_TMP = read_pc();
	m_PC++;
	m_TMP = set_h(m_TMP, read_pc());
	m_PC++;
	read_pc();
	m_TMP3 = m_PC + m_TMP;
	write(m_SP, m_TMP3 >> 8);
	dec_SP_nw();
	write(m_SP, m_TMP3);
	dec_SP_nw();
	prefetch();

#   transfers
#
#   TCS, TSC, TCD and TDC always move all 16 bits regardless of M

tax_imp
	read_pc();
	m_X = set_l(m_X, m_A);
	set_nz(m_X);
	prefetch();

tax_w_imp
	read_pc();
	m_X = m_A;
	set_nz16(m_X);
	prefetch();

tay_imp
	read_pc();
	m_Y = set_l(m_Y, m_A);
	set_nz(m_Y);
	prefetch();

tay_w_imp
	read_pc();
	m_Y = m_A;
	set_nz16(m_Y);
	prefetch();

txa_imp
	read_pc();
	m_A = set_l(m_A, m_X);
	set_nz(m_A);
	prefetch();

txa_w_imp
	read_pc();
	m_A = m_X;
	set_nz16(m_A);
	prefetch();

tya_imp
	read_pc();
	m_A = set_l(m_A, m_Y);
	set_nz(m_A);
	prefetch();

tya_w_imp
	read_pc();
	m_A = m_Y;
	set_nz16(m_A);
	prefetch();

txy_imp
	read_pc();
	m_Y = set_l(m_Y, m_X);
	set_nz(m_Y);
	prefetch();

txy_w_imp
	read_pc();
	m_Y = m_X;
	set_nz16(m_Y);
	prefetch();

tyx_imp
	read_pc();
	m_X = set_l(m_X, m_Y);
	set_nz(m_X);
	prefetch();

tyx_w_imp
	read_pc();
	m_X = m_Y;
	set_nz16(m_X);
	prefetch();

# "When in the Emulation mode, a 01 is forced into SH.  In this case, the B
# Accumulator will not be loaded into SH." (§7.14)
tcs_imp
	read_pc();
	if(m_E)
		m_SP = 0x0100 | (m_A & 0xff);
	else
		m_SP = m_A;
	prefetch();

tsc_imp
	read_pc();
	m_A = m_SP;
	set_nz16(m_A);
	prefetch();

tcd_imp
	read_pc();
	m_D = m_A;
	set_nz16(m_D);
	prefetch();

tdc_imp
	read_pc();
	m_A = m_D;
	set_nz16(m_A);
	prefetch();

#   block moves

mvn_dbf
	m_DST = read_pc();
	m_PC++;
	m_SRC = read_pc();
	m_PC++;
	m_DB = m_DST;
	m_TMP2 = read((m_SRC << 16) | (m_X & 0xff));
	write((m_DST << 16) | (m_Y & 0xff), m_TMP2);
	read_pc();
	read_pc();
	m_X = set_l(m_X, m_X + 1);
	m_Y = set_l(m_Y, m_Y + 1);
	m_A--;
	if(m_A != 0xffff)
		m_PC -= 3;
	prefetch();

mvn_w_dbf
	m_DST = read_pc();
	m_PC++;
	m_SRC = read_pc();
	m_PC++;
	m_DB = m_DST;
	m_TMP2 = read((m_SRC << 16) | m_X);
	write((m_DST << 16) | m_Y, m_TMP2);
	read_pc();
	read_pc();
	m_X++;
	m_Y++;
	m_A--;
	if(m_A != 0xffff)
		m_PC -= 3;
	prefetch();

