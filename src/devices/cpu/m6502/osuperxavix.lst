# SuperXaviX instruction timing and memory access sequences

brk_xav_imp
	m_interrupt_is_nmi = m_irq_taken && m_nmi_pending;
	if (m_interrupt_is_nmi)
		m_nmi_pending = false;
	read_pc();
	if (!m_irq_taken)
		m_PC++;
	m_TMP = read_vector(m_interrupt_is_nmi, true);
	write_codebank_stack(m_SP, m_codebank);
	set_codebank(0x00);
	dec_codebank_stack_pointer();
	write_stack(m_SP, m_PC >> 8);
	dec_SP();
	write_stack(m_SP, m_PC);
	dec_SP();
	write_stack(m_SP, m_P);
	dec_SP();
	if (m_irq_taken)
		m_P &= ~F_B;
	m_P |= F_I;
	if (m_interrupt_is_nmi)
		standard_irq_callback(NMI_LINE, m_PC);
	else if (m_irq_taken)
		standard_irq_callback(IRQ_LINE, m_PC);
	m_TMP2 = read_vector(m_interrupt_is_nmi, false);
	m_PC = set_h(m_TMP, m_TMP2);
	m_irq_taken = false;
	prefetch();
	m_inst_state = -1;

ora_xav_idx
	m_TMP2 = read_pc();
	m_PC++;
	m_TMP2 += m_X;
	prefetch_start();
	m_IR = read_sync(m_PC);
	m_operand = read_zeropage(m_TMP2 & 0xff);
	m_TMP = m_operand;
	m_operand = read_zeropage((m_TMP2+1) & 0xff);
	m_TMP = set_h(m_TMP, m_operand);
	m_TMP2 = read(m_TMP);
	m_A |= m_TMP2;
	set_nz(m_A);
	prefetch_end();

cmc_imp
	m_TMP = m_P & F_C;
	m_P &= ~F_C;
	m_TMP = ~m_TMP;
	m_P |= m_TMP & F_C;
	prefetch();

oraj_imp
	m_A |= m_j;
	set_nz(m_A);
	prefetch();

asr_xav_zpg
	m_TMP = read_pc();
