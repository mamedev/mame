<?xml version="1.0"?>

<!-- Floppy sound sample specifications

     The key in the name attribute is the name passed in enable_sound in the
     code. When not found, the default samples are used; the expected name
     can be found in the log output.
     The sample files must be WAV files (mono, 44.1 kHz), the name attribute
     contains the file name without extension.
     Seek samples may be declared for different rates. A sample is selected if
     its maximum rate is higher than or equal to the actual rate and if there
     is no sample with a lower maxrate that is higher than the actual rate.
     The pitch of the selected sample is changed to match the actual rate.

     0 [...nom1...max1][...nom2...max2]...[...nomN...maxN] 100

     Seeks with actual rates longer than maxN or 100 ms are treated as
     isolated steps.

     Track values for seeks and steps may exceed the real range, also be
     negative for some drives like the C1541 to catch the movement of the head
     outside of the valid range.

     Sample packs should be delivered with a suitable drive element definition
     that may be pasted into this file.

     <drive name="key"
            description="verbal description"
            path="subdirectory of samplepath"
            formfactor="3 | 3.5 | 5.25 | 8">

         <spin phase="firststart | start | run | stop"
               mode="empty | loaded"
               file="file name"/>

         <step [from="first track", default 0]
               [to="last track", default 99]
               [dir="in | out | both", default both]
               file="file name"/>

         <seek [from="first track", default 0]
               [last="last track", default 99]
               [dir="in | out | both", default both]
               nomrate="step rate in ms as recorded for this sample"
               maxrate="maximum step rate in ms for this sample"
               file="file name"/>
     </drive>

     <drive name="key"
            base="name of other drive element | default | none" />
-->

<drivesound>
	<!-- Default samples for 5.25 -->
	<drive name="default" description="Default 5.25&quot; Floppy drive" path="floppy" formfactor="5.25">
		<spin phase="start" mode="empty" file="525_spin_start_empty"/>
		<spin phase="start" mode="loaded" file="525_spin_start_loaded"/>
		<spin phase="run" mode="empty" file="525_spin_empty"/>
		<spin phase="run" mode="loaded" file="525_spin_loaded"/>
		<spin phase="stop" mode="empty" file="525_spin_end"/>
		<spin phase="stop" mode="loaded" file="525_spin_end"/>
		<step file="525_step_1_1"/>
		<seek nomrate="6" maxrate="9" file="525_seek_6ms"/>
		<seek nomrate="12" maxrate="15" file="525_seek_12ms"/>
		<seek nomrate="20" maxrate="50" file="525_seek_20ms"/>
	 </drive>

	 <!-- Default samples for 3.5 -->
	 <drive name="default" description="Default 3.5&quot; Floppy drive" path="floppy" formfactor="3.5">
		<spin phase="start" mode="empty" file="35_spin_start_empty"/>
		<spin phase="start" mode="loaded" file="35_spin_start_loaded"/>
		<spin phase="run" mode="empty" file="35_spin_empty"/>
		<spin phase="run" mode="loaded" file="35_spin_loaded"/>
		<spin phase="stop" mode="empty" file="35_spin_end"/>
		<spin phase="stop" mode="loaded" file="35_spin_end"/>
		<step file="35_step_1_1"/>
		<seek nomrate="2" maxrate="3" file="35_seek_2ms"/>
		<seek nomrate="6" maxrate="9" file="35_seek_6ms"/>
		<seek nomrate="12" maxrate="15" file="35_seek_12ms"/>
		<seek nomrate="20" maxrate="50" file="35_seek_20ms"/>
	 </drive>

 </drivesound>
